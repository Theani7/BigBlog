{
  "name": "bigblog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A premium developer publishing platform built with Astro",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --ext ts,tsx,js,jsx,astro",
    "lint:fix": "eslint . --ext ts,tsx,js,jsx,astro --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "seo:audit": "bun run scripts/seo-audit.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test",
    "test:all": "vitest run && npx playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/vercel": "^11.0.0",
    "astro": "^7.1.3",
    "lucide-astro": "^0.556.0",
    "mongoose": "^9.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.0.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vitest": "^4.1.10"
  }
}
