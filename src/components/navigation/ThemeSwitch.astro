---
import type { ComponentProps } from 'astro/types';
import Icon from '@components/ui/Icon.astro';

interface ThemeSwitchProps {
  initialTheme?: 'light' | 'dark' | 'system';
}

const { initialTheme = 'light' } = Astro.props as ThemeSwitchProps;
---

<button
  class="theme-switch"
  type="button"
  aria-label="Toggle theme"
  data-theme={initialTheme}
  data-theme-switch
>
  <Icon name="sun" size="md" class="theme-icon theme-icon--sun" />
  <Icon name="moon" size="md" class="theme-icon theme-icon--moon" />
</button>

<style>
  .theme-switch {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-10);
    height: var(--space-10);
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    cursor: pointer;
    color: var(--text-primary);
    transition:
      background var(--duration-fast) var(--ease-default),
      border-color var(--duration-fast) var(--ease-default);
  }

  .theme-switch:hover {
    background: var(--bg-tertiary);
  }

  .theme-switch:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .theme-icon {
    position: absolute;
    transition: opacity var(--duration-fast) var(--ease-default);
  }

  .theme-icon--sun {
    opacity: 1;
  }

  .theme-icon--moon {
    opacity: 0;
  }

  [data-theme='dark'] .theme-icon--sun,
  [data-theme='system'] .theme-icon--sun {
    opacity: 0;
  }

  [data-theme='dark'] .theme-icon--moon,
  [data-theme='system'] .theme-icon--moon {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-switch {
      transition: none;
    }

    .theme-icon {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const button = document.querySelector('[data-theme-switch]');
    if (!button) return;

    const root = document.documentElement;

    function getTheme() {
      return root.getAttribute('data-theme') || 'light';
    }

    function setTheme(theme) {
      root.setAttribute('data-theme', theme);
      try {
        localStorage.setItem('theme', theme);
      } catch {}
    }

    function cycleTheme() {
      const current = getTheme();
      const next = current === 'light' ? 'dark' : current === 'dark' ? 'system' : 'light';
      setTheme(next);
    }

    button.addEventListener('click', cycleTheme);

    const saved = localStorage.getItem('theme');
    if (saved) {
      setTheme(saved);
    }
  })();
</script>
