---
import type { ComponentProps } from 'astro/types';

interface TextareaProps {
  label: string;
  name: string;
  placeholder?: string;
  value?: string;
  required?: boolean;
  disabled?: boolean;
  error?: string;
  helperText?: string;
  rows?: number;
}

const {
  label,
  name,
  placeholder,
  value,
  required = false,
  disabled = false,
  error,
  helperText,
  rows = 4,
} = Astro.props as TextareaProps;

const errorId = error ? `${name}-error` : undefined;
const helperId = helperText ? `${name}-helper` : undefined;
const describedBy = [errorId, helperId].filter(Boolean).join(' ') || undefined;
---

<div class="textarea-wrapper">
  <label class="textarea-label" for={name}>
    {label}
    {
      required && (
        <span class="input-required" aria-hidden="true">
          *
        </span>
      )
    }
  </label>
  <textarea
    class={`textarea ${error ? 'textarea--error' : ''}`}
    id={name}
    name={name}
    placeholder={placeholder}
    value={value}
    required={required}
    disabled={disabled}
    rows={rows}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={describedBy}
    aria-required={required ? 'true' : undefined}></textarea>
  {
    error && (
      <span class="input-error" id={errorId} role="alert">
        {error}
      </span>
    )
  }
  {
    helperText && !error && (
      <span class="input-helper" id={helperId}>
        {helperText}
      </span>
    )
  }
</div>

<style>
  .textarea-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .textarea-label {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .textarea {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-base);
    font-family: var(--font-sans);
    color: var(--text-primary);
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--duration-fast) var(--ease-default),
      box-shadow var(--duration-fast) var(--ease-default);
    outline: none;
    line-height: var(--leading-normal);
    resize: vertical;
    min-height: calc(var(--space-3) * var(--space-4) + var(--space-6));
  }

  .textarea::placeholder {
    color: var(--text-tertiary);
  }

  .textarea:hover:not(:disabled):not(:focus) {
    border-color: var(--text-tertiary);
  }

  .textarea:focus-visible {
    border-color: var(--border-color-focus);
    box-shadow: var(--focus-ring);
  }

  .textarea:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background: var(--bg-tertiary);
  }

  .textarea--error {
    border-color: var(--color-danger);
  }

  .textarea--error:focus-visible {
    border-color: var(--color-danger);
    box-shadow: 0 0 0 3px rgb(220 38 38 / 0.3);
  }

  .input-error {
    font-size: var(--text-small);
    color: var(--color-danger);
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .input-helper {
    font-size: var(--text-small);
    color: var(--text-secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .textarea {
      transition: none;
    }
  }
</style>
