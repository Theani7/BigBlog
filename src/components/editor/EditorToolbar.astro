---
export interface Props {
  // Add props if needed
}
---

<div class="write-toolbar">
  <div class="toolbar-left" style="display: flex; align-items: center; gap: 16px;">
    <span class="draft-status" id="draft-status">Draft in progress</span>
    <span class="toolbar-divider" style="color: var(--border-color); font-size: 14px;">|</span>
    <span class="word-count" id="word-count" style="color: var(--color-muted); font-size: 13px;"
      >0 words &bull; 0 min read</span
    >
  </div>
  <div class="toolbar-right">
    <button class="btn btn-secondary btn-sm" id="save-draft-btn">Save Draft</button>
    <button class="btn btn-primary btn-sm" id="publish-btn">Publish</button>
  </div>
</div>

<style>
  .write-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-md) var(--space-xl);
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-color);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    position: sticky;
    top: 64px; /* Below the main site header */
    z-index: 10;
  }

  [data-theme='dark'] .write-toolbar {
    background: rgba(18, 18, 18, 0.75);
  }

  .draft-status {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-muted-soft);
  }

  .toolbar-right {
    display: flex;
    gap: var(--space-sm);
  }

  .btn-sm {
    padding: 0.375rem 1rem;
    font-size: 0.875rem;
  }
</style>
