---
export interface Props {
  // Add props if needed
}
---

<div class="write-toolbar">
  <div class="toolbar-left">
    <div class="draft-indicator">
      <span class="draft-pulse"></span>
      <span class="draft-status" id="draft-status">Draft in progress</span>
    </div>
    <span class="toolbar-divider">&bull;</span>
    <span class="word-count-badge" id="word-count">0 words &bull; 0 min read</span>
  </div>
  <div class="toolbar-right">
    <button class="btn-editorial-secondary" id="save-draft-btn" type="button">Save Draft</button>
    <button class="btn-editorial-primary" id="publish-btn" type="button">Publish</button>
  </div>
</div>

<style>
  .write-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 32px;
    background: rgba(250, 249, 245, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-hairline, #e6dfd8);
    position: sticky;
    top: 64px;
    z-index: 40;
  }

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .draft-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .draft-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-success, #5db872);
    display: inline-block;
    box-shadow: 0 0 0 2px rgba(93, 184, 114, 0.2);
  }

  .draft-status {
    font-family: var(--font-sans, 'StyreneB', 'Inter', sans-serif);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-muted, #6c6a64);
  }

  .toolbar-divider {
    color: var(--color-hairline, #e6dfd8);
    font-size: 12px;
  }

  .word-count-badge {
    background-color: var(--color-surface-card, #efe9de);
    color: var(--color-ink, #141413);
    font-family: var(--font-sans, 'StyreneB', 'Inter', sans-serif);
    font-size: 12px;
    font-weight: 500;
    padding: 4px 12px;
    border-radius: 9999px;
  }

  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .btn-editorial-secondary {
    font-family: var(--font-sans, 'StyreneB', 'Inter', sans-serif);
    font-size: 14px;
    font-weight: 500;
    height: 38px;
    padding: 0 16px;
    border-radius: 8px;
    background-color: var(--color-canvas, #faf9f5);
    color: var(--color-ink, #141413);
    border: 1px solid var(--color-hairline, #e6dfd8);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-editorial-secondary:hover {
    border-color: var(--color-ink, #141413);
  }

  .btn-editorial-primary {
    font-family: var(--font-sans, 'StyreneB', 'Inter', sans-serif);
    font-size: 14px;
    font-weight: 500;
    height: 38px;
    padding: 0 20px;
    border-radius: 8px;
    background-color: var(--color-surface-dark, #181715);
    color: var(--color-on-dark, #faf9f5);
    border: none;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .btn-editorial-primary:hover {
    background-color: var(--color-primary-active, #252320);
  }
</style>
