---
export interface Props {
  // Add props if needed
}
---

<div class="publish-drawer-overlay" id="publish-drawer-overlay">
  <div class="publish-drawer" id="publish-drawer" role="dialog" aria-modal="true">
    <div class="publish-drawer-header">
      <h2 class="publish-drawer-title">Publish Settings</h2>
      <button class="publish-drawer-close" id="publish-drawer-close" aria-label="Close"
        >&times;</button
      >
    </div>
    <div class="publish-drawer-body">
      <div class="publish-form-group">
        <label class="publish-label">SEO Excerpt</label>
        <p class="publish-help">
          A brief description for search engines and social media previews.
        </p>
        <textarea
          id="post-excerpt"
          class="publish-textarea"
          rows="3"
          placeholder="Write a captivating summary..."></textarea>
      </div>
      <div class="publish-preview-card">
        <p class="publish-preview-label">Social Preview</p>
        <div class="preview-card-inner">
          <div class="preview-img-placeholder" id="preview-cover">No cover image</div>
          <div class="preview-content">
            <h4 id="preview-title">Your Title Here</h4>
            <p id="preview-excerpt">Your excerpt will appear here.</p>
          </div>
        </div>
      </div>
    </div>
    <div class="publish-drawer-footer">
      <button class="btn btn-primary" id="confirm-publish-btn" style="width: 100%;"
        >Publish now</button
      >
    </div>
  </div>
</div>

<style>
  /* Publish Drawer Styling */
  .publish-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    z-index: 1000;
    display: none;
    justify-content: center;
    align-items: flex-end;
  }

  .publish-drawer {
    background: var(--bg-canvas);
    width: 100%;
    max-width: 600px;
    border-radius: 16px 16px 0 0;
    padding: var(--space-xl);
    box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.1);
    animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes slideUp {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  .publish-drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-xl);
  }

  .publish-drawer-title {
    font-family: var(--font-serif);
    font-size: 24px;
    margin: 0;
  }

  .publish-drawer-close {
    background: none;
    border: none;
    font-size: 28px;
    line-height: 1;
    color: var(--color-muted);
    cursor: pointer;
  }

  .publish-form-group {
    margin-bottom: var(--space-xl);
  }

  .publish-label {
    display: block;
    font-family: var(--font-sans);
    font-weight: 600;
    margin-bottom: 4px;
  }

  .publish-help {
    font-size: 13px;
    color: var(--color-muted);
    margin-bottom: 12px;
  }

  .publish-textarea {
    width: 100%;
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
    padding: 12px;
    font-family: var(--font-sans);
    background: var(--bg-surface-soft);
    color: var(--color-ink);
    resize: vertical;
  }

  .publish-preview-card {
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
    padding: 16px;
    background: var(--bg-surface-soft);
  }

  .publish-preview-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-muted);
    margin-bottom: 12px;
    font-weight: 600;
  }

  .preview-card-inner {
    background: var(--bg-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
    overflow: hidden;
  }

  .preview-img-placeholder {
    width: 100%;
    height: 160px;
    background: var(--color-hairline);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    font-size: 14px;
  }

  .preview-content {
    padding: 16px;
  }

  #preview-title {
    margin: 0 0 8px 0;
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.3;
  }

  #preview-excerpt {
    margin: 0;
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .publish-drawer-footer {
    margin-top: var(--space-2xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-hairline);
  }
</style>
