---
export interface Props {
  // Add props if needed
}
---

<div class="publish-drawer-overlay" id="publish-drawer-overlay">
  <div class="publish-drawer" id="publish-drawer" role="dialog" aria-modal="true">
    <div class="publish-drawer-header">
      <h2 class="publish-drawer-title">Publish Settings</h2>
      <button class="publish-drawer-close" id="publish-drawer-close" aria-label="Close"
        >&times;</button
      >
    </div>
    <div class="publish-drawer-body">
      <div class="publish-form-group">
        <label class="publish-label">SEO & Story Excerpt</label>
        <p class="publish-help">A summary for search engines and social media preview cards.</p>
        <textarea
          id="post-excerpt"
          class="publish-textarea"
          rows="3"
          placeholder="Write a captivating summary..."></textarea>
      </div>
      <div class="publish-preview-card">
        <p class="publish-preview-label">Social Media Card Preview</p>
        <div class="preview-card-inner">
          <div class="preview-img-placeholder" id="preview-cover">No cover image</div>
          <div class="preview-content">
            <h4 id="preview-title">Your Title Here</h4>
            <p id="preview-excerpt">Your excerpt will appear here.</p>
          </div>
        </div>
      </div>
    </div>
    <div class="publish-drawer-footer">
      <button class="btn-publish-submit" id="confirm-publish-btn" type="button">Publish Now</button>
    </div>
  </div>
</div>

<style>
  .publish-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(20, 20, 19, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 1000;
    display: none;
    justify-content: center;
    align-items: flex-end;
  }

  .publish-drawer {
    background: var(--color-canvas, #faf9f5);
    width: 100%;
    max-width: 600px;
    border-radius: 16px 16px 0 0;
    padding: 32px;
    box-shadow: 0 -8px 32px rgba(20, 20, 19, 0.12);
    border: 1px solid var(--color-hairline, #e6dfd8);
    border-bottom: none;
    animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes slideUp {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  .publish-drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .publish-drawer-title {
    font-family: 'Copernicus', 'Tiempos Headline', 'Cormorant Garamond', Georgia, serif;
    font-size: 24px;
    font-weight: 400;
    color: var(--color-ink, #141413);
    margin: 0;
  }

  .publish-drawer-close {
    background: none;
    border: none;
    font-size: 28px;
    line-height: 1;
    color: var(--color-muted, #6c6a64);
    cursor: pointer;
  }

  .publish-form-group {
    margin-bottom: 24px;
  }

  .publish-label {
    display: block;
    font-family: var(--font-sans, 'StyreneB', 'Inter', sans-serif);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink, #141413);
    margin-bottom: 4px;
  }

  .publish-help {
    font-size: 13px;
    color: var(--color-muted, #6c6a64);
    margin-bottom: 12px;
    font-family: var(--font-sans, 'StyreneB', 'Inter', sans-serif);
  }

  .publish-textarea {
    width: 100%;
    border: 1px solid var(--color-hairline, #e6dfd8);
    border-radius: 8px;
    padding: 12px;
    font-family: var(--font-sans, 'StyreneB', 'Inter', sans-serif);
    font-size: 14px;
    background: var(--color-surface-card, #efe9de);
    color: var(--color-ink, #141413);
    resize: vertical;
    outline: none;
  }

  .publish-textarea:focus {
    border-color: var(--color-ink, #141413);
  }

  .publish-preview-card {
    border: 1px solid var(--color-hairline, #e6dfd8);
    border-radius: 12px;
    padding: 20px;
    background: var(--color-surface-card, #efe9de);
  }

  .publish-preview-label {
    font-family: var(--font-sans, 'StyreneB', 'Inter', sans-serif);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-muted, #6c6a64);
    margin-bottom: 12px;
    font-weight: 500;
  }

  .preview-card-inner {
    background: var(--color-canvas, #faf9f5);
    border: 1px solid var(--color-hairline, #e6dfd8);
    border-radius: 8px;
    overflow: hidden;
  }

  .preview-img-placeholder {
    width: 100%;
    height: 160px;
    background: var(--color-surface-card, #efe9de);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted, #6c6a64);
    font-size: 14px;
    font-family: var(--font-sans, 'StyreneB', 'Inter', sans-serif);
  }

  .preview-content {
    padding: 16px;
  }

  #preview-title {
    margin: 0 0 8px 0;
    font-family: 'Copernicus', 'Tiempos Headline', 'Cormorant Garamond', Georgia, serif;
    font-size: 18px;
    font-weight: 400;
    color: var(--color-ink, #141413);
    line-height: 1.3;
  }

  #preview-excerpt {
    margin: 0;
    font-family: var(--font-sans, 'StyreneB', 'Inter', sans-serif);
    font-size: 14px;
    color: var(--color-muted, #6c6a64);
    line-height: 1.5;
  }

  .publish-drawer-footer {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--color-hairline, #e6dfd8);
  }

  .btn-publish-submit {
    width: 100%;
    height: 44px;
    background-color: var(--color-surface-dark, #181715);
    color: var(--color-on-dark, #faf9f5);
    font-family: var(--font-sans, 'StyreneB', 'Inter', sans-serif);
    font-size: 15px;
    font-weight: 500;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .btn-publish-submit:hover {
    background-color: var(--color-primary-active, #252320);
  }
</style>
