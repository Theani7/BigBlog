---
export interface Props {
  // Add props if needed
}
---

<div class="cover-image-container" id="cover-image-container">
  <button class="add-cover-btn" id="add-cover-btn" type="button">
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      ><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle
        cx="8.5"
        cy="8.5"
        r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg
    >
    Add cover image
  </button>
  <img id="cover-image-preview" src="" alt="Cover Preview" style="display: none;" />
  <button class="remove-cover-btn" id="remove-cover-btn" type="button" style="display: none;"
    >&times;</button
  >
  <input type="file" id="cover-image-input" accept="image/*" style="display: none;" />
</div>

<div class="editor-title-group">
  <input
    type="text"
    class="write-title-input"
    id="post-title"
    placeholder="Title"
    autocomplete="off"
    spellcheck="false"
  />
  <input
    type="text"
    class="write-subtitle-input"
    id="post-subtitle"
    placeholder="Add a subtitle..."
    autocomplete="off"
    spellcheck="false"
  />
</div>

<div class="write-meta-bar">
  <div class="write-tags-container" id="tags-container">
    <div class="tags-list" id="tags-list"></div>
    <input
      type="text"
      class="write-tags-input"
      id="post-tags-input"
      placeholder="Add up to 7 tags (press Enter)..."
      aria-label="Tags"
      autocomplete="off"
    />
  </div>
</div>

<style>
  .editor-title-group {
    margin-bottom: 24px;
  }

  .write-title-input {
    width: 100%;
    font-family: 'Copernicus', 'Tiempos Headline', 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-weight: 400;
    border: none;
    background: transparent;
    color: var(--color-ink, #141413);
    outline: none;
    letter-spacing: -1.5px;
    line-height: 1.05;
    padding: 0;
    margin-bottom: 12px;
  }

  .write-title-input::placeholder {
    color: var(--color-muted-soft, #8e8b82);
    opacity: 0.5;
  }

  .write-subtitle-input {
    width: 100%;
    font-family: 'Copernicus', 'Tiempos Headline', 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    font-weight: 400;
    border: none;
    background: transparent;
    color: var(--color-muted, #6c6a64);
    outline: none;
    letter-spacing: -0.3px;
    line-height: 1.3;
    padding: 0;
  }

  .write-subtitle-input::placeholder {
    color: var(--color-muted-soft, #8e8b82);
    opacity: 0.5;
  }

  /* Cover Image Styling */
  .cover-image-container {
    margin-bottom: 28px;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
  }

  .add-cover-btn {
    background: var(--color-surface-card, #efe9de);
    border: 1.5px dashed var(--color-hairline, #e6dfd8);
    border-radius: 12px;
    color: var(--color-muted, #6c6a64);
    font-family: var(--font-sans, 'StyreneB', 'Inter', sans-serif);
    font-size: 14px;
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    padding: 24px;
    width: 100%;
    transition: all 0.2s ease;
  }

  .add-cover-btn:hover {
    border-color: var(--color-primary, #cc785c);
    color: var(--color-ink, #141413);
  }

  #cover-image-preview {
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: cover;
    border-radius: 12px;
    display: block;
  }

  .remove-cover-btn {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-surface-dark, #181715);
    color: var(--color-on-dark, #faf9f5);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .remove-cover-btn:hover {
    background: var(--color-primary-active, #252320);
  }

  .write-meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-hairline, #e6dfd8);
  }

  .write-tags-container {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    flex-grow: 1;
    gap: 8px;
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  :global(.tag-chip) {
    background: var(--color-surface-card, #efe9de);
    color: var(--color-ink, #141413);
    padding: 5px 14px;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans, 'StyreneB', 'Inter', sans-serif);
    border: 1px solid var(--color-hairline, #e6dfd8);
    transition: all 0.2s ease;
  }

  :global(.tag-chip:hover) {
    border-color: var(--color-ink, #141413);
  }

  :global(.tag-chip button) {
    background: transparent;
    border: none;
    color: var(--color-muted, #6c6a64);
    width: 16px;
    height: 16px;
    border-radius: 50%;
    cursor: pointer;
    padding: 0;
    font-size: 14px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.tag-chip button:hover) {
    color: var(--color-error, #c64545);
  }

  .write-tags-input {
    flex-grow: 1;
    min-width: 180px;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-sans, 'StyreneB', 'Inter', sans-serif);
    font-size: 14px;
    color: var(--color-ink, #141413);
    padding: 4px 0;
  }

  .write-tags-input::placeholder {
    color: var(--color-muted-soft, #8e8b82);
  }
</style>
