---

<section class="centered-hero" aria-label="Hero">
  <div class="centered-hero-container">
    <div class="centered-hero-content">
      <div class="hero-badge">Daily Insights</div>
      <h1 class="centered-hero-title">Ideas that<br />shape tomorrow.</h1>
      <p class="centered-hero-subtitle">
        Unravel the complexities of science, technology, and the frontiers of human ingenuity.
      </p>
      <div class="hero-actions">
        <a href="/about" class="btn-dark-pill">Start exploring</a>
        <a href="/write" class="btn-outline-pill">Publish a story</a>
      </div>
    </div>
  </div>
</section>

<style>
  .centered-hero {
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-canvas);
    padding: var(--space-xxl) 0;
  }

  .centered-hero-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .centered-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: var(--space-xl);
  }

  .centered-hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    line-height: 1.05;
    letter-spacing: -2px;
    color: var(--color-ink);
    margin-bottom: var(--space-md);
  }

  .centered-hero-subtitle {
    font-family: var(--font-sans);
    font-size: clamp(1.125rem, 2vw, 1.35rem);
    line-height: 1.6;
    color: var(--color-muted);
    margin-bottom: var(--space-xl);
    font-weight: 400;
    max-width: 600px;
  }

  .hero-badge {
    display: inline-block;
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-primary);
    margin-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-primary);
    padding-bottom: 4px;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-dark-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    padding: 0.875rem 2rem;
    border-radius: 9999px;
    background: #181715;
    color: #ffffff;
    text-decoration: none;
    transition:
      opacity var(--duration-fast) var(--ease-default),
      transform var(--duration-fast) var(--ease-default);
  }

  .btn-outline-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    padding: 0.875rem 2rem;
    border-radius: 9999px;
    background: transparent;
    border: 1px solid var(--color-hairline);
    color: var(--color-ink);
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-default);
  }

  .btn-dark-pill:hover {
    opacity: 0.9;
    text-decoration: none;
    transform: translateY(-1px);
  }

  .btn-outline-pill:hover {
    background: rgba(0, 0, 0, 0.03);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .centered-hero-container {
      padding: var(--space-xl) var(--space-4);
    }
  }
</style>
