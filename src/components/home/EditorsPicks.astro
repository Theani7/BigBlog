---
export interface Props {
  featuredStory: any;
  secondaryStories: any[];
}
const { featuredStory, secondaryStories } = Astro.props;

const fallbackCover =
  'https://images.unsplash.com/photo-1518770660439-4636190af475?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80';
const fallbackCoverSecondary =
  'https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80';

const formatStoryDate = (story: any) =>
  new Date(story.publishedAt || story.createdAt).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
const storyExcerpt = (story: any) => {
  const text = story.content ? story.content.replace(/<[^>]+>/g, '').trim() : '';
  return text.length > 120 ? text.substring(0, 120) + '...' : text || 'No excerpt available';
};
---

<section class="editors-picks" aria-label="Editor's Picks">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Editor's Picks</h2>
      <a href="/about" class="section-link">View all &rarr;</a>
    </div>

    <div class="editorial-grid">
      {
        featuredStory ? (
          <article class="card-featured">
            <a
              href={`/p/${featuredStory.slug}`}
              class="card-link-overlay"
              aria-label={`Read ${featuredStory.title}`}
            />
            <div class="card-image-wrapper">
              <img src={fallbackCover} alt={featuredStory.title} width="1200" height="750" />
            </div>
            <div class="card-content">
              <div class="card-meta">
                <span class="card-tag">Featured</span>
                <span class="card-date">{formatStoryDate(featuredStory)}</span>
              </div>
              <h3 class="card-title">{featuredStory.title}</h3>
              <p class="card-excerpt">{storyExcerpt(featuredStory)}</p>
              <div class="card-author">By {featuredStory.authorId?.name || 'Anonymous'}</div>
            </div>
          </article>
        ) : null
      }

      <div class="secondary-articles">
        {
          secondaryStories.map((story) => (
            <article class="card-secondary">
              <a
                href={`/p/${story.slug}`}
                class="card-link-overlay"
                aria-label={`Read ${story.title}`}
              />
              <div class="card-image-wrapper">
                <img src={fallbackCoverSecondary} alt={story.title} width="800" height="533" />
              </div>
              <div class="card-content">
                <div class="card-meta">
                  <span class="card-tag">Latest</span>
                </div>
                <h3 class="card-title">{story.title}</h3>
                <p class="card-excerpt">{storyExcerpt(story)}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .editors-picks {
    padding: var(--space-xxl) clamp(1.5rem, 5vw, 4rem);
    background: var(--bg-canvas);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-ink);
    padding-bottom: var(--space-sm);
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    color: var(--color-ink);
    margin: 0;
  }

  .section-link {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .section-link:hover {
    color: var(--color-primary);
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-xl);
  }

  /* Shared Card Styles */
  .card-featured,
  .card-secondary {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .card-link-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
  }

  .card-image-wrapper {
    overflow: hidden;
    border-radius: var(--radius-none);
    margin-bottom: var(--space-md);
  }

  .card-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-featured:hover .card-image-wrapper img,
  .card-secondary:hover .card-image-wrapper img {
    transform: scale(1.05);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: var(--space-xs);
  }

  .card-tag {
    color: var(--color-primary);
    font-weight: 600;
  }

  .card-date {
    color: var(--color-muted);
  }

  /* Featured Card specifics */
  .card-featured .card-image-wrapper {
    aspect-ratio: 16 / 10;
  }

  .card-featured .card-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3vw, 2.5rem);
    line-height: 1.1;
    margin-bottom: var(--space-sm);
    color: var(--color-ink);
  }

  .card-featured .card-excerpt {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin-bottom: var(--space-md);
    max-width: 90%;
  }

  .card-author {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  /* Secondary Articles column */
  .secondary-articles {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .card-secondary .card-image-wrapper {
    aspect-ratio: 3 / 2;
  }

  .card-secondary .card-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.2;
    margin-bottom: var(--space-xs);
    color: var(--color-ink);
  }

  .card-secondary .card-excerpt {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  @media (max-width: 992px) {
    .editorial-grid {
      grid-template-columns: 1fr;
    }

    .card-featured .card-image-wrapper {
      aspect-ratio: 16 / 9;
    }
  }
</style>
