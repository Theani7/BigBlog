---
/**
 * Image component — responsive images with lightbox, blur placeholder,
 * and modern format support via Cloudinary.
 *
 * Built on top of Picture.astro for format negotiation and srcset.
 * Includes lightbox, captions, credits, and accessibility features.
 */
import Picture from './Picture.astro';
import { type ImageContext } from '@lib/media';

interface ImageProps {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  caption?: string;
  credit?: string;
  blur?: boolean;
  context?: ImageContext;
  aspectRatio?: string;
  rounded?: 'none' | 'sm' | 'md' | 'lg' | 'full';
  border?: boolean;
  shadow?: 'none' | 'sm' | 'md' | 'lg';
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  caption,
  credit,
  blur = false,
  context = 'article',
  aspectRatio,
  rounded = 'lg',
  border = false,
  shadow = 'none',
  loading,
  fetchpriority,
  class: className = '',
} = Astro.props as ImageProps;

const resolvedLoading = loading || (context === 'hero' || context === 'banner' ? 'eager' : 'lazy');
const resolvedFetchPriority =
  fetchpriority || (context === 'hero' || context === 'banner' ? 'high' : 'auto');

const roundedClass = rounded !== 'none' ? `image-figure--rounded-${rounded}` : '';
const borderClass = border ? 'image-figure--border' : '';
const shadowClass = shadow !== 'none' ? `image-figure--shadow-${shadow}` : '';
---

<figure
  class:list={['image-figure', roundedClass, borderClass, shadowClass, className]}
  data-image-figure
>
  <div class="image-wrapper" data-image-wrapper>
    {blur && <div class="image-blur" aria-hidden="true" style={`background-image: url(${src})`} />}
    <Picture
      src={src}
      alt={alt}
      width={width}
      height={height}
      context={context}
      loading={resolvedLoading}
      fetchpriority={resolvedFetchPriority}
      aspectRatio={aspectRatio}
      class="image-figure__picture"
    />
    <button type="button" class="image-zoom" aria-label={`Zoom in on ${alt}`} data-image-zoom>
      <span class="image-zoom__icon" aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="11" y1="8" x2="11" y2="14"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
      </span>
    </button>
  </div>
  {
    (caption || credit) && (
      <figcaption class="image-caption">
        {caption && <span class="image-caption__text">{caption}</span>}
        {credit && (
          <span class="image-caption__credit">
            <span class="image-caption__credit-sep" aria-hidden="true">
              ·
            </span>
            {credit}
          </span>
        )}
      </figcaption>
    )
  }
</figure>

<div
  class="image-lightbox"
  data-lightbox
  hidden
  aria-hidden="true"
  role="dialog"
  aria-label="Image preview"
>
  <button
    type="button"
    class="image-lightbox__close"
    aria-label="Close preview"
    data-lightbox-close
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
  <div class="image-lightbox__content">
    <img src="" alt="" class="image-lightbox__img" data-lightbox-img />
    <p class="image-lightbox__caption" data-lightbox-caption></p>
  </div>
</div>

<style>
  .image-figure {
    margin: var(--space-8) 0;
    text-align: center;
  }

  .image-figure--rounded-sm .image-wrapper {
    border-radius: var(--radius-sm);
  }
  .image-figure--rounded-md .image-wrapper {
    border-radius: var(--radius-md);
  }
  .image-figure--rounded-lg .image-wrapper {
    border-radius: var(--radius-lg);
  }
  .image-figure--rounded-full .image-wrapper {
    border-radius: var(--radius-full);
  }

  .image-figure--border .image-wrapper {
    border: 1px solid var(--border-color);
  }

  .image-figure--shadow-sm .image-wrapper {
    box-shadow: var(--shadow-sm);
  }
  .image-figure--shadow-md .image-wrapper {
    box-shadow: var(--shadow-md);
  }
  .image-figure--shadow-lg .image-wrapper {
    box-shadow: var(--shadow-lg);
  }

  .image-wrapper {
    position: relative;
    display: inline-block;
    max-width: 100%;
    overflow: hidden;
  }

  .image-blur {
    position: absolute;
    inset: 0;
    filter: blur(20px);
    transform: scale(1.1);
    background-size: cover;
    background-position: center;
    opacity: 0.6;
    transition: opacity var(--duration-normal) var(--ease-default);
  }

  .image-blur ~ :global(.picture) {
    position: relative;
    z-index: 1;
  }

  .image-zoom {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-default);
    z-index: 2;
    color: var(--text-primary);
    padding: 0;
  }

  .image-wrapper:hover .image-zoom,
  .image-zoom:focus-visible {
    opacity: 1;
  }

  .image-zoom:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .image-caption {
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    margin-top: var(--space-3);
    text-align: center;
    line-height: var(--leading-normal);
    max-width: 65ch;
    margin-left: auto;
    margin-right: auto;
  }

  .image-caption__credit {
    color: var(--text-tertiary);
    font-style: italic;
  }

  .image-caption__credit-sep {
    margin: 0 var(--space-1);
  }

  .image-lightbox {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background: rgba(0, 0, 0, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-default);
  }

  .image-lightbox:not([hidden]) {
    opacity: 1;
  }

  .image-lightbox__close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    color: white;
    cursor: pointer;
    padding: 0;
    transition: background var(--duration-fast) var(--ease-default);
    z-index: 1;
  }

  .image-lightbox__close:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .image-lightbox__close:focus-visible {
    outline: 2px solid white;
    outline-offset: 2px;
  }

  .image-lightbox__content {
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: default;
  }

  .image-lightbox__img {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: var(--radius-lg);
  }

  .image-lightbox__caption {
    color: rgba(255, 255, 255, 0.8);
    font-size: var(--text-sm);
    margin-top: var(--space-4);
    text-align: center;
    max-width: 60ch;
    line-height: var(--leading-normal);
  }

  @media (prefers-reduced-motion: reduce) {
    .image-blur {
      transition: none;
    }
    .image-zoom {
      transition: none;
    }
    .image-lightbox {
      transition: none;
    }
  }

  @media (max-width: 767px) {
    .image-lightbox {
      padding: var(--space-2);
    }

    .image-lightbox__img {
      max-height: 70vh;
    }
  }
</style>

<script is:inline>
  document.addEventListener('click', (e) => {
    const zoomBtn = e.target.closest('[data-image-zoom]');
    if (zoomBtn) {
      const figure = zoomBtn.closest('[data-image-figure]');
      const img =
        figure?.querySelector('[data-picture-img]') || figure?.querySelector('[data-image]');
      const lightbox = document.querySelector('[data-lightbox]');
      const lightboxImg = document.querySelector('[data-lightbox-img]');
      const lightboxCaption = document.querySelector('[data-lightbox-caption]');
      if (!img || !lightbox || !lightboxImg) return;

      lightboxImg.src = img.currentSrc || img.src;
      lightboxImg.alt = img.alt;
      if (lightboxCaption) {
        const figcaption = figure?.querySelector('.image-caption__text');
        lightboxCaption.textContent = figcaption?.textContent || img.alt || '';
        lightboxCaption.style.display = figcaption || img.alt ? 'block' : 'none';
      }
      lightbox.removeAttribute('hidden');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      requestAnimationFrame(() => {
        lightbox.focus();
      });
      return;
    }

    const closeBtn = e.target.closest('[data-lightbox-close]');
    if (closeBtn) {
      const lightbox = closeBtn.closest('[data-lightbox]');
      if (!lightbox) return;
      lightbox.setAttribute('hidden', '');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      return;
    }

    const lightbox = e.target.closest('[data-lightbox]');
    if (lightbox && e.target === lightbox) {
      lightbox.setAttribute('hidden', '');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const lightbox = document.querySelector('[data-lightbox]');
      if (!lightbox || lightbox.hasAttribute('hidden')) return;
      lightbox.setAttribute('hidden', '');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  });
</script>
