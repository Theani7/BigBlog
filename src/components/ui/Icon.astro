---
import type { ComponentProps } from 'astro/types';

import ArrowRight from 'lucide-astro/ArrowRight';
import ChevronDown from 'lucide-astro/ChevronDown';
import ChevronUp from 'lucide-astro/ChevronUp';
import ChevronLeft from 'lucide-astro/ChevronLeft';
import ChevronRight from 'lucide-astro/ChevronRight';
import User from 'lucide-astro/User';
import AlertCircle from 'lucide-astro/AlertCircle';
import X from 'lucide-astro/X';
import Sun from 'lucide-astro/Sun';
import Moon from 'lucide-astro/Moon';
import Menu from 'lucide-astro/Menu';
import Search from 'lucide-astro/Search';
import Clock from 'lucide-astro/Clock';
import Mail from 'lucide-astro/Mail';
import Copy from 'lucide-astro/Copy';
import Share2 from 'lucide-astro/Share2';
import Inbox from 'lucide-astro/Inbox';
import Check from 'lucide-astro/Check';
import Circle from 'lucide-astro/Circle';
import WrapText from 'lucide-astro/WrapText';

interface IconProps {
  name: string;
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  color?: string;
  strokeWidth?: number;
  class?: string;
}

const iconMap: Record<string, any> = {
  ArrowRight,
  ChevronDown,
  ChevronUp,
  ChevronLeft,
  ChevronRight,
  User,
  'alert-circle': AlertCircle,
  AlertCircle,
  x: X,
  X,
  sun: Sun,
  Sun,
  moon: Moon,
  Moon,
  menu: Menu,
  Menu,
  search: Search,
  Search,
  clock: Clock,
  Clock,
  mail: Mail,
  Mail,
  copy: Copy,
  Copy,
  'share-2': Share2,
  Share2,
  inbox: Inbox,
  Inbox,
  check: Check,
  Check,
  circle: Circle,
  Circle,
  WrapText,
  'brand-twitter': null,
  'brand-linkedin': null,
  'brand-facebook': null,
  'chevron-down': ChevronDown,
  'chevron-up': ChevronUp,
  'chevron-left': ChevronLeft,
  'chevron-right': ChevronRight,
};

const {
  name,
  size = 'md',
  color = 'currentColor',
  strokeWidth = 1.5,
  class: className,
} = Astro.props as IconProps;

const sizeMap = {
  xs: 12,
  sm: 16,
  md: 20,
  lg: 24,
  xl: 32,
};

const IconComponent = iconMap[name] ?? iconMap[name.toLowerCase()];
---

{
  IconComponent && (
    <span
      aria-hidden="true"
      class={className}
      style="display: inline-flex; align-items: center; justify-content: center;"
    >
      <IconComponent size={sizeMap[size]} color={color} strokeWidth={strokeWidth} />
    </span>
  )
}
