---
import type { ComponentProps } from 'astro/types';
import Surface from '../layout/Surface.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Picture from '../ui/Picture.astro';

interface ArticleCardProps {
  title: string;
  description: string;
  slug: string;
  date: string;
  category: string;
  tags?: string[];
  cover?: string;
  author?: string;
  readingTime?: string;
}

const { title, description, slug, date, category, tags, cover, author, readingTime } =
  Astro.props as ArticleCardProps;
---

<article class="article-card" aria-labelledby={`article-card-title-${slug}`}>
  <Surface elevation={0} rounded="lg" bg="primary" padding="none">
    {
      cover && (
        <div class="article-card__cover">
          <Picture src={cover} alt={title} context="card" aspectRatio="16/9" />
        </div>
      )
    }
    <div class="article-card__body">
      <div class="article-card__meta">
        <Badge variant="primary">{category}</Badge>
        {readingTime && <span class="article-card__reading-time">{readingTime}</span>}
      </div>
      <h3 class="article-card__title" id={`article-card-title-${slug}`}>
        <a href={`/blog/${slug}`}>{title}</a>
      </h3>
      <p class="article-card__description">{description}</p>
      <div class="article-card__footer">
        {author && <span class="article-card__author">{author}</span>}
        <time class="article-card__date" datetime={date}>{date}</time>
      </div>
      {
        tags && tags.length > 0 && (
          <div class="article-card__tags">
            {tags.map((tag) => (
              <Badge variant="default">{tag}</Badge>
            ))}
          </div>
        )
      }
      <div class="article-card__action">
        <Button variant="link" href={`/blog/${slug}`}>Read more</Button>
      </div>
    </div>
  </Surface>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    box-shadow: var(--elevation-1);
    transition:
      box-shadow var(--transition-normal) var(--ease-default),
      transform var(--transition-normal) var(--ease-default);
    overflow: hidden;
  }

  .article-card:hover {
    box-shadow: var(--elevation-4);
    transform: translateY(-2px);
  }

  .article-card:focus-within {
    box-shadow: var(--focus-ring);
  }

  .article-card__cover {
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .article-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-default);
  }

  .article-card:hover .article-card__cover img {
    transform: scale(1.03);
  }

  .article-card__body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .article-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .article-card__reading-time {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .article-card__title {
    margin: 0;
    font-size: var(--text-h4);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-h4);
  }

  .article-card__title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-default);
  }

  .article-card__title a:hover {
    color: var(--color-primary);
  }

  .article-card__description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-body);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .article-card__author {
    font-weight: var(--weight-medium);
    color: var(--text-secondary);
  }

  .article-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .article-card__action {
    padding-top: var(--space-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .article-card {
      transition: none;
    }

    .article-card__cover img {
      transition: none;
    }
  }

  .article-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
</style>
