---
import type { ComponentProps } from 'astro/types';
import Surface from '../layout/Surface.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

interface SeriesCardProps {
  title: string;
  slug: string;
  description: string;
  cover?: string;
  author?: string;
  postCount: number;
}

const { title, slug, description, cover, author, postCount } = Astro.props as SeriesCardProps;
---

<article class="series-card" aria-labelledby={`series-card-title-${slug}`}>
  <Surface elevation={0} rounded="lg" bg="primary" padding="none">
    {
      cover && (
        <div class="series-card__cover">
          <img src={cover} alt={title} loading="lazy" />
        </div>
      )
    }
    <div class="series-card__body">
      <div class="series-card__meta">
        <Badge variant="secondary">Series</Badge>
        {author && <span class="series-card__author">{author}</span>}
      </div>
      <h3 class="series-card__title" id={`series-card-title-${slug}`}>
        <a href={`/blog/series/${slug}`}>{title}</a>
      </h3>
      <p class="series-card__description">{description}</p>
      <div class="series-card__progress">
        <div
          class="series-card__progress-bar"
          role="progressbar"
          aria-valuenow={postCount}
          aria-valuemin={0}
          aria-valuemax={100}
        >
          <div class="series-card__progress-fill"></div>
        </div>
        <span class="series-card__post-count">{postCount} articles</span>
      </div>
      <div class="series-card__action">
        <Button variant="link" href={`/blog/series/${slug}`}>View series</Button>
      </div>
    </div>
  </Surface>
</article>

<style>
  .series-card {
    border-radius: var(--radius-lg);
    box-shadow: var(--elevation-1);
    transition:
      box-shadow var(--transition-normal) var(--ease-default),
      transform var(--transition-normal) var(--ease-default);
    overflow: hidden;
  }

  .series-card:hover {
    box-shadow: var(--elevation-4);
    transform: translateY(-2px);
  }

  .series-card:focus-within {
    box-shadow: var(--focus-ring);
  }

  .series-card__cover {
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .series-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-default);
  }

  .series-card:hover .series-card__cover img {
    transform: scale(1.03);
  }

  .series-card__body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .series-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .series-card__author {
    font-weight: var(--weight-medium);
    color: var(--text-secondary);
  }

  .series-card__title {
    margin: 0;
    font-size: var(--text-h4);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-h4);
  }

  .series-card__title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-default);
  }

  .series-card__title a:hover {
    color: var(--color-primary);
  }

  .series-card__description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-body);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .series-card__progress {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .series-card__progress-bar {
    flex: 1;
    height: 4px;
    background: var(--border-color);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .series-card__progress-fill {
    height: 100%;
    background: var(--color-secondary);
    border-radius: var(--radius-full);
    width: 100%;
    transition: width var(--duration-normal) var(--ease-default);
  }

  .series-card__post-count {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  .series-card__action {
    padding-top: var(--space-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .series-card {
      transition: none;
    }

    .series-card__cover img {
      transition: none;
    }

    .series-card__progress-fill {
      transition: none;
    }
  }

  .series-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
</style>
