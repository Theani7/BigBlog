---
import type { ComponentProps } from 'astro/types';
import Surface from '../layout/Surface.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Picture from '../ui/Picture.astro';

interface ProjectCardProps {
  title: string;
  description: string;
  slug: string;
  cover?: string;
  tags?: string[];
  status: 'active' | 'completed';
}

const { title, description, slug, cover, tags, status } = Astro.props as ProjectCardProps;
---

<article class="project-card" aria-labelledby={`project-card-title-${slug}`}>
  <Surface elevation={0} rounded="lg" bg="primary" padding="none">
    {
      cover && (
        <div class="project-card__cover">
          <Picture src={cover} alt={title} context="card" aspectRatio="16/9" />
        </div>
      )
    }
    <div class="project-card__body">
      <div class="project-card__header">
        <h3 class="project-card__title" id={`project-card-title-${slug}`}>
          <a href={`/projects/${slug}`}>{title}</a>
        </h3>
        <Badge variant={status === 'active' ? 'success' : 'default'}>
          {status}
        </Badge>
      </div>
      <p class="project-card__description">{description}</p>
      {
        tags && tags.length > 0 && (
          <div class="project-card__tags">
            {tags.map((tag) => (
              <Badge variant="default">{tag}</Badge>
            ))}
          </div>
        )
      }
      <div class="project-card__action">
        <Button variant="link" href={`/projects/${slug}`}>View project</Button>
      </div>
    </div>
  </Surface>
</article>

<style>
  .project-card {
    border-radius: var(--radius-lg);
    box-shadow: var(--elevation-1);
    transition:
      box-shadow var(--transition-normal) var(--ease-default),
      transform var(--transition-normal) var(--ease-default);
    overflow: hidden;
  }

  .project-card:hover {
    box-shadow: var(--elevation-4);
    transform: translateY(-2px);
  }

  .project-card:focus-within {
    box-shadow: var(--focus-ring);
  }

  .project-card__cover {
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .project-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-default);
  }

  .project-card:hover .project-card__cover img {
    transform: scale(1.03);
  }

  .project-card__body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .project-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .project-card__title {
    margin: 0;
    font-size: var(--text-h4);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-h4);
  }

  .project-card__title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-default);
  }

  .project-card__title a:hover {
    color: var(--color-primary);
  }

  .project-card__description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-body);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .project-card__action {
    padding-top: var(--space-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }

    .project-card__cover img {
      transition: none;
    }
  }

  .project-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
</style>
