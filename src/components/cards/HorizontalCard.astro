---
import type { ComponentProps } from 'astro/types';
import Surface from '../layout/Surface.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

interface HorizontalCardProps {
  title: string;
  description: string;
  slug: string;
  date: string;
  category: string;
  cover: string;
  author: string;
}

const { title, description, slug, date, category, cover, author } =
  Astro.props as HorizontalCardProps;
---

<article class="horizontal-card" aria-labelledby={`horizontal-card-title-${slug}`}>
  <Surface elevation={0} rounded="lg" bg="primary" padding="none">
    <div class="horizontal-card__layout">
      <div class="horizontal-card__image">
        <img src={cover} alt={title} loading="lazy" />
      </div>
      <div class="horizontal-card__body">
        <div class="horizontal-card__meta">
          <Badge variant="primary">{category}</Badge>
          <time class="horizontal-card__date" datetime={date}>{date}</time>
        </div>
        <h3 class="horizontal-card__title" id={`horizontal-card-title-${slug}`}>
          <a href={`/blog/${slug}`}>{title}</a>
        </h3>
        <p class="horizontal-card__description">{description}</p>
        <div class="horizontal-card__footer">
          <span class="horizontal-card__author">{author}</span>
          <Button variant="link" href={`/blog/${slug}`}>Read more</Button>
        </div>
      </div>
    </div>
  </Surface>
</article>

<style>
  .horizontal-card {
    border-radius: var(--radius-lg);
    box-shadow: var(--elevation-1);
    transition:
      box-shadow var(--transition-normal) var(--ease-default),
      transform var(--transition-normal) var(--ease-default);
    overflow: hidden;
  }

  .horizontal-card:hover {
    box-shadow: var(--elevation-4);
    transform: translateY(-1px);
  }

  .horizontal-card:focus-within {
    box-shadow: var(--focus-ring);
  }

  .horizontal-card__layout {
    display: flex;
    flex-direction: row;
  }

  .horizontal-card__image {
    flex: 0 0 40%;
    overflow: hidden;
    min-height: 12rem;
  }

  .horizontal-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-default);
  }

  .horizontal-card:hover .horizontal-card__image img {
    transform: scale(1.03);
  }

  .horizontal-card__body {
    flex: 1;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .horizontal-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .horizontal-card__date {
    font-weight: var(--weight-medium);
  }

  .horizontal-card__title {
    margin: 0;
    font-size: var(--text-h4);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-h4);
  }

  .horizontal-card__title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-default);
  }

  .horizontal-card__title a:hover {
    color: var(--color-primary);
  }

  .horizontal-card__description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-body);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .horizontal-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .horizontal-card__author {
    font-weight: var(--weight-medium);
    color: var(--text-secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .horizontal-card {
      transition: none;
    }

    .horizontal-card__image img {
      transition: none;
    }
  }

  @media (max-width: 768px) {
    .horizontal-card__layout {
      flex-direction: column;
    }

    .horizontal-card__image {
      flex: none;
      min-height: 10rem;
    }
  }

  .horizontal-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
</style>
