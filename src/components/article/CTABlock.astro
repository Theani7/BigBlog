---
import type { ComponentProps } from 'astro/types';
import Surface from '../layout/Surface.astro';
import Button from '../ui/Button.astro';

interface CTABlockProps {
  title: string;
  description?: string;
  primaryAction: { label: string; href: string };
  secondaryAction?: { label: string; href: string };
}

const { title, description, primaryAction, secondaryAction } = Astro.props as CTABlockProps;
---

<section class="cta-block" aria-label="Call to action">
  <Surface elevation={0} rounded="lg" bg="primary" padding="lg">
    <div class="cta-block__content">
      <h2 class="cta-block__title">{title}</h2>
      {description && <p class="cta-block__description">{description}</p>}
      <div class="cta-block__actions">
        <Button variant="primary" href={primaryAction.href}>
          {primaryAction.label}
        </Button>
        {
          secondaryAction && (
            <Button variant="outline" href={secondaryAction.href}>
              {secondaryAction.label}
            </Button>
          )
        }
      </div>
    </div>
  </Surface>
</section>

<style>
  .cta-block {
    margin: var(--space-8) 0;
  }

  .cta-block__content {
    text-align: center;
  }

  .cta-block__title {
    font-size: var(--text-h2);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-3) 0;
  }

  .cta-block__description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-lead);
    margin: 0 0 var(--space-6) 0;
    max-width: 65ch;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-block__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-block {
      transition: none;
    }
  }

  .cta-block:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
</style>
