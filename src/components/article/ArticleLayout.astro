---
import type { Post, SeriesNavigation } from '../../types/content';
import { readingTime } from '../../utils/content';

interface ArticleLayoutProps {
  post: Post;
  seriesNav?: SeriesNavigation;
  relatedPosts?: Array<{ title: string; slug: string }>;
  toc?: Array<{ id: string; text: string; level: number }>;
}

const { post, seriesNav, relatedPosts, toc } = Astro.props;
const rt = readingTime(post.body);
---

<article class="article">
  <header class="article-header">
    {
      post.data.cover && (
        <div class="article-cover">
          <img src={post.data.cover} alt={post.data.coverAlt || post.data.title} />
        </div>
      )
    }
    <div class="article-meta">
      <span class="article-category">{post.data.category}</span>
      <time datetime={post.data.publishedAt.toISOString()}>
        {
          post.data.publishedAt.toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
          })
        }
      </time>
      <span class="article-reading-time">{rt.minutes} min read</span>
      {
        post.data.updatedAt && (
          <span class="article-updated">
            Updated{' '}
            {post.data.updatedAt.toLocaleDateString('en-US', {
              month: 'long',
              day: 'numeric',
              year: 'numeric',
            })}
          </span>
        )
      }
    </div>
    <h1 class="article-title">{post.data.title}</h1>
    <p class="article-description">{post.data.description}</p>
    <div class="article-tags">
      {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  </header>

  {
    toc && toc.length > 0 && (
      <nav class="article-toc" aria-label="Table of contents">
        <h2>Contents</h2>
        <ul class="toc-list">
          {toc.map((heading) => (
            <li class={`toc-item toc-level-${heading.level}`}>
              <a href={`#${heading.id}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <div class="article-body">
    <slot />
  </div>

  {
    seriesNav && (
      <nav class="article-series" aria-label="Series navigation">
        <div class="series-progress">
          <span>
            Part {seriesNav.progress.current} of {seriesNav.progress.total}
          </span>
          <div class="progress-bar">
            <div class="progress-fill" style="width: {seriesNav.progress.percentage}%" />
          </div>
        </div>
        <div class="series-nav-links">
          {seriesNav.previous && (
            <a href={`/blog/${seriesNav.previous.slug}`} class="series-prev">
              ← {seriesNav.previous.data.title}
            </a>
          )}
          {seriesNav.next && (
            <a href={`/blog/${seriesNav.next.slug}`} class="series-next">
              {seriesNav.next.data.title} →
            </a>
          )}
        </div>
      </nav>
    )
  }

  {
    relatedPosts && relatedPosts.length > 0 && (
      <section class="article-related">
        <h2>Related Articles</h2>
        <ul class="related-list">
          {relatedPosts.map((rp) => (
            <li>
              <a href={`/blog/${rp.slug}`}>{rp.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</article>

<style>
  .article {
    max-width: 48rem;
    margin: 0 auto;
  }

  .article-cover {
    margin-bottom: var(--space-8);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .article-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .article-category {
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: var(--text-xs);
  }

  .article-reading-time {
    color: var(--text-tertiary);
  }

  .article-updated {
    color: var(--text-tertiary);
    font-style: italic;
  }

  .article-title {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    line-height: var(--leading-tight);
    margin-bottom: var(--space-4);
  }

  .article-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .tag {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: var(--radius-full);
  }

  .article-toc {
    padding: var(--space-6);
    margin-bottom: var(--space-8);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
  }

  .article-toc h2 {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .toc-list {
    list-style: none;
    padding: 0;
  }

  .toc-item {
    padding: 0.125rem 0;
  }

  .toc-item a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .toc-item a:hover {
    color: var(--color-primary);
  }

  .toc-level-2 {
    padding-left: var(--space-4);
  }
  .toc-level-3 {
    padding-left: var(--space-8);
  }
  .toc-level-4 {
    padding-left: var(--space-12);
  }

  .article-body {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .article-series {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-color);
  }

  .series-progress {
    margin-bottom: var(--space-4);
  }

  .series-progress span {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .progress-bar {
    height: 4px;
    background: var(--border-color);
    border-radius: var(--radius-full);
    margin-top: var(--space-2);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--color-primary);
    border-radius: var(--radius-full);
    transition: width var(--duration-normal) var(--ease-default);
  }

  .series-nav-links {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .series-prev,
  .series-next {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-secondary);
    text-decoration: none;
  }

  .series-prev:hover,
  .series-next:hover {
    color: var(--color-primary);
  }

  .article-related {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-color);
  }

  .article-related h2 {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-4);
  }

  .related-list {
    list-style: none;
    padding: 0;
  }

  .related-list li {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border-color);
  }

  .related-list a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .related-list a:hover {
    color: var(--color-primary);
  }
</style>
