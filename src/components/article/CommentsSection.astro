---
export interface Props {
  // Add props if needed
}
---

<section class="comments-section" id="comments-section" aria-label="Comments">
  <h2 class="comments-title">Responses <span id="comments-title-count">0</span></h2>

  <div class="comment-auth-gate" id="comment-auth-gate" hidden>
    <div class="gate-icon" aria-hidden="true">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path
          d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
        ></path></svg
      >
    </div>
    <h3 class="gate-title">Join the conversation</h3>
    <p class="gate-text">
      Sign in to share your thoughts, reply to readers, and react to comments.
    </p>
    <button type="button" class="btn-primary" data-auth-modal="login">Sign in to comment</button>
  </div>

  <form class="comment-form" id="comment-form" novalidate hidden>
    <div class="comment-as" id="comment-as" hidden>
      Commenting as <strong id="comment-as-name"></strong>
    </div>
    <textarea
      id="comment-content"
      class="comment-content text-input"
      placeholder="Share your thoughts on this story…"
      maxlength="5000"
      rows="4"
      required></textarea>
    <div class="comment-form-actions">
      <span class="comment-error" id="comment-error" role="alert" hidden></span>
      <button type="submit" class="btn-primary" id="comment-submit">Respond</button>
    </div>
  </form>

  <div class="comment-status" id="comment-status" role="status" hidden></div>

  <div class="comment-list" id="comment-list"></div>
</section>

<style>
  .comments-section {
    margin-top: var(--space-section);
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--space-xl);
  }

  .comments-title {
    font-family: var(--font-serif);
    font-size: var(--text-display-sm);
    font-weight: 400;
    letter-spacing: -0.3px;
    color: var(--color-ink);
    margin-bottom: var(--space-xl);
  }

  .comments-title span {
    color: var(--color-muted);
  }

  .comment-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .comment-form[hidden],
  .comment-auth-gate[hidden] {
    display: none;
  }

  .comment-auth-gate {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xl);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-xl);
    text-align: center;
    background: var(--bg-surface-soft);
  }

  .gate-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink);
    margin-bottom: var(--space-xs);
  }

  .gate-title {
    font-family: var(--font-sans);
    font-size: var(--text-title-md);
    font-weight: 500;
    color: var(--color-ink);
    margin: 0;
  }

  .gate-text {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    line-height: var(--leading-normal);
    color: var(--color-muted);
    margin: 0 0 var(--space-md);
    max-width: 360px;
  }

  .btn-primary {
    font-family: var(--font-sans);
    font-size: var(--text-button);
    font-weight: 500;
    padding: 12px 20px;
    height: 40px;
    border: none;
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-on-primary);
    cursor: pointer;
    transition: background var(--duration-fast);
  }

  .btn-primary:hover {
    background: var(--color-primary-active);
  }

  .btn-primary:disabled {
    background: var(--color-primary-disabled);
    color: var(--color-muted);
    cursor: not-allowed;
  }

  .comment-as {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-muted);
  }

  .comment-as strong {
    color: var(--color-ink);
    font-weight: 500;
  }

  .text-input {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    padding: 10px 14px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--bg-canvas);
    color: var(--color-ink);
    resize: vertical;
    min-height: 96px;
  }

  .text-input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .comment-form-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-md);
  }

  .comment-error {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-error);
    flex: 1;
    text-align: left;
  }

  .comment-status {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-success);
    padding: var(--space-sm) 0;
    margin-bottom: var(--space-md);
  }

  .comment-status[hidden] {
    display: none;
  }

  /* Overriding old comment list styles injected by JS */
  :global(.comment-list) {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  :global(.comment-item) {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  :global(.comment-item.is-reply) {
    padding-left: var(--space-lg);
    border-left: 1px solid var(--color-hairline);
  }

  :global(.comment-head) {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  :global(.comment-avatar) {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: var(--bg-surface-card);
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-weight: 500;
    flex-shrink: 0;
  }

  :global(.comment-author) {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: var(--color-ink);
  }

  :global(.comment-time) {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
  }

  :global(.comment-edited) {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
    font-style: italic;
  }

  :global(.comment-body) {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    line-height: var(--leading-normal);
    color: var(--color-body);
    white-space: pre-wrap;
    word-break: break-word;
  }

  :global(.comment-foot) {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  :global(.reaction-btn) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: none;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    padding: 2px 10px;
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
    cursor: pointer;
    transition: all var(--duration-fast);
  }

  :global(.reaction-btn:hover) {
    border-color: var(--color-muted);
  }

  :global(.reaction-btn.is-active) {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: var(--bg-surface-soft);
  }

  :global(.comment-reply-btn) {
    background: none;
    border: none;
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
    cursor: pointer;
    padding: 2px 4px;
    transition: color var(--duration-fast);
  }

  :global(.comment-reply-btn:hover) {
    color: var(--color-ink);
  }

  :global(.comment-menu) {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  :global(.comment-menu-btn) {
    background: none;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    padding: 4px 6px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    transition:
      color var(--duration-fast),
      background var(--duration-fast);
  }

  :global(.comment-menu-btn:hover) {
    color: var(--color-ink);
    background: var(--bg-surface-soft);
  }

  :global(.comment-empty) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    text-align: center;
    padding: var(--space-xl);
    border-top: 1px solid var(--color-hairline);
    border-bottom: 1px solid var(--color-hairline);
  }

  :global(.comment-empty-title) {
    font-family: var(--font-sans);
    font-size: var(--text-title-md);
    font-weight: 500;
    color: var(--color-ink);
    margin: 0;
  }

  :global(.comment-empty-text) {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    color: var(--color-muted);
    margin: 0;
    max-width: 340px;
    line-height: var(--leading-normal);
  }

  :global(.comment-empty-cta) {
    margin-top: var(--space-sm);
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 500;
    padding: 8px 20px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-hairline);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition: background var(--duration-fast);
  }

  :global(.comment-empty-cta:hover) {
    background: var(--bg-surface-soft);
  }
</style>
