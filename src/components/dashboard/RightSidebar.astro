<style>
  .right-sidebar {
    position: sticky;
    top: var(--header-height);
    height: calc(100vh - var(--header-height));
    overflow-y: auto;
    padding: var(--space-xl) var(--space-lg);
  }

  .right-sidebar::-webkit-scrollbar {
    width: 0;
  }

  .right-sidebar-title {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: var(--space-lg);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  /* ── Staff Picks ── */
  .staff-picks {
    margin-bottom: var(--space-xxl);
  }

  .pick-item {
    margin-bottom: var(--space-lg);
  }

  .pick-author {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: 6px;
  }

  .pick-avatar {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 0.5rem;
    font-weight: 600;
    color: white;
    flex-shrink: 0;
  }

  .pick-author-name {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-ink);
    font-weight: 400;
  }

  .pick-title {
    display: block;
    font-family: var(--font-serif);
    font-size: var(--text-body-md);
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
    line-height: 1.3;
    margin-bottom: 4px;
    letter-spacing: -0.2px;
    transition: color var(--duration-fast);
  }

  .pick-title:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .pick-date {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
  }

  .see-full-list {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .see-full-list:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  /* ── Recommended Topics ── */
  .recommended-topics {
    margin-bottom: var(--space-xxl);
  }

  .topic-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .topic-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-body);
    padding: 8px 16px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: all var(--duration-fast);
    background: transparent;
  }

  .topic-chip:hover {
    border-color: var(--color-muted-soft);
    color: var(--color-ink);
    text-decoration: none;
  }

  .chip-plus {
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 300;
  }

  .see-more-topics {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .see-more-topics:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  /* ── Admin Panel ── */
  .admin-panel {
    padding: var(--space-md);
    background: var(--bg-surface-soft);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-hairline);
  }

  .admin-panel .right-sidebar-title {
    font-size: var(--text-body-sm);
    margin-bottom: var(--space-md);
    color: var(--color-primary);
  }

  .admin-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .admin-link {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 8px 10px;
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-body);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: all var(--duration-fast);
  }

  .admin-link:hover {
    background: var(--bg-surface-card);
    color: var(--color-ink);
    text-decoration: none;
  }

  @media (max-width: 1100px) {
    .right-sidebar {
      display: none;
    }
  }
</style>
