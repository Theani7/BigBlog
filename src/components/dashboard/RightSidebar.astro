---
import { createDatabase, type Env } from '../../db';
import { Story, User } from '../../db/schema';

// Ensure User model is registered for Mongoose populate
void User;

export interface Props {
  // Add props if needed
}

const env = (Astro.locals as { env?: Env }).env;

interface StaffPick {
  title: string;
  slug: string;
  authorName: string;
  authorAvatar?: string;
  formattedDate: string;
}

interface TopicItem {
  name: string;
  tag: string;
}

let staffPicks: StaffPick[] = [];
let recommendedTopics: TopicItem[] = [];

if (env) {
  try {
    await createDatabase(env);

    // Fetch top 3 "Staff Picks" dynamically from Story model
    // (published stories populated with authorId, sorted by views or publishedAt)
    const picks = await Story.find({ status: 'PUBLISHED' })
      .populate('authorId', 'name avatar')
      .sort({ views: -1, publishedAt: -1, createdAt: -1 })
      .limit(3)
      .lean();

    staffPicks = picks.map((story: any) => {
      const author = story.authorId || {};
      const authorName = author.name || 'Anonymous';
      const authorAvatar = author.avatar || '';

      const dateVal = story.publishedAt || story.createdAt;
      let formattedDate = '';
      if (dateVal) {
        const d = new Date(dateVal);
        formattedDate = d.toLocaleDateString('en-US', {
          month: 'short',
          day: 'numeric',
        });
      }

      return {
        title: story.title || 'Untitled',
        slug: story.slug,
        authorName,
        authorAvatar,
        formattedDate,
      };
    });

    // Fetch "Recommended Topics" dynamically from Story model (aggregating top tags/categories)
    const tagAgg = await Story.aggregate([
      { $match: { status: 'PUBLISHED' } },
      { $unwind: '$tags' },
      { $match: { tags: { $exists: true, $ne: '' } } },
      { $group: { _id: '$tags', count: { $sum: 1 } } },
      { $sort: { count: -1 } },
      { $limit: 10 },
    ]);

    const categoryAgg = await Story.aggregate([
      { $match: { status: 'PUBLISHED', category: { $exists: true, $ne: null } } },
      { $group: { _id: '$category', count: { $sum: 1 } } },
      { $sort: { count: -1 } },
      { $limit: 5 },
    ]);

    const topicSet = new Map<string, string>(); // tag -> displayName

    tagAgg.forEach((t: { _id: string }) => {
      if (t._id) {
        const raw = t._id.trim();
        const tag = raw.toLowerCase();
        const displayName = raw.length > 0 ? raw.charAt(0).toUpperCase() + raw.slice(1) : raw;
        if (!topicSet.has(tag)) {
          topicSet.set(tag, displayName);
        }
      }
    });

    categoryAgg.forEach((c: { _id: string }) => {
      if (c._id) {
        const raw = c._id.trim();
        const tag = raw.toLowerCase();
        const displayName = raw;
        if (!topicSet.has(tag)) {
          topicSet.set(tag, displayName);
        }
      }
    });

    recommendedTopics = Array.from(topicSet.entries())
      .slice(0, 7)
      .map(([tag, name]) => ({
        tag,
        name,
      }));
  } catch (error) {
    console.error('Failed to load RightSidebar data from MongoDB:', error);
  }
}

// Fallback if DB is empty or recommended topics yielded no items
const defaultTopics: TopicItem[] = [
  { name: 'Programming', tag: 'programming' },
  { name: 'Self Improvement', tag: 'self-improvement' },
  { name: 'Writing', tag: 'writing' },
  { name: 'Relationships', tag: 'relationships' },
  { name: 'Machine Learning', tag: 'machine-learning' },
  { name: 'Politics', tag: 'politics' },
  { name: 'Cryptocurrency', tag: 'cryptocurrency' },
];

if (recommendedTopics.length === 0) {
  recommendedTopics = defaultTopics;
}

const gradientPairs: Array<[string, string]> = [
  ['#10b981', '#059669'],
  ['#8b5cf6', '#6d28d9'],
  ['#f59e0b', '#d97706'],
  ['#3b82f6', '#1d4ed8'],
  ['#ec4899', '#be185d'],
];

const getInitials = (name: string) => {
  if (!name) return 'A';
  const parts = name.trim().split(/\s+/);
  if (parts.length >= 2) {
    return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  }
  return name.slice(0, 2).toUpperCase();
};
---

<aside class="right-sidebar" id="right-sidebar">
  <section class="staff-picks">
    <h3 class="right-sidebar-title">Staff Picks</h3>

    {
      staffPicks.length > 0 ? (
        staffPicks.map((pick, index) => (
          <div class="pick-item">
            <div class="pick-author">
              <div
                class="pick-avatar"
                style={`background: linear-gradient(135deg, ${
                  gradientPairs[index % gradientPairs.length][0]
                }, ${gradientPairs[index % gradientPairs.length][1]});`}
              >
                {pick.authorAvatar ? (
                  <img src={pick.authorAvatar} alt={pick.authorName} class="pick-avatar-img" />
                ) : (
                  <span>{getInitials(pick.authorName)}</span>
                )}
              </div>
              <span class="pick-author-name">{pick.authorName}</span>
            </div>
            <a href={`/p/${pick.slug}`} class="pick-title">
              {pick.title}
            </a>
            {pick.formattedDate && <span class="pick-date">{pick.formattedDate}</span>}
          </div>
        ))
      ) : (
        <p class="sidebar-empty-text">No staff picks available yet.</p>
      )
    }

    <a href="/stories" class="see-full-list">See the full list</a>
  </section>

  <section class="recommended-topics">
    <h3 class="right-sidebar-title">Recommended topics</h3>
    <div class="topic-chips">
      {
        recommendedTopics.map((topic) => (
          <a href={`/tag/${topic.tag}`} class="topic-chip">
            {topic.name} <span class="chip-plus">+</span>
          </a>
        ))
      }
    </div>
    <a href="/tags" class="see-more-topics">See more topics</a>
  </section>

  <section class="admin-panel" id="admin-panel" style="display: none;">
    <h3 class="right-sidebar-title">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg
      >
      Admin Panel
    </h3>
    <div class="admin-links">
      <a href="#" class="admin-link">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          ><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"
          ></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"
          ></path></svg
        >
        Manage Users
      </a>
      <a href="#" class="admin-link">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          ><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline
            points="14 2 14 8 20 8"></polyline></svg
        >
        Review Content
      </a>
      <a href="#" class="admin-link">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          ><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line
            x1="3"
            y1="9"
            x2="21"
            y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg
        >
        Site Settings
      </a>
      <a href="#" class="admin-link">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg
        >
        Analytics
      </a>
    </div>
  </section>
</aside>

<style>
  .right-sidebar {
    position: sticky;
    top: var(--header-height);
    height: calc(100vh - var(--header-height));
    overflow-y: auto;
    padding: var(--space-xl) var(--space-lg);
  }

  .right-sidebar::-webkit-scrollbar {
    width: 0;
  }

  .right-sidebar-title {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: var(--space-lg);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  /* ── Staff Picks ── */
  .staff-picks {
    margin-bottom: var(--space-xxl);
  }

  .pick-item {
    margin-bottom: var(--space-lg);
  }

  .pick-author {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: 6px;
  }

  .pick-avatar {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 0.5rem;
    font-weight: 600;
    color: white;
    flex-shrink: 0;
    overflow: hidden;
  }

  .pick-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .sidebar-empty-text {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
    font-style: italic;
    margin-bottom: var(--space-md);
  }

  .pick-author-name {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-ink);
    font-weight: 400;
  }

  .pick-title {
    display: block;
    font-family: var(--font-serif);
    font-size: var(--text-body-md);
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
    line-height: 1.3;
    margin-bottom: 4px;
    letter-spacing: -0.2px;
    transition: color var(--duration-fast);
  }

  .pick-title:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .pick-date {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
  }

  .see-full-list {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .see-full-list:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  /* ── Recommended Topics ── */
  .recommended-topics {
    margin-bottom: var(--space-xxl);
  }

  .topic-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .topic-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-body);
    padding: 8px 16px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: all var(--duration-fast);
    background: transparent;
  }

  .topic-chip:hover {
    border-color: var(--color-muted-soft);
    color: var(--color-ink);
    text-decoration: none;
  }

  .chip-plus {
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 300;
  }

  .see-more-topics {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .see-more-topics:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  /* ── Admin Panel ── */
  .admin-panel {
    padding: var(--space-md);
    background: var(--bg-surface-soft);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-hairline);
  }

  .admin-panel .right-sidebar-title {
    font-size: var(--text-body-sm);
    margin-bottom: var(--space-md);
    color: var(--color-primary);
  }

  .admin-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .admin-link {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 8px 10px;
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-body);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: all var(--duration-fast);
  }

  .admin-link:hover {
    background: var(--bg-surface-card);
    color: var(--color-ink);
    text-decoration: none;
  }

  @media (max-width: 1100px) {
    .right-sidebar {
      display: none;
    }
  }
</style>
