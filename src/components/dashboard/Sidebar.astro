---
/**
 * Reusable sidebar component for authenticated dashboard pages.
 * Accepts `activePage` prop to highlight the correct nav link.
 */
interface Props {
  activePage?: 'home' | 'library' | 'profile' | 'stories' | 'stats';
}

const { activePage = 'home' } = Astro.props;
---

<aside class="sidebar" id="sidebar">
  <nav class="sidebar-nav" aria-label="Dashboard navigation">
    <ul class="sidebar-links">
      <li>
        <a
          href="/dashboard"
          class:list={['sidebar-link', { 'sidebar-link--active': activePage === 'home' }]}
          data-nav="home"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span>Home</span>
        </a>
      </li>
      <li>
        <a
          href="/library"
          class:list={['sidebar-link', { 'sidebar-link--active': activePage === 'library' }]}
          data-nav="library"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
          <span>Library</span>
        </a>
      </li>
      <li>
        <a
          href="#"
          class:list={['sidebar-link', { 'sidebar-link--active': activePage === 'profile' }]}
          data-nav="profile"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span>Profile</span>
        </a>
      </li>
      <li>
        <a
          href="#"
          class:list={['sidebar-link', { 'sidebar-link--active': activePage === 'stories' }]}
          data-nav="stories"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
          <span>Stories</span>
        </a>
      </li>
      <li>
        <a
          href="#"
          class:list={['sidebar-link', { 'sidebar-link--active': activePage === 'stats' }]}
          data-nav="stats"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="20" x2="18" y2="10"></line>
            <line x1="12" y1="20" x2="12" y2="4"></line>
            <line x1="6" y1="20" x2="6" y2="14"></line>
          </svg>
          <span>Stats</span>
        </a>
      </li>
    </ul>
  </nav>

  <div class="sidebar-divider"></div>

  <!-- Following section -->
  <div class="sidebar-section">
    <div class="sidebar-section-header">
      <span class="sidebar-section-title">Following</span>
      <button class="sidebar-section-gear" aria-label="Manage following">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="3"></circle>
          <path
            d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
          ></path>
        </svg>
      </button>
    </div>

    <div class="sidebar-sub-section">
      <p class="sidebar-sub-title">Topics</p>
      <ul class="sidebar-topic-list">
        <li>
          <a href="#" class="sidebar-topic-link">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"
              ></line></svg
            >
            Technology
          </a>
        </li>
        <li>
          <a href="#" class="sidebar-topic-link">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"
              ></line></svg
            >
            Marketing
          </a>
        </li>
        <li>
          <a href="#" class="sidebar-topic-link">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"
              ></line></svg
            >
            Data Science
          </a>
        </li>
      </ul>
    </div>

    <div class="sidebar-sub-section">
      <p class="sidebar-sub-title">Writers and publications</p>
      <ul class="sidebar-topic-list">
        <li>
          <a href="#" class="sidebar-topic-link">
            <span class="sidebar-pub-avatar">Bb</span>
            BigBlog Staff
            <span class="sidebar-pub-dot"></span>
          </a>
        </li>
      </ul>
    </div>

    <div class="sidebar-sub-section" style="margin-top: var(--space-lg);">
      <a href="#" class="sidebar-topic-link" style="color: var(--color-primary);">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"
          ></line></svg
        >
        Find topics, writers and publications to follow.
      </a>
      <a href="#" class="sidebar-see-suggestions">See suggestions</a>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: var(--header-height);
    height: calc(100vh - var(--header-height));
    overflow-y: auto;
    padding: var(--space-lg) var(--space-lg) var(--space-lg) var(--space-md);
    border-right: 1px solid var(--color-hairline);
  }

  .sidebar::-webkit-scrollbar {
    width: 0;
  }

  .sidebar-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: 10px 12px;
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-body);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: all var(--duration-fast) var(--ease-default);
    font-weight: 400;
  }

  .sidebar-link:hover {
    background: var(--bg-surface-soft);
    color: var(--color-ink);
    text-decoration: none;
  }

  .sidebar-link--active {
    color: var(--color-ink);
    font-weight: 500;
  }

  .sidebar-link svg {
    flex-shrink: 0;
    opacity: 0.7;
  }

  .sidebar-link--active svg {
    opacity: 1;
  }

  .sidebar-divider {
    height: 1px;
    background: var(--color-hairline);
    margin: var(--space-lg) 0;
  }

  .sidebar-section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 12px;
    margin-bottom: var(--space-sm);
  }

  .sidebar-section-title {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: var(--color-ink);
  }

  .sidebar-section-gear {
    background: none;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    padding: 4px;
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast);
  }

  .sidebar-section-gear:hover {
    color: var(--color-ink);
  }

  .sidebar-sub-section {
    margin-top: var(--space-md);
    padding: 0 12px;
  }

  .sidebar-sub-title {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
    text-transform: none;
    margin-bottom: var(--space-xs);
    font-weight: 400;
  }

  .sidebar-topic-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar-topic-link {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 6px 0;
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-body);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .sidebar-topic-link:hover {
    color: var(--color-ink);
    text-decoration: none;
  }

  .sidebar-topic-link svg {
    opacity: 0.4;
    flex-shrink: 0;
  }

  .sidebar-pub-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 4px;
    background: var(--color-ink);
    color: white;
    font-family: var(--font-sans);
    font-size: 0.55rem;
    font-weight: 600;
    flex-shrink: 0;
  }

  .sidebar-pub-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-success);
    flex-shrink: 0;
    margin-left: auto;
  }

  .sidebar-see-suggestions {
    display: inline-block;
    margin-top: 4px;
    padding-left: 24px;
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-primary);
    text-decoration: none;
  }

  .sidebar-see-suggestions:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .sidebar {
      display: none;
    }
  }
</style>
