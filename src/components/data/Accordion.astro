---
import type { ComponentProps } from 'astro/types';
import Icon from '../ui/Icon.astro';
import Surface from '../layout/Surface.astro';

interface AccordionItem {
  title: string;
  content: string;
}

interface AccordionProps {
  items: AccordionItem[];
  multiple?: boolean;
  defaultOpen?: number[];
}

const { items, multiple = false, defaultOpen = [] } = Astro.props as AccordionProps;
---

<div class="accordion" role="region" aria-label="Accordion" data-multiple={multiple}>
  {
    items.map((item, index) => (
      <details class="accordion__item" open={defaultOpen.includes(index)} data-accordion-item>
        <summary class="accordion__summary">
          <Surface elevation={0} rounded="md" bg="secondary" padding="sm">
            <span class="accordion__title">{item.title}</span>
            <Icon name="ChevronDown" size="sm" class="accordion__chevron" aria-hidden="true" />
          </Surface>
        </summary>
        <div class="accordion__content">
          <Surface elevation={0} rounded="md" bg="primary" padding="md">
            <p>{item.content}</p>
          </Surface>
        </div>
      </details>
    ))
  }
</div>

<script>
  const accordion = document.currentScript?.parentElement;
  if (!accordion) return;

  const details = accordion.querySelectorAll<HTMLDetailsElement>('[data-accordion-item]');
  const multiple = accordion.dataset.multiple === 'true';

  details.forEach((detail) => {
    detail.addEventListener('toggle', () => {
      if (!multiple && detail.open) {
        details.forEach((other) => {
          if (other !== detail) {
            other.open = false;
          }
        });
      }
    });
  });
</script>

<style>
  .accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .accordion__item {
    border: none;
    padding: 0;
    margin: 0;
  }

  .accordion__summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
  }

  .accordion__summary::-webkit-details-marker {
    display: none;
  }

  .accordion__summary {
    display: flex;
    align-items: center;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-sans);
    font-size: inherit;
    color: inherit;
  }

  .accordion__title {
    flex: 1;
    font-weight: var(--weight-semibold);
    font-size: var(--text-base);
    color: var(--text-primary);
  }

  .accordion__chevron {
    transition: transform var(--duration-normal) var(--ease-default);
    flex-shrink: 0;
    margin-left: var(--space-2);
  }

  .accordion__item[open] .accordion__chevron {
    transform: rotate(180deg);
  }

  .accordion__content {
    padding-top: var(--space-3);
    padding-left: var(--space-4);
  }

  .accordion__content p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-body);
  }

  .accordion__summary:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-md);
  }

  .accordion__item[open] .accordion__summary {
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion__chevron {
      transition: none;
    }
  }
</style>
