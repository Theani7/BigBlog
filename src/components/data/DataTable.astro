---
import type { ComponentProps } from 'astro/types';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';

interface Column {
  key: string;
  label: string;
  sortable?: boolean;
}

interface DataTableProps {
  columns: Column[];
  rows: Record<string, unknown>[];
  sortable?: boolean;
  pagination?: boolean;
  pageSize?: number;
}

const {
  columns,
  rows,
  sortable = false,
  pagination = false,
  pageSize = 10,
} = Astro.props as DataTableProps;
---

<div
  class="data-table-container"
  data-rows={JSON.stringify(rows)}
  data-page-size={pageSize}
  data-columns={JSON.stringify(columns.map((c) => ({ key: c.key, sortable: c.sortable })))}
>
  <div class="table-wrapper" role="region" aria-label="Data table" tabindex="0">
    <table class="data-table">
      <thead>
        <tr>
          {
            columns.map((col) => (
              <th
                scope="col"
                data-sort-key={col.key}
                data-sortable={col.sortable ? 'true' : undefined}
              >
                {col.label}
                {sortable && col.sortable && (
                  <span class="sort-indicator" aria-hidden="true">
                    <Icon name="ChevronUp" size="xs" />
                    <Icon name="ChevronDown" size="xs" />
                  </span>
                )}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              {columns.map((col) => (
                <td>{row[col.key] as string}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {
    pagination && rows.length > pageSize && (
      <nav class="pagination" aria-label="Table pagination">
        <Button variant="ghost" size="sm" data-prev aria-label="Previous page">
          <Icon name="ChevronLeft" size="sm" />
          Previous
        </Button>
        <span class="page-indicator" data-page-indicator aria-live="polite">
          Page 1 of {Math.ceil(rows.length / pageSize)}
        </span>
        <Button variant="ghost" size="sm" data-next aria-label="Next page">
          Next
          <Icon name="ChevronRight" size="sm" />
        </Button>
      </nav>
    )
  }
</div>

<script>
  const container = document.currentScript?.parentElement;
  if (!container) return;

  const rowsData = JSON.parse(container.dataset.rows || '[]');
  const pageSize = parseInt(container.dataset.pageSize || '10', 10);
  const columnsData = JSON.parse(container.dataset.columns || '[]');
  const tbody = container.querySelector('tbody');
  const headers = container.querySelectorAll('th[data-sortable]');
  const prevBtn = container.querySelector('[data-prev]');
  const nextBtn = container.querySelector('[data-next]');
  const pageIndicator = container.querySelector('[data-page-indicator]');

  let currentPage = 0;
  let sortColumn: string | null = null;
  let sortDirection: 'asc' | 'desc' = 'asc';

  function getCellValue(row: Record<string, unknown>, key: string): unknown {
    return row[key];
  }

  function compareValues(a: unknown, b: unknown): number {
    if (typeof a === 'number' && typeof b === 'number') return a - b;
    return String(a).localeCompare(String(b));
  }

  function renderRows() {
    if (!tbody) return;
    const start = currentPage * pageSize;
    const end = start + pageSize;
    const pageRows = rowsData.slice(start, end);

    tbody.innerHTML = pageRows
      .map((row) => {
        const cells = columnsData
          .map((col: { key: string }) => `<td>${row[col.key] as string}</td>`)
          .join('');
        return `<tr>${cells}</tr>`;
      })
      .join('');

    if (pageIndicator) {
      pageIndicator.textContent = `Page ${currentPage + 1} of ${Math.ceil(rowsData.length / pageSize)}`;
    }

    if (prevBtn) prevBtn.disabled = currentPage === 0;
    if (nextBtn) nextBtn.disabled = currentPage >= Math.ceil(rowsData.length / pageSize) - 1;
  }

  function sortData(key: string) {
    if (sortColumn === key) {
      sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
    } else {
      sortColumn = key;
      sortDirection = 'asc';
    }

    rowsData.sort((a: Record<string, unknown>, b: Record<string, unknown>) => {
      const valA = getCellValue(a, key);
      const valB = getCellValue(b, key);
      const result = compareValues(valA, valB);
      return sortDirection === 'asc' ? result : -result;
    });

    currentPage = 0;
    renderRows();
    updateSortIndicators(key);
  }

  function updateSortIndicators(activeKey: string) {
    headers.forEach((header) => {
      const key = header.dataset.sortKey;
      const indicator = header.querySelector('.sort-indicator');
      if (!indicator) return;
      indicator.style.opacity = key === activeKey ? '1' : '0.3';
    });
  }

  headers.forEach((header) => {
    header.addEventListener('click', () => {
      const key = header.dataset.sortKey;
      if (!key) return;
      sortData(key);
    });

    header.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const key = header.dataset.sortKey;
        if (key) sortData(key);
      }
    });
  });

  prevBtn?.addEventListener('click', () => {
    if (currentPage > 0) {
      currentPage--;
      renderRows();
    }
  });

  nextBtn?.addEventListener('click', () => {
    if (currentPage < Math.ceil(rowsData.length / pageSize) - 1) {
      currentPage++;
      renderRows();
    }
  });

  renderRows();
</script>

<style>
  .data-table-container {
    width: 100%;
  }

  .table-wrapper {
    overflow-x: auto;
    margin: var(--space-6) 0;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .data-table th,
  .data-table td {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    border-bottom: 1px solid var(--border-color);
  }

  .data-table th {
    font-weight: var(--weight-semibold);
    background: var(--bg-tertiary);
    position: sticky;
    top: 0;
    white-space: nowrap;
  }

  .data-table th[data-sortable] {
    cursor: pointer;
    user-select: none;
  }

  .data-table th[data-sortable]:hover {
    background: var(--bg-secondary);
  }

  .data-table tr:hover {
    background: var(--bg-secondary);
  }

  .sort-indicator {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: var(--space-2);
    opacity: 0.3;
    transition: opacity var(--duration-fast) var(--ease-default);
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
  }

  .page-indicator {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    font-weight: var(--weight-medium);
  }

  .data-table:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .data-table th:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .sort-indicator {
      transition: none;
    }

    .data-table tr {
      transition: none;
    }
  }
</style>
