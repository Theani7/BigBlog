---
import type { ComponentProps } from 'astro/types';
import Icon from '../ui/Icon.astro';
import Divider from '../layout/Divider.astro';

interface TimelineItem {
  date: string;
  title: string;
  description: string;
  active?: boolean;
}

interface TimelineProps {
  items: TimelineItem[];
}

const { items } = Astro.props as TimelineProps;
---

<ol class="timeline" aria-label="Timeline">
  {
    items.map((item, index) => (
      <li class="timeline__item" class:list={[{ 'timeline__item--active': item.active }]}>
        <div class="timeline__dot" aria-hidden="true">
          <Icon
            name="Circle"
            size="xs"
            color={item.active ? 'var(--color-primary)' : 'var(--text-tertiary)'}
          />
        </div>
        <div class="timeline__content">
          <time class="timeline__date" datetime={item.date}>
            {item.date}
          </time>
          <h3 class="timeline__title">{item.title}</h3>
          <p class="timeline__description">{item.description}</p>
        </div>
        {index < items.length - 1 && (
          <Divider
            orientation="vertical"
            thin
            color={item.active ? 'primary' : 'default'}
            class="timeline__line"
          />
        )}
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .timeline__item {
    display: flex;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
  }

  .timeline__item:last-child {
    padding-bottom: 0;
  }

  .timeline__dot {
    display: flex;
    align-items: flex-start;
    padding-top: var(--space-1);
    flex-shrink: 0;
  }

  .timeline__content {
    flex: 1;
    min-width: 0;
  }

  .timeline__date {
    display: block;
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    font-weight: var(--weight-medium);
    margin-bottom: var(--space-1);
  }

  .timeline__title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-h5);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
  }

  .timeline__description {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-body);
  }

  .timeline__item--active .timeline__title {
    color: var(--color-primary);
  }

  .timeline__item--active .timeline__description {
    color: var(--text-primary);
  }

  .timeline__line {
    flex-shrink: 0;
  }

  .timeline:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline__item {
      transition: none;
    }
  }
</style>
