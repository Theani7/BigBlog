---
// FollowsModal.astro - Followers & Following modal
// Props: authorId (target author ID for fetching the list)
import X from 'lucide-astro/X';
import Users from 'lucide-astro/Users';

interface Props {
  authorId: string;
}
const { authorId } = Astro.props;
---

<!-- Follows Modal Overlay -->
<div
  id="follows-modal-overlay"
  class="follows-modal-overlay"
  hidden
  aria-modal="true"
  role="dialog"
  aria-labelledby="follows-modal-title"
>
  <div class="follows-modal-panel" id="follows-modal-panel">
    <div class="follows-modal-handle" aria-hidden="true"></div>

    <!-- Header -->
    <div class="follows-modal-header">
      <h2 class="follows-modal-title" id="follows-modal-title">Followers</h2>
      <button type="button" class="follows-modal-close" id="follows-modal-close" aria-label="Close">
        <X size={20} />
      </button>
    </div>

    <!-- Tabs -->
    <div class="follows-tabs" role="tablist">
      <button
        type="button"
        class="follows-tab active"
        id="follows-tab-followers"
        data-follows-tab="followers"
        role="tab"
        aria-selected="true"
      >
        Followers
      </button>
      <button
        type="button"
        class="follows-tab"
        id="follows-tab-following"
        data-follows-tab="following"
        role="tab"
        aria-selected="false"
      >
        Following
      </button>
    </div>

    <!-- List Container -->
    <div class="follows-list-container" id="follows-list-container">
      <div class="follows-skeleton-list" id="follows-spinner" aria-hidden="true">
        <div class="follows-skeleton-row">
          <span class="follows-skeleton-avatar"></span>
          <span class="follows-skeleton-lines">
            <span class="follows-skeleton-line follows-skeleton-line--name"></span>
            <span class="follows-skeleton-line follows-skeleton-line--bio"></span>
          </span>
          <span class="follows-skeleton-btn"></span>
        </div>
        <div class="follows-skeleton-row">
          <span class="follows-skeleton-avatar"></span>
          <span class="follows-skeleton-lines">
            <span class="follows-skeleton-line follows-skeleton-line--name"></span>
            <span class="follows-skeleton-line follows-skeleton-line--bio"></span>
          </span>
          <span class="follows-skeleton-btn"></span>
        </div>
        <div class="follows-skeleton-row">
          <span class="follows-skeleton-avatar"></span>
          <span class="follows-skeleton-lines">
            <span class="follows-skeleton-line follows-skeleton-line--name"></span>
            <span class="follows-skeleton-line follows-skeleton-line--bio"></span>
          </span>
          <span class="follows-skeleton-btn"></span>
        </div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ authorId }}>
  (function () {
    var currentTab = 'followers';
    var overlay = document.getElementById('follows-modal-overlay');
    var closeBtn = document.getElementById('follows-modal-close');
    var listContainer = document.getElementById('follows-list-container');
    var spinner = document.getElementById('follows-spinner');
    var titleEl = document.getElementById('follows-modal-title');
    var tabBtns = document.querySelectorAll('.follows-tab');

    function getInitials(name) {
      if (!name) return 'A';
      var parts = name.trim().split(/\s+/);
      if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
      return (parts[0][0] + (parts[1] ? parts[1][0] : '')).toUpperCase();
    }

    function updateTitle(type) {
      if (titleEl) titleEl.textContent = type === 'followers' ? 'Followers' : 'Following';
    }

    function renderEmpty(type) {
      return (
        '<div class="follows-empty-state">' +
        '<div class="follows-empty-icon"><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></div>' +
        '<p class="follows-empty-title">' +
        (type === 'followers' ? 'No followers yet' : 'Not following anyone yet') +
        '</p>' +
        '<p class="follows-empty-sub">' +
        (type === 'followers'
          ? 'Be the first to follow this author.'
          : 'Follow authors to see their content here.') +
        '</p>' +
        '</div>'
      );
    }

    function renderAuthorItem(author) {
      var avatarHtml = author.avatar
        ? '<img src="' +
          author.avatar +
          '" alt="' +
          author.name +
          '" class="follows-author-avatar" />'
        : '<div class="follows-author-avatar-fallback">' + getInitials(author.name) + '</div>';

      var bioHtml = author.bio
        ? '<p class="follows-author-bio">' +
          author.bio.slice(0, 80) +
          (author.bio.length > 80 ? '…' : '') +
          '</p>'
        : '';

      var followLabel = author.isFollowing ? 'Following' : 'Follow';
      var followClass = author.isFollowing
        ? 'follows-author-follow-btn is-following'
        : 'follows-author-follow-btn';

      return (
        '<div class="follows-author-item" data-author-id="' +
        author.id +
        '">' +
        '<a href="/author/' +
        author.id +
        '" class="follows-author-left">' +
        avatarHtml +
        '<div class="follows-author-info">' +
        '<span class="follows-author-name">' +
        author.name +
        '</span>' +
        bioHtml +
        '</div>' +
        '</a>' +
        '<button class="' +
        followClass +
        '" data-author-id="' +
        author.id +
        '" data-following="' +
        author.isFollowing +
        '">' +
        followLabel +
        '</button>' +
        '</div>'
      );
    }

    function showSkeleton() {
      if (!listContainer) return;
      listContainer.innerHTML =
        '<div class="follows-skeleton-list"><div class="follows-skeleton-row"><span class="follows-skeleton-avatar"></span><span class="follows-skeleton-lines"><span class="follows-skeleton-line follows-skeleton-line--name"></span><span class="follows-skeleton-line follows-skeleton-line--bio"></span></span><span class="follows-skeleton-btn"></span></div><div class="follows-skeleton-row"><span class="follows-skeleton-avatar"></span><span class="follows-skeleton-lines"><span class="follows-skeleton-line follows-skeleton-line--name"></span><span class="follows-skeleton-line follows-skeleton-line--bio"></span></span><span class="follows-skeleton-btn"></span></div><div class="follows-skeleton-row"><span class="follows-skeleton-avatar"></span><span class="follows-skeleton-lines"><span class="follows-skeleton-line follows-skeleton-line--name"></span><span class="follows-skeleton-line follows-skeleton-line--bio"></span></span><span class="follows-skeleton-btn"></span></div></div>';
    }

    function loadList(type) {
      if (!listContainer) return;
      showSkeleton();

      fetch('/api/follows/list?authorId=' + authorId + '&type=' + type)
        .then(function (res) {
          return res.json();
        })
        .then(function (data) {
          if (!data.success || !data.data || data.data.length === 0) {
            listContainer.innerHTML = renderEmpty(type);
            return;
          }
          var html = data.data.map(renderAuthorItem).join('');
          listContainer.innerHTML = '<div class="follows-author-list">' + html + '</div>';

          // Wire follow toggle buttons
          listContainer.querySelectorAll('.follows-author-follow-btn').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
              e.preventDefault();
              var targetId = btn.dataset.authorId;
              var isFollowing = btn.dataset.following === 'true';
              fetch('/api/follows', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ authorId: targetId }),
              })
                .then(function (r) {
                  return r.json();
                })
                .then(function (result) {
                  if (result.success) {
                    var nowFollowing = result.action === 'follow';
                    btn.dataset.following = String(nowFollowing);
                    btn.textContent = nowFollowing ? 'Following' : 'Follow';
                    btn.classList.toggle('is-following', nowFollowing);
                  }
                })
                .catch(function (err) {
                  console.error('Follow toggle failed:', err);
                });
            });

            // Instagram-style hover: "Following" reveals "Unfollow"
            btn.addEventListener('mouseenter', function () {
              if (btn.dataset.following === 'true') {
                btn.dataset.originalLabel = btn.textContent;
                btn.textContent = 'Unfollow';
              }
            });
            btn.addEventListener('mouseleave', function () {
              if (btn.dataset.following === 'true' && btn.dataset.originalLabel) {
                btn.textContent = btn.dataset.originalLabel;
              }
            });
          });
        })
        .catch(function (err) {
          listContainer.innerHTML = '<p class="follows-error">Failed to load list.</p>';
          console.error(err);
        });
    }

    // Tab switching
    tabBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        tabBtns.forEach(function (b) {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        currentTab = btn.dataset.followsTab;
        updateTitle(currentTab);
        loadList(currentTab);
      });
    });

    // Close handlers
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        if (overlay) overlay.hidden = true;
      });
    }
    if (overlay) {
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) overlay.hidden = true;
      });
    }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay && !overlay.hidden) overlay.hidden = true;
    });

    // Expose open function globally so profile/author pages can trigger it
    window.openFollowsModal = function (type) {
      currentTab = type || 'followers';
      // Reset tabs
      tabBtns.forEach(function (b) {
        var isActive = b.dataset.followsTab === currentTab;
        b.classList.toggle('active', isActive);
        b.setAttribute('aria-selected', String(isActive));
      });
      updateTitle(currentTab);
      if (overlay) overlay.hidden = false;
      loadList(currentTab);
    };
  })();
</script>

<style>
  .follows-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(24, 23, 21, 0.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    animation: follows-overlay-in 0.2s ease;
  }

  .follows-modal-overlay[hidden] {
    display: none;
  }

  .follows-modal-panel {
    background: #ffffff;
    border: 1px solid var(--color-hairline, #e6dfd8);
    border-radius: 20px;
    box-shadow: 0 24px 80px rgba(24, 23, 21, 0.22);
    width: 100%;
    max-width: 400px;
    max-height: min(640px, 85dvh);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: follows-panel-in 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .follows-modal-handle {
    display: none;
  }

  .follows-modal-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 16px;
    border-bottom: 1px solid var(--color-hairline-soft, #ebe6df);
    flex-shrink: 0;
  }

  .follows-modal-title {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink, #181715);
    margin: 0;
  }

  .follows-modal-close {
    position: absolute;
    top: 50%;
    right: 10px;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    border-radius: 50%;
    color: var(--color-muted, #6c6a64);
    cursor: pointer;
    transition:
      background 0.15s,
      color 0.15s;
  }

  .follows-modal-close:hover {
    background: var(--bg-surface-soft, #f5f0e8);
    color: var(--color-ink, #181715);
  }

  .follows-tabs {
    display: flex;
    gap: 4px;
    margin: 14px 16px 6px;
    padding: 3px;
    background: var(--bg-surface-soft, #f5f0e8);
    border-radius: 11px;
    flex-shrink: 0;
  }

  .follows-tab {
    flex: 1;
    padding: 8px 12px;
    background: transparent;
    border: none;
    border-radius: 8px;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-muted, #6c6a64);
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s,
      box-shadow 0.2s;
    white-space: nowrap;
  }

  .follows-tab.active {
    background: #ffffff;
    color: var(--color-ink, #181715);
    box-shadow: 0 1px 3px rgba(24, 23, 21, 0.12);
  }

  .follows-list-container {
    flex: 1;
    overflow-y: auto;
    padding: 8px 0 12px;
    min-height: 220px;
    overscroll-behavior: contain;
  }

  .follows-author-list {
    display: flex;
    flex-direction: column;
  }

  .follows-author-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 20px;
    gap: 12px;
    transition: background 0.15s;
  }

  .follows-author-item:hover {
    background: var(--bg-surface-soft, #f5f0e8);
  }

  .follows-author-left {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }

  .follows-author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    background: var(--bg-surface-soft, #f5f0e8);
  }

  .follows-author-avatar-fallback {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bg-surface-soft, #f5f0e8);
    border: 1px solid var(--color-hairline, #e6dfd8);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink, #181715);
    flex-shrink: 0;
  }

  .follows-author-info {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .follows-author-name {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-ink, #181715);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .follows-author-bio {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.78rem;
    color: var(--color-muted, #6c6a64);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .follows-author-follow-btn {
    background: var(--color-primary, #181715);
    color: #ffffff;
    border: 1px solid var(--color-primary, #181715);
    border-radius: 8px;
    padding: 7px 18px;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background 0.18s,
      color 0.18s,
      border-color 0.18s;
    white-space: nowrap;
  }

  .follows-author-follow-btn:hover {
    background: var(--color-primary-active, #252320);
  }

  .follows-author-follow-btn.is-following {
    background: var(--bg-surface-soft, #f5f0e8);
    color: var(--color-ink, #181715);
    border: 1px solid var(--color-hairline, #e6dfd8);
  }

  .follows-author-follow-btn.is-following:hover {
    background: var(--bg-surface-soft, #f5f0e8);
    border-color: var(--color-hairline, #e6dfd8);
    color: var(--color-error, #c64545);
  }

  .follows-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 56px 24px;
    text-align: center;
  }

  .follows-empty-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--bg-surface-soft, #f5f0e8);
    color: var(--color-muted, #6c6a64);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .follows-empty-title {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink, #181715);
    margin: 0 0 6px;
  }

  .follows-empty-sub {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.82rem;
    color: var(--color-muted, #6c6a64);
    margin: 0;
    max-width: 26ch;
    line-height: 1.5;
  }

  .follows-skeleton-list {
    display: flex;
    flex-direction: column;
    padding: 4px 0;
  }

  .follows-skeleton-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px;
  }

  .follows-skeleton-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bg-surface-soft, #f5f0e8);
    flex-shrink: 0;
    animation: follows-shimmer 1.4s ease-in-out infinite;
  }

  .follows-skeleton-lines {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
  }

  .follows-skeleton-line {
    height: 10px;
    border-radius: 5px;
    background: var(--bg-surface-soft, #f5f0e8);
    animation: follows-shimmer 1.4s ease-in-out infinite;
  }

  .follows-skeleton-line--name {
    width: 55%;
  }

  .follows-skeleton-line--bio {
    width: 38%;
    height: 8px;
  }

  .follows-skeleton-btn {
    width: 72px;
    height: 32px;
    border-radius: 8px;
    background: var(--bg-surface-soft, #f5f0e8);
    flex-shrink: 0;
    animation: follows-shimmer 1.4s ease-in-out infinite;
  }

  @keyframes follows-shimmer {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }

  .follows-error {
    text-align: center;
    color: var(--color-error, #c64545);
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.85rem;
    padding: 40px 24px;
  }

  /* Mobile: Instagram-style bottom sheet */
  @media (max-width: 640px) {
    .follows-modal-overlay {
      align-items: flex-end;
      padding: 0;
    }

    .follows-modal-panel {
      max-width: 100%;
      max-height: 88dvh;
      border-radius: 20px 20px 0 0;
      border: none;
      animation: follows-sheet-in 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .follows-modal-handle {
      display: block;
      width: 36px;
      height: 4px;
      border-radius: 2px;
      background: var(--color-hairline, #e6dfd8);
      margin: 10px auto 2px;
      flex-shrink: 0;
    }

    .follows-modal-header {
      min-height: 48px;
    }
  }

  @keyframes follows-overlay-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes follows-panel-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes follows-sheet-in {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .follows-modal-overlay,
    .follows-modal-panel,
    .follows-skeleton-avatar,
    .follows-skeleton-line,
    .follows-skeleton-btn {
      animation: none;
    }
  }
</style>
