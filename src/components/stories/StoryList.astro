---
interface Story {
  title: string;
  excerpt?: string;
  meta1: string; // e.g. "Last edited X days ago" or "Published Jul 28"
  meta2?: string; // e.g. word count or read time
}

interface Props {
  stories: Story[];
  emptyText: string;
}

const { stories, emptyText } = Astro.props;
---

{
  stories.length > 0 ? (
    <div class="story-list">
      {stories.map((story) => (
        <article class="story-card">
          <div class="story-content">
            <h2 class="story-title">
              <a href="#">{story.title}</a>
            </h2>
            {story.excerpt && <p class="story-excerpt">{story.excerpt}</p>}
            <div class="story-meta">
              <span class="meta-item">{story.meta1}</span>
              {story.meta2 && (
                <>
                  <span class="meta-divider">·</span>
                  <span class="meta-item">{story.meta2}</span>
                </>
              )}
            </div>
          </div>
          <button class="story-options" aria-label="Story options">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
        </article>
      ))}
    </div>
  ) : (
    <div class="stories-empty-state">
      <p class="empty-text">{emptyText}</p>
      <p class="empty-subtext">
        Why not{' '}
        <a href="/write" class="empty-link">
          start writing one?
        </a>
      </p>
    </div>
  )
}

<style>
  .story-list {
    display: flex;
    flex-direction: column;
  }

  .story-card {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--color-hairline);
    transition: transform var(--duration-fast);
  }

  .story-card:hover {
    transform: translateX(4px);
  }

  .story-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    max-width: 80%;
  }

  .story-title {
    font-family: var(--font-sans);
    font-size: var(--text-title-md);
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
  }

  .story-title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .story-title a:hover {
    text-decoration: underline;
  }

  .story-excerpt {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .story-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
  }

  .story-options {
    background: none;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    padding: 8px;
    border-radius: 50%;
    transition: all var(--duration-fast);
  }

  .story-options:hover {
    color: var(--color-ink);
    background: var(--bg-surface-soft);
  }

  .stories-empty-state {
    text-align: center;
    font-family: var(--font-sans);
    margin-top: var(--space-32);
  }

  .empty-text {
    font-size: var(--text-body-lg);
    color: var(--color-ink);
    margin: 0 0 var(--space-xs) 0;
    font-weight: 500;
  }

  .empty-subtext {
    font-size: var(--text-body-lg);
    color: var(--color-ink);
    margin: 0;
  }

  .empty-link {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color var(--duration-fast);
  }

  .empty-link:hover {
    color: var(--color-primary);
    text-decoration-color: var(--color-primary);
  }
</style>
