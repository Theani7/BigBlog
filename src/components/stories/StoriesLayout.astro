---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../dashboard/Sidebar.astro';

interface Props {
  activeTab?: 'drafts' | 'scheduled' | 'published' | 'unlisted' | 'submissions';
  counts?: Record<string, number>;
}

const { activeTab = 'drafts', counts = {} } = Astro.props;

const tabs = [
  { id: 'drafts', label: 'Drafts', href: '/stories' },
  { id: 'scheduled', label: 'Scheduled', href: '/stories/scheduled' },
  { id: 'published', label: 'Published', href: '/stories/published' },
  { id: 'unlisted', label: 'Unlisted', href: '/stories/unlisted' },
];
---

<Layout title="Stories - BigBlog">
  <div class="stories-layout">
    <!-- Left Sidebar -->
    <Sidebar activePage="stories" />

    <!-- Center Content -->
    <main class="stories-feed">
      <div class="stories-header">
        <h1 class="stories-title">Stories</h1>
        <div class="stories-actions">
          <button class="btn-import">Import a story</button>
          <a href="/write" class="btn-write">Write a story</a>
        </div>
      </div>

      <nav class="stories-tabs">
        {
          tabs.map((tab) => (
            <a
              href={tab.href}
              class:list={['stories-tab', { 'stories-tab--active': activeTab === tab.id }]}
            >
              {tab.label}
              {counts[tab.id] !== undefined && <span class="tab-badge">{counts[tab.id]}</span>}
            </a>
          ))
        }
        <div class="stories-tab-divider"></div>
        <a
          href="/stories/submissions"
          class:list={['stories-tab', { 'stories-tab--active': activeTab === 'submissions' }]}
        >
          Submissions
          {
            counts['submissions'] !== undefined && (
              <span class="tab-badge">{counts['submissions']}</span>
            )
          }
        </a>
      </nav>

      <div class="stories-content">
        <slot />
      </div>
    </main>
  </div>
</Layout>

<style>
  .stories-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: calc(100vh - var(--header-height));
    max-width: 100%;
    margin: 0 auto;
    background-color: var(--bg-canvas);
  }

  .stories-feed {
    padding: clamp(1.5rem, 5vw, 4rem);
    max-width: 1040px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .stories-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2xl);
  }

  .stories-title {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 500;
    color: var(--color-ink);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .stories-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .btn-import {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: var(--color-ink);
    background: transparent;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    padding: 0.5rem 1rem;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-import:hover {
    background: var(--bg-surface-soft);
    border-color: var(--color-muted);
    transform: translateY(-1px);
  }

  .btn-write {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: #fff;
    background: #181715;
    border: 1px solid #181715;
    border-radius: var(--radius-pill);
    padding: 0.5rem 1.25rem;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  .btn-write:hover {
    background: #2a2927;
    border-color: #2a2927;
    transform: translateY(-2px);
    box-shadow:
      0 10px 15px -3px rgba(0, 0, 0, 0.1),
      0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }

  .stories-tabs {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: var(--space-sm);
  }

  .stories-tab {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-muted);
    text-decoration: none;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-pill);
    position: relative;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .stories-tab:hover {
    color: var(--color-ink);
    background: var(--bg-surface-soft);
  }

  .stories-tab--active {
    color: var(--color-ink);
    font-weight: 500;
    background: var(--bg-surface-soft);
  }

  .stories-tab--active::after {
    content: '';
    position: absolute;
    bottom: calc(var(--space-sm) * -1 - 1px);
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-ink);
    border-radius: 2px 2px 0 0;
  }

  .tab-badge {
    background: var(--bg-surface-hover, #e5e7eb);
    color: var(--color-ink);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-pill);
    min-width: 1.25rem;
    text-align: center;
  }

  .stories-tab--active .tab-badge {
    background: var(--color-ink);
    color: var(--bg-canvas);
  }

  .stories-tab-divider {
    height: 20px;
    width: 1px;
    background: var(--color-hairline);
    margin: 0 var(--space-sm);
  }

  .stories-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-top: var(--space-2xl);
  }

  @media (max-width: 1024px) {
    .stories-feed {
      padding: clamp(1.5rem, 5vw, 3rem);
    }
  }

  @media (max-width: 768px) {
    .stories-layout {
      grid-template-columns: 1fr;
    }
    .stories-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-lg);
    }
    .stories-tabs {
      overflow-x: auto;
      white-space: nowrap;
      padding-bottom: var(--space-sm);
    }
    .stories-tab-divider {
      display: none;
    }
  }
</style>
