---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../dashboard/Sidebar.astro';

interface Props {
  activeTab?: 'drafts' | 'scheduled' | 'published' | 'unlisted' | 'submissions';
  counts?: Record<string, number>;
}

const { activeTab = 'drafts', counts = {} } = Astro.props;

const tabs = [
  { id: 'drafts', label: 'Drafts', href: '/stories' },
  { id: 'scheduled', label: 'Scheduled', href: '/stories/scheduled' },
  { id: 'published', label: 'Published', href: '/stories/published' },
  { id: 'unlisted', label: 'Unlisted', href: '/stories/unlisted' },
];
---

<Layout title="Stories - BigBlog">
  <div class="stories-layout">
    <!-- Left Sidebar -->
    <Sidebar activePage="stories" />

    <!-- Center Content -->
    <main class="stories-feed">
      <div class="stories-header">
        <h1 class="stories-title">Stories</h1>
        <div class="stories-actions">
          <button class="btn-import">Import a story</button>
          <a href="/write" class="btn-write">Write a story</a>
        </div>
      </div>

      <nav class="stories-tabs">
        {
          tabs.map((tab) => (
            <a
              href={tab.href}
              class:list={['stories-tab', { 'stories-tab--active': activeTab === tab.id }]}
            >
              {tab.label}
              {counts[tab.id] !== undefined && <span class="tab-badge">{counts[tab.id]}</span>}
            </a>
          ))
        }
        <div class="stories-tab-divider"></div>
        <a
          href="/stories/submissions"
          class:list={['stories-tab', { 'stories-tab--active': activeTab === 'submissions' }]}
        >
          Submissions
          {
            counts['submissions'] !== undefined && (
              <span class="tab-badge">{counts['submissions']}</span>
            )
          }
        </a>
      </nav>

      <div class="stories-content">
        <slot />
      </div>
    </main>
  </div>
</Layout>

<style>
  .stories-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: calc(100vh - var(--header-height));
    max-width: 100%;
    margin: 0 auto;
    background-color: #faf9f5;
  }

  .stories-feed {
    padding: clamp(24px, 5vw, 64px);
    max-width: 1040px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .stories-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 48px;
  }

  .stories-title {
    font-family: 'Copernicus', 'Tiempos Headline', serif;
    font-size: 48px;
    font-weight: 400;
    color: #141413;
    margin: 0;
    letter-spacing: -1px;
    line-height: 1.1;
  }

  .stories-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .btn-import {
    font-family: 'StyreneB', 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #141413;
    background: #faf9f5;
    border: 1px solid #e6dfd8;
    border-radius: 8px;
    padding: 0 20px;
    height: 40px;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .btn-import:hover {
    background: #efe9de;
  }

  .btn-write {
    font-family: 'StyreneB', 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #ffffff;
    background: #181715;
    border: none;
    border-radius: 8px;
    padding: 0 20px;
    height: 40px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .btn-write:hover {
    background: #252320;
  }

  .stories-tabs {
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid #e6dfd8;
    padding-bottom: 12px;
  }

  .stories-tab {
    font-family: 'StyreneB', 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    color: #6c6a64;
    text-decoration: none;
    padding: 8px 14px;
    border-radius: 8px;
    position: relative;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 8px;
    background: transparent;
  }

  .stories-tab:hover {
    color: #141413;
    background: #f5f0e8;
  }

  .stories-tab--active {
    color: #141413;
    background: #efe9de;
  }

  .tab-badge {
    background: #efe9de;
    color: #141413;
    font-size: 12px;
    font-weight: 500;
    padding: 4px 12px;
    border-radius: 9999px;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }

  .stories-tab--active .tab-badge {
    background: #e8e0d2;
  }

  .stories-tab-divider {
    height: 20px;
    width: 1px;
    background: #e6dfd8;
    margin: 0 12px;
  }

  .stories-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-top: 48px;
  }

  @media (max-width: 1024px) {
    .stories-feed {
      padding: clamp(24px, 5vw, 48px);
    }
  }

  @media (max-width: 768px) {
    .stories-layout {
      grid-template-columns: 1fr;
    }
    .stories-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }
    .stories-tabs {
      overflow-x: auto;
      white-space: nowrap;
      padding-bottom: 12px;
    }
    .stories-tab-divider {
      display: none;
    }
  }
</style>
