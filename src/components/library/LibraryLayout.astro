---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../dashboard/Sidebar.astro';
import NewListModal from './NewListModal.astro';

interface Props {
  title: string;
  description: string;
  activeTab: 'your-lists' | 'saved-lists' | 'highlights' | 'reading-history' | 'responses';
}

const { title, description, activeTab } = Astro.props;

// Auth is verified server-side; no /api/auth/me round trip needed.
const user = (Astro.locals as { user?: { id: string; email: string; name?: string } }).user;
if (!user) {
  return Astro.redirect('/login?redirect=/library');
}
const libraryUserJson = JSON.stringify({
  name: user.name || user.email.split('@')[0] || '',
  email: user.email,
});
const libraryInitials = (user.name || user.email.split('@')[0] || '')
  .split(/\s+/)
  .map((n) => n[0])
  .join('')
  .toUpperCase()
  .slice(0, 2);
---

<Layout title={title} description={description}>
  <meta name="library-user" content={libraryUserJson} />
  <meta name="library-user-initials" content={libraryInitials} />
  <!-- Loading state -->
  <div class="library-loading" id="library-loading">
    <div class="loading-spinner"></div>
    <p class="loading-text">Loading your library...</p>
  </div>

  <!-- Main library container -->
  <div class="library-layout" id="library-main" style="display: none;">
    <!-- Left Sidebar -->
    <Sidebar activePage="library" />

    <!-- Library Content -->
    <main class="library-content">
      <!-- Header -->
      <div class="library-header">
        <h1 class="library-title">Your library</h1>
        <button class="new-list-btn" id="new-list-btn">New list</button>
      </div>

      <!-- Tabs -->
      <div class="library-tabs">
        <a
          href="/library"
          class:list={['library-tab', { 'library-tab--active': activeTab === 'your-lists' }]}
          >Your lists</a
        >
        <a
          href="/library/saved"
          class:list={['library-tab', { 'library-tab--active': activeTab === 'saved-lists' }]}
          >Saved lists</a
        >
        <a
          href="/library/highlights"
          class:list={['library-tab', { 'library-tab--active': activeTab === 'highlights' }]}
          >Highlights</a
        >
        <a
          href="/library/history"
          class:list={['library-tab', { 'library-tab--active': activeTab === 'reading-history' }]}
          >Reading history</a
        >
        <a
          href="/library/responses"
          class:list={['library-tab', { 'library-tab--active': activeTab === 'responses' }]}
          >Responses</a
        >
      </div>

      <!-- Main Slot for Tab Content -->
      <div class="library-tab-content">
        <slot />
      </div>

      <!-- New List Modal -->
      <NewListModal />
    </main>
  </div>
</Layout>

<script>
  function initLibrary() {
    const loading = document.getElementById('library-loading');
    const main = document.getElementById('library-main');

    // Auth is verified server-side; the meta tag carries display info.
    const userMeta = document.querySelector<HTMLMetaElement>('meta[name="library-user"]');
    const initialsMeta = document.querySelector<HTMLMetaElement>(
      'meta[name="library-user-initials"]'
    );
    let displayName = '';
    let initials = '';

    if (userMeta) {
      try {
        const parsed = JSON.parse(userMeta.content) as { name?: string; email?: string };
        displayName = parsed.name || (parsed.email || '').split('@')[0] || '';
        initials = displayName
          .split(/\s+/)
          .map((n) => n[0])
          .join('')
          .toUpperCase()
          .slice(0, 2);
      } catch {
        /* malformed meta */
      }
    }
    initials = initials || initialsMeta?.content || '?';

    if (loading) loading.style.display = 'none';
    if (main) main.style.display = 'grid';

    // Update user info for list cards if they exist
    document.querySelectorAll('.list-user-initials').forEach((el) => (el.textContent = initials));
    document.querySelectorAll('.list-user-name').forEach((el) => (el.textContent = displayName));

    const countEl = document.querySelector('.list-card-count');
    if (countEl) {
      fetch('/api/bookmarks')
        .then((res) => res.json())
        .then((data) => {
          if (data.success) {
            const n = data.data?.bookmarks?.length ?? 0;
            countEl.textContent = `${n} ${n === 1 ? 'story' : 'stories'}`;
          }
        })
        .catch(() => {});
    }
  }

  document.addEventListener('astro:page-load', () => {
    // Only run if we are on a library page (checking for the main container)
    if (document.getElementById('library-loading')) {
      initLibrary();
    }
  });
</script>

<style>
  /* Loading */
  .library-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--header-height));
    gap: var(--space-md);
  }

  .loading-spinner {
    width: 32px;
    height: 32px;
    border: 2px solid var(--color-hairline);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .loading-text {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-muted);
  }

  /* Layout */
  .library-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: calc(100vh - var(--header-height));
    max-width: 100%;
    margin: 0 auto;
  }

  .library-content {
    padding: var(--space-xl) clamp(1.5rem, 5vw, 4rem);
    width: 100%;
  }

  /* Header */
  .library-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-xl);
  }

  .library-title {
    font-family: var(--font-serif);
    font-size: 48px;
    font-weight: 400;
    color: var(--color-ink);
    margin: 0;
    letter-spacing: -1px;
    line-height: 1.1;
  }

  .new-list-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 500;
    padding: 10px 20px;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: #ffffff;
    border: none;
    cursor: pointer;
    transition:
      background var(--duration-fast),
      opacity var(--duration-fast),
      transform var(--duration-fast);
    white-space: nowrap;
  }

  .new-list-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .new-list-btn:active {
    background: #252320;
  }

  /* Tabs */
  .library-tabs {
    display: flex;
    gap: 0.5rem;
    border-bottom: 1px solid var(--color-hairline);
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-md);
    overflow-x: auto;
  }

  .library-tabs::-webkit-scrollbar {
    display: none;
  }

  .library-tab {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 400;
    color: var(--color-muted);
    text-decoration: none;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-pill);
    position: relative;
    transition:
      background var(--duration-fast),
      color var(--duration-fast);
    white-space: nowrap;
  }

  .library-tab:hover {
    color: var(--color-ink);
    background: var(--bg-surface-soft);
    text-decoration: none;
  }

  .library-tab--active {
    color: var(--color-ink);
    font-weight: 500;
    background: var(--bg-surface-soft);
  }

  .library-tab-content {
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .library-layout {
      grid-template-columns: 1fr;
    }
    .library-content {
      padding: var(--space-lg) var(--space-md);
    }
  }
</style>
