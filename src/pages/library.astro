---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/dashboard/Sidebar.astro';
---

<Layout
  title="Your Library — BigBlog"
  description="Your saved stories, reading lists, and highlights."
>
  <!-- Loading state -->
  <div class="library-loading" id="library-loading">
    <div class="loading-spinner"></div>
    <p class="loading-text">Loading your library...</p>
  </div>

  <!-- Main library container -->
  <div class="library-layout" id="library-main" style="display: none;">
    <!-- Left Sidebar -->
    <Sidebar activePage="library" />

    <!-- Library Content -->
    <main class="library-content">
      <!-- Header -->
      <div class="library-header">
        <h1 class="library-title">Your library</h1>
        <button class="new-list-btn" id="new-list-btn">New list</button>
      </div>

      <!-- Tabs -->
      <div class="library-tabs">
        <button class="library-tab library-tab--active" data-tab="your-lists">Your lists</button>
        <button class="library-tab" data-tab="saved-lists">Saved lists</button>
        <button class="library-tab" data-tab="highlights">Highlights</button>
        <button class="library-tab" data-tab="reading-history">Reading history</button>
        <button class="library-tab" data-tab="responses">Responses</button>
      </div>

      <!-- Tab Content Panels -->
      <div class="library-tab-content">
        <!-- YOUR LISTS tab -->
        <div class="tab-panel tab-panel--active" data-panel="your-lists">
          <!-- CTA Banner -->
          <div class="library-cta-banner" id="library-cta-banner">
            <button class="cta-close" id="cta-close-btn" aria-label="Dismiss banner">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"
                ></line></svg
              >
            </button>
            <div class="cta-text">
              <h2 class="cta-heading">Create a list to easily organize and share stories</h2>
              <button class="cta-action-btn" id="cta-start-list-btn">Start a list</button>
            </div>
            <div class="cta-icon">
              <svg
                width="48"
                height="48"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                <line x1="12" y1="8" x2="12" y2="14"></line>
                <line x1="9" y1="11" x2="15" y2="11"></line>
              </svg>
            </div>
          </div>

          <!-- Reading Lists -->
          <div class="lists-container" id="lists-container">
            <!-- Default Reading List -->
            <div class="list-card">
              <div class="list-card-info">
                <div class="list-card-author">
                  <div class="list-card-avatar" id="list-user-avatar">
                    <span id="list-user-initials">BB</span>
                  </div>
                  <span class="list-card-author-name" id="list-user-name">BigBlog User</span>
                </div>
                <h3 class="list-card-title">Reading list</h3>
                <div class="list-card-meta">
                  <span class="list-card-count">0 stories</span>
                  <span class="list-card-lock">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path
                        d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
                    >
                  </span>
                  <button class="list-card-more" aria-label="More options">
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      ><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"
                      ></circle><circle cx="5" cy="12" r="1"></circle></svg
                    >
                  </button>
                </div>
              </div>
              <div class="list-card-thumbnails">
                <div class="list-card-thumb list-card-thumb--placeholder">
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    opacity="0.3"
                    ><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg
                  >
                </div>
                <div class="list-card-thumb list-card-thumb--placeholder"></div>
                <div class="list-card-thumb list-card-thumb--placeholder"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- SAVED LISTS tab -->
        <div class="tab-panel" data-panel="saved-lists">
          <div class="empty-state">
            <svg
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="empty-state-icon"
            >
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
            </svg>
            <h3 class="empty-state-title">No saved lists yet</h3>
            <p class="empty-state-desc">Save lists from other writers to revisit them later.</p>
          </div>
        </div>

        <!-- HIGHLIGHTS tab -->
        <div class="tab-panel" data-panel="highlights">
          <div class="empty-state">
            <svg
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="empty-state-icon"
            >
              <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
              <path d="M2 17l10 5 10-5"></path>
              <path d="M2 12l10 5 10-5"></path>
            </svg>
            <h3 class="empty-state-title">No highlights yet</h3>
            <p class="empty-state-desc">Highlight passages as you read to save them here.</p>
          </div>
        </div>

        <!-- READING HISTORY tab -->
        <div class="tab-panel" data-panel="reading-history">
          <div class="empty-state">
            <svg
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="empty-state-icon"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <h3 class="empty-state-title">No reading history</h3>
            <p class="empty-state-desc">
              Articles you read will appear here so you can find them again.
            </p>
          </div>
        </div>

        <!-- RESPONSES tab -->
        <div class="tab-panel" data-panel="responses">
          <div class="empty-state">
            <svg
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="empty-state-icon"
            >
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <h3 class="empty-state-title">No responses yet</h3>
            <p class="empty-state-desc">Your responses to other stories will appear here.</p>
          </div>
        </div>
      </div>

      <!-- New List Modal -->
      <div class="new-list-modal-overlay" id="new-list-modal" aria-hidden="true">
        <div class="new-list-modal">
          <div class="new-list-modal-header">
            <h2 class="new-list-modal-title">Create new list</h2>
            <button class="new-list-modal-close" id="new-list-modal-close" aria-label="Close">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"
                ></line></svg
              >
            </button>
          </div>
          <form class="new-list-form" id="new-list-form">
            <div class="form-group">
              <label for="list-name-input">Name</label>
              <input
                type="text"
                id="list-name-input"
                placeholder="Give your list a name"
                required
                maxlength="60"
              />
              <span class="char-count"><span id="name-char-count">0</span>/60</span>
            </div>
            <div class="form-group">
              <label for="list-desc-input"
                >Description <span class="optional-label">(optional)</span></label
              >
              <textarea
                id="list-desc-input"
                placeholder="Add a description"
                rows="3"
                maxlength="280"></textarea>
            </div>
            <div class="form-group form-group--row">
              <label class="toggle-label">
                <span>Make it private</span>
                <button
                  type="button"
                  class="toggle-switch"
                  id="list-private-toggle"
                  aria-pressed="true"
                >
                  <span class="toggle-knob"></span>
                </button>
              </label>
            </div>
            <div class="new-list-actions">
              <button type="button" class="btn-cancel" id="new-list-cancel">Cancel</button>
              <button type="submit" class="btn-create">Create</button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
</Layout>

<script>
  // ═══════════════════════════════════════════════════════════════════
  // Auth check & user data
  // ═══════════════════════════════════════════════════════════════════
  interface LibraryUser {
    id: string;
    email: string;
    name?: string;
    role: 'ADMIN' | 'AUTHOR';
  }

  async function initLibrary() {
    const loading = document.getElementById('library-loading');
    const main = document.getElementById('library-main');

    try {
      const res = await fetch('/api/auth/me');
      const data = await res.json();

      if (!data.success || !data.user) {
        window.location.href = '/';
        return;
      }

      const user: LibraryUser = data.user;

      if (loading) loading.style.display = 'none';
      if (main) main.style.display = 'grid';

      // Update user info in reading list card
      const displayName = user.name || user.email.split('@')[0];
      const initials = displayName
        .split(' ')
        .map((n: string) => n[0])
        .join('')
        .toUpperCase()
        .slice(0, 2);

      const initialsEl = document.getElementById('list-user-initials');
      const nameEl = document.getElementById('list-user-name');
      if (initialsEl) initialsEl.textContent = initials;
      if (nameEl) nameEl.textContent = displayName;
    } catch (err) {
      console.error('Library auth check failed:', err);
      window.location.href = '/';
    }
  }

  // ═══════════════════════════════════════════════════════════════════
  // Tab switching
  // ═══════════════════════════════════════════════════════════════════
  document.querySelectorAll('.library-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      // Deactivate all tabs
      document
        .querySelectorAll('.library-tab')
        .forEach((t) => t.classList.remove('library-tab--active'));
      document
        .querySelectorAll('.tab-panel')
        .forEach((p) => p.classList.remove('tab-panel--active'));

      // Activate clicked
      tab.classList.add('library-tab--active');
      const targetPanel = tab.getAttribute('data-tab');
      const panel = document.querySelector(`[data-panel="${targetPanel}"]`);
      if (panel) panel.classList.add('tab-panel--active');
    });
  });

  // ═══════════════════════════════════════════════════════════════════
  // CTA Banner dismiss
  // ═══════════════════════════════════════════════════════════════════
  document.getElementById('cta-close-btn')?.addEventListener('click', () => {
    const banner = document.getElementById('library-cta-banner');
    if (banner) {
      banner.style.opacity = '0';
      banner.style.transform = 'translateY(-8px)';
      setTimeout(() => {
        banner.style.display = 'none';
      }, 300);
    }
  });

  // ═══════════════════════════════════════════════════════════════════
  // New List Modal
  // ═══════════════════════════════════════════════════════════════════
  const newListBtn = document.getElementById('new-list-btn');
  const ctaStartBtn = document.getElementById('cta-start-list-btn');
  const modal = document.getElementById('new-list-modal');
  const modalClose = document.getElementById('new-list-modal-close');
  const modalCancel = document.getElementById('new-list-cancel');
  const listForm = document.getElementById('new-list-form') as HTMLFormElement;
  const nameInput = document.getElementById('list-name-input') as HTMLInputElement;
  const charCount = document.getElementById('name-char-count');
  const privateToggle = document.getElementById('list-private-toggle');

  function openModal() {
    modal?.classList.add('is-open');
    modal?.setAttribute('aria-hidden', 'false');
    nameInput?.focus();
  }

  function closeModal() {
    modal?.classList.remove('is-open');
    modal?.setAttribute('aria-hidden', 'true');
    listForm?.reset();
    if (charCount) charCount.textContent = '0';
  }

  newListBtn?.addEventListener('click', openModal);
  ctaStartBtn?.addEventListener('click', openModal);
  modalClose?.addEventListener('click', closeModal);
  modalCancel?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  nameInput?.addEventListener('input', () => {
    if (charCount) charCount.textContent = String(nameInput.value.length);
  });

  privateToggle?.addEventListener('click', () => {
    const isPressed = privateToggle.getAttribute('aria-pressed') === 'true';
    privateToggle.setAttribute('aria-pressed', String(!isPressed));
    privateToggle.classList.toggle('toggle-switch--on');
  });

  listForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    // For now, add the list to the UI (no backend persistence yet)
    const name = nameInput?.value || 'Untitled list';
    const container = document.getElementById('lists-container');

    if (container) {
      const card = document.createElement('div');
      card.className = 'list-card';
      card.innerHTML = `
        <div class="list-card-info">
          <div class="list-card-author">
            <div class="list-card-avatar"><span>${document.getElementById('list-user-initials')?.textContent || 'BB'}</span></div>
            <span class="list-card-author-name">${document.getElementById('list-user-name')?.textContent || 'User'}</span>
          </div>
          <h3 class="list-card-title">${name}</h3>
          <div class="list-card-meta">
            <span class="list-card-count">0 stories</span>
            <span class="list-card-lock">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            </span>
            <button class="list-card-more" aria-label="More options">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle><circle cx="5" cy="12" r="1"></circle></svg>
            </button>
          </div>
        </div>
        <div class="list-card-thumbnails">
          <div class="list-card-thumb list-card-thumb--placeholder"></div>
          <div class="list-card-thumb list-card-thumb--placeholder"></div>
          <div class="list-card-thumb list-card-thumb--placeholder"></div>
        </div>
      `;
      container.appendChild(card);
    }

    closeModal();
  });

  // Init
  if (typeof window !== 'undefined') {
    initLibrary();
  }
</script>

<style>
  /* ═══════════════════════════════════════════════════════════════════
     LOADING
     ═══════════════════════════════════════════════════════════════════ */
  .library-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--header-height));
    gap: var(--space-md);
  }

  .loading-spinner {
    width: 32px;
    height: 32px;
    border: 2px solid var(--color-hairline);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .loading-text {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-muted);
  }

  /* ═══════════════════════════════════════════════════════════════════
     LAYOUT
     ═══════════════════════════════════════════════════════════════════ */
  .library-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: calc(100vh - var(--header-height));
    max-width: 1320px;
    margin: 0 auto;
  }

  .library-content {
    padding: var(--space-xxl) var(--space-xxl) var(--space-xxl) var(--space-xl);
    max-width: 820px;
  }

  /* ═══════════════════════════════════════════════════════════════════
     HEADER
     ═══════════════════════════════════════════════════════════════════ */
  .library-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-xl);
  }

  .library-title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 4vw, 3rem);
    font-weight: 400;
    color: var(--color-ink);
    letter-spacing: -1px;
    line-height: 1.1;
  }

  .new-list-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 500;
    padding: 10px 20px;
    border-radius: var(--radius-pill);
    background: var(--color-success);
    color: white;
    border: none;
    cursor: pointer;
    transition:
      opacity var(--duration-fast),
      transform var(--duration-fast);
    white-space: nowrap;
  }

  .new-list-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  /* ═══════════════════════════════════════════════════════════════════
     TABS
     ═══════════════════════════════════════════════════════════════════ */
  .library-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--color-hairline);
    margin-bottom: var(--space-xl);
    overflow-x: auto;
  }

  .library-tabs::-webkit-scrollbar {
    display: none;
  }

  .library-tab {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 400;
    color: var(--color-muted);
    background: none;
    border: none;
    padding: var(--space-md) var(--space-lg);
    cursor: pointer;
    position: relative;
    transition: color var(--duration-fast);
    white-space: nowrap;
  }

  .library-tab:hover {
    color: var(--color-ink);
  }

  .library-tab--active {
    color: var(--color-ink);
    font-weight: 500;
  }

  .library-tab--active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: var(--space-lg);
    right: var(--space-lg);
    height: 1px;
    background: var(--color-ink);
  }

  /* ═══════════════════════════════════════════════════════════════════
     TAB PANELS
     ═══════════════════════════════════════════════════════════════════ */
  .tab-panel {
    display: none;
  }

  .tab-panel--active {
    display: block;
    animation: fadeIn 0.2s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ═══════════════════════════════════════════════════════════════════
     CTA BANNER
     ═══════════════════════════════════════════════════════════════════ */
  .library-cta-banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(135deg, #2d6a4f, #40916c);
    border-radius: var(--radius-md);
    padding: var(--space-xl) var(--space-xxl);
    margin-bottom: var(--space-xl);
    overflow: hidden;
    transition:
      opacity 0.3s,
      transform 0.3s;
  }

  .cta-close {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    padding: 4px;
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast);
  }

  .cta-close:hover {
    color: white;
  }

  .cta-text {
    flex: 1;
  }

  .cta-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.5vw, 1.6rem);
    font-weight: 400;
    color: white;
    line-height: 1.3;
    margin-bottom: var(--space-md);
    max-width: 340px;
  }

  .cta-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 500;
    padding: 10px 24px;
    border-radius: var(--radius-pill);
    background: rgba(0, 0, 0, 0.25);
    color: white;
    border: none;
    cursor: pointer;
    transition: background var(--duration-fast);
  }

  .cta-action-btn:hover {
    background: rgba(0, 0, 0, 0.4);
  }

  .cta-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: white;
    flex-shrink: 0;
    margin-left: var(--space-xl);
  }

  /* ═══════════════════════════════════════════════════════════════════
     LIST CARDS
     ═══════════════════════════════════════════════════════════════════ */
  .lists-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .list-card {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: box-shadow var(--duration-fast);
    background: var(--bg-canvas);
  }

  .list-card:hover {
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  }

  .list-card-info {
    flex: 1;
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .list-card-author {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .list-card-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent-amber));
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
