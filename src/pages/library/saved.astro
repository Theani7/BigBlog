---
import LibraryLayout from '../../components/library/LibraryLayout.astro';
import EmptyState from '../../components/library/EmptyState.astro';
import { createDatabase, type Env } from '../../db';
import { articleBookmarks, Story } from '../../db/schema';
import type { StorySummary } from '../../types/content';

const env = (Astro.locals as { env: Env }).env;
let savedStories: StorySummary[] = [];
if (env) {
  try {
    await createDatabase(env);
    const sessionId = Astro.cookies.get('bb_session')?.value;
    if (sessionId) {
      const bookmarks = await articleBookmarks.find({ sessionId }).sort({ createdAt: -1 }).lean();
      if (bookmarks.length) {
        const slugs = bookmarks.map((b) => b.articleSlug);
        const stories = (await Story.find({ slug: { $in: slugs }, status: 'PUBLISHED' })
          .populate('authorId', 'name avatar')
          .lean()) as unknown as StorySummary[];
        const storyBySlug = new Map(stories.map((s) => [s.slug, s]));
        savedStories = bookmarks
          .map((b) => ({ ...(storyBySlug.get(b.articleSlug) || {}), savedAt: b.createdAt }))
          .filter((s): s is StorySummary => Boolean(s.title));
      }
    }
  } catch (error) {
    console.error('Failed to load saved stories:', error);
  }
}
const formatSavedAt = (date: Date) =>
  new Date(date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<LibraryLayout
  title="Saved Stories — Library"
  description="Stories you've bookmarked."
  activeTab="saved-lists"
>
  {
    savedStories.length > 0 ? (
      <div class="saved-list">
        {savedStories.map((story) => (
          <article class="saved-card" data-slug={story.slug}>
            <a class="saved-card-link" href={`/p/${story.slug}`}>
              <div class="saved-card-content">
                <h2 class="saved-card-title">{story.title}</h2>
                <p class="saved-card-excerpt">
                  {story.content
                    ? story.content
                        .replace(/<[^>]+>/g, '')
                        .trim()
                        .substring(0, 160) + '...'
                    : 'No excerpt available'}
                </p>
                <div class="saved-card-meta">
                  <span>{story.authorId?.name || 'Anonymous'}</span>
                  <span class="meta-divider">·</span>
                  <span>Saved {formatSavedAt(story.savedAt)}</span>
                </div>
              </div>
            </a>
            <button
              class="saved-remove"
              data-remove-slug={story.slug}
              aria-label={`Remove ${story.title} from saved`}
              title="Remove from saved"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
              </svg>
            </button>
          </article>
        ))}
      </div>
    ) : (
      <EmptyState
        title="No saved stories yet"
        description="Bookmark stories while reading to revisit them here."
        icon="saved"
      />
    )
  }
</LibraryLayout>

<script>
  const UNDO_MS = 5000;

  async function toggleBookmark(slug) {
    const res = await fetch('/api/bookmarks', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ slug }),
    });
    const data = await res.json();
    return data.success;
  }

  async function updateCount() {
    const countEl = document.querySelector('.list-card-count');
    if (!countEl) return;
    try {
      const res = await fetch('/api/bookmarks');
      const data = await res.json();
      if (data.success) {
        const n = data.data?.bookmarks?.length ?? 0;
        countEl.textContent = `${n} ${n === 1 ? 'story' : 'stories'}`;
      }
    } catch (err) {
      console.error('Failed to load bookmark count:', err);
    }
  }

  function finalizeRemoval(card) {
    card.classList.add('saved-card--removing');
    setTimeout(() => card.remove(), 200);
    updateCount();
    const empty = document.querySelector('.empty-state');
    if (empty && document.querySelectorAll('.saved-card').length === 1) {
      setTimeout(() => empty.classList.add('empty-state--visible'), 250);
    }
  }

  document.querySelectorAll('[data-remove-slug]').forEach((btn) => {
    const slug = btn.getAttribute('data-remove-slug');
    const card = btn.closest('.saved-card');
    if (!slug || !card) return;

    let undoTimeout = null;
    let undoBar = null;

    const clearUndo = () => {
      if (undoTimeout) clearTimeout(undoTimeout);
      undoTimeout = null;
      undoBar?.remove();
      undoBar = null;
      card.classList.remove('saved-card--removed');
      btn.style.display = '';
      btn.disabled = false;
    };

    btn.addEventListener('click', async () => {
      if (btn.disabled) return;
      btn.disabled = true;

      let ok = false;
      try {
        ok = await toggleBookmark(slug);
      } catch (error) {
        console.error('Failed to remove bookmark:', error);
      }
      if (!ok) {
        btn.disabled = false;
        return;
      }

      card.classList.add('saved-card--removed');
      btn.style.display = 'none';

      undoBar = document.createElement('div');
      undoBar.className = 'saved-undo';
      undoBar.innerHTML = `
        <span class="saved-undo-label">Removed</span>
        <button type="button" class="saved-undo-btn">Undo</button>
      `;
      card.appendChild(undoBar);

      undoBar.querySelector('.saved-undo-btn').addEventListener('click', async (e) => {
        e.stopPropagation();
        const undoBtn = undoBar.querySelector('.saved-undo-btn');
        undoBtn.disabled = true;
        let restored = false;
        try {
          restored = await toggleBookmark(slug);
        } catch (error) {
          console.error('Failed to undo bookmark removal:', error);
        }
        if (restored) {
          clearUndo();
          updateCount();
        } else {
          if (undoTimeout) clearTimeout(undoTimeout);
          finalizeRemoval(card);
        }
      });

      undoTimeout = setTimeout(() => finalizeRemoval(card), UNDO_MS);
    });
  });
</script>

<style>
  .saved-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .saved-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .saved-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bg-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    transition:
      transform var(--duration-fast) var(--ease-default),
      box-shadow var(--duration-fast) var(--ease-default),
      opacity var(--duration-normal) var(--ease-default);
  }

  .saved-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.06);
  }

  .saved-card--removing {
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
  }

  .saved-card--removed {
    opacity: 0.55;
    filter: grayscale(0.3);
    pointer-events: none;
  }

  .saved-undo {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    background: rgba(198, 69, 69, 0.06);
    border: 1px solid rgba(198, 69, 69, 0.2);
    border-radius: var(--radius-md);
  }

  .saved-undo-label {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--color-error);
  }

  .saved-undo-btn {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--color-error);
    background: none;
    border: 1px solid rgba(198, 69, 69, 0.35);
    border-radius: var(--radius-pill);
    padding: 5px 14px;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-default);
  }

  .saved-undo-btn:hover {
    background: var(--color-error);
    color: #fff;
  }

  .saved-undo-btn:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .saved-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .saved-card-title {
    font-family: var(--font-serif);
    font-size: var(--text-title-md);
    font-weight: 700;
    margin: 0 0 var(--space-xs) 0;
    line-height: 1.3;
    color: var(--color-ink);
    transition: color var(--duration-fast) var(--ease-default);
  }

  .saved-card:hover .saved-card-title {
    color: var(--color-primary);
  }

  .saved-card-excerpt {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-muted);
    margin: 0 0 var(--space-sm) 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .saved-card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
  }

  .meta-divider {
    opacity: 0.6;
  }

  .saved-remove {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--color-primary);
    background: rgba(30, 16, 51, 0.1);
    border: 1px solid rgba(30, 16, 51, 0.25);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-default);
  }

  .saved-remove:hover {
    color: var(--color-error);
    background: rgba(198, 69, 69, 0.1);
    border-color: var(--color-error);
    transform: scale(1.06);
  }

  .saved-remove:disabled {
    opacity: 0.5;
    cursor: default;
    transform: none;
  }

  .empty-state {
    opacity: 0;
    transform: translateY(8px);
  }

  .empty-state--visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
