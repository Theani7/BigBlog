---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { getSeries, filterDrafts } from '../../lib/content';

export async function getStaticPaths() {
  const series = await getCollection('series');
  return series.map((s) => ({
    params: { slug: s.slug ?? s.data.title.toLowerCase().replace(/\s+/g, '-') },
    props: {
      title: s.data.title,
      description: s.data.description,
      cover: s.data.cover,
      author: s.data.author,
      category: s.data.category,
    },
  }));
}

const { title, description, cover, author, category } = Astro.props;
const allPosts = await getCollection('blog');
const publishedPosts = filterDrafts(allPosts);
const seriesPosts = getSeries(allPosts, title);

const totalWords = seriesPosts.reduce((acc, p) => acc + (p.body?.split(/\s+/).length || 0), 0);
const totalReadingTime = Math.max(1, Math.round(totalWords / 200));

const allSeries = [
  ...new Set(publishedPosts.filter((p) => p.data.series).map((p) => p.data.series)),
];
const otherSeries = allSeries
  .filter((s) => s.toLowerCase() !== title.toLowerCase())
  .map((s) => ({
    name: s,
    count: publishedPosts.filter((p) => p.data.series === s).length,
    category: publishedPosts.find((p) => p.data.series === s)?.data.category,
  }))
  .slice(0, 3);

const pageTitle = `${title} — Series`;
const pageDescription = description || `Articles in the ${title} series.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={`https://bigblog.dev/series/${title.toLowerCase().replace(/\s+/g, '-')}`}
>
  <section class="series-page">
    <div class="container">
      <div class="series-header">
        {
          cover && (
            <div class="series-cover">
              <img src={cover} alt={title} />
            </div>
          )
        }
        <div class="series-info">
          <p class="page-eyebrow">Series</p>
          <h1 class="page-title">{title}</h1>
          {description && <p class="page-description">{description}</p>}

          <div class="series-meta">
            <span class="series-meta-item">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                ></path><polyline points="14 2 14 8 20 8"></polyline></svg
              >
              {seriesPosts.length} articles
            </span>
            <span class="series-meta-item">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"
                ></polyline></svg
              >
              ~{totalReadingTime} min total
            </span>
            {
              author && (
                <span class="series-meta-item">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <>
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                      <circle cx="12" cy="7" r="4" />
                    </>
                  </svg>
                  {author}
                </span>
              )
            }
            {
              category && (
                <span class="series-meta-item">
                  <a href={`/category/${category.toLowerCase()}`}>{category}</a>
                </span>
              )
            }
          </div>
        </div>
      </div>

      <div class="series-layout">
        <div class="series-main">
          <section class="series-articles" aria-label="Series articles">
            {
              seriesPosts.length > 0 ? (
                <div class="article-list">
                  {seriesPosts.map((post, index) => (
                    <div class="series-article">
                      <span class="series-article-number">{index + 1}</span>
                      <div class="series-article-content">
                        <ArticleCard post={post} />
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="empty-state">
                  <p>No articles in this series yet.</p>
                  <a href="/blog" class="empty-state-link">
                    Browse all articles
                  </a>
                </div>
              )
            }
          </section>
        </div>

        <aside class="series-sidebar" aria-label="Series sidebar">
          {
            otherSeries.length > 0 && (
              <section class="sidebar-section">
                <h3 class="sidebar-heading">Other Series</h3>
                <div class="sidebar-links">
                  {otherSeries.map((s) => (
                    <a
                      href={`/series/${s.name.toLowerCase().replace(/\s+/g, '-')}`}
                      class="sidebar-series"
                    >
                      <span class="sidebar-series-name">{s.name}</span>
                      <span class="sidebar-series-meta">
                        {s.count} articles · {s.category}
                      </span>
                    </a>
                  ))}
                </div>
              </section>
            )
          }

          <section class="sidebar-section">
            <h3 class="sidebar-heading">Browse by Category</h3>
            <div class="sidebar-links">
              {
                [...new Set(publishedPosts.map((p) => p.data.category))].sort().map((cat) => (
                  <a href={`/category/${cat.toLowerCase()}`} class="sidebar-link">
                    {cat}
                  </a>
                ))
              }
            </div>
          </section>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .series-page {
    padding: 5rem 0 6rem;
  }

  .series-header {
    margin-bottom: var(--space-8);
  }

  .series-cover {
    margin-bottom: var(--space-6);
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 21 / 9;
  }

  .series-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .page-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-3) 0;
  }

  .page-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-4) 0;
    max-width: 40rem;
  }

  .series-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .series-meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .series-meta-item a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .series-meta-item a:hover {
    text-decoration: underline;
  }

  .series-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .article-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .series-article {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .series-article-number {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--text-secondary);
  }

  .series-article-content {
    flex: 1;
    min-width: 0;
  }

  .empty-state {
    padding: var(--space-8) 0;
    text-align: center;
    color: var(--text-tertiary);
  }

  .empty-state-link {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--color-primary);
    font-weight: var(--weight-medium);
  }

  .series-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .sidebar-section {
    padding: var(--space-5);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
  }

  .sidebar-heading {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0 0 var(--space-4) 0;
  }

  .sidebar-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .sidebar-series {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-decoration: none;
    padding: var(--space-3);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    transition: border-color var(--duration-fast) var(--ease-default);
  }

  .sidebar-series:hover {
    border-color: var(--color-primary);
    text-decoration: none;
  }

  .sidebar-series-name {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
  }

  .sidebar-series-meta {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .sidebar-link {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    padding: var(--space-2) 0;
    transition: color var(--duration-fast) var(--ease-default);
  }

  .sidebar-link:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .series-layout {
      grid-template-columns: 1fr 280px;
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-series,
    .sidebar-link {
      transition: none;
    }
  }
</style>
