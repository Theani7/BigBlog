---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Content Analytics" description="Understand your content performance">
  <header class="dashboard-header">
    <h1 class="dashboard-title">Content Analytics</h1>
    <p class="dashboard-subtitle">See which content resonates with your audience</p>
  </header>

  <nav class="dashboard-nav">
    <a href="/dashboard" class="dashboard-nav-link">Overview</a>
    <a href="/dashboard/traffic" class="dashboard-nav-link">Traffic</a>
    <a href="/dashboard/performance" class="dashboard-nav-link">Performance</a>
    <a href="/dashboard/errors" class="dashboard-nav-link">Errors</a>
    <a href="/dashboard/content" class="dashboard-nav-link active">Content</a>
    <a href="/dashboard/search" class="dashboard-nav-link">Search</a>
  </nav>

  <div class="filters">
    <select id="period-filter" class="filter-select">
      <option value="7">Last 7 days</option>
      <option value="30">Last 30 days</option>
      <option value="90">Last 90 days</option>
    </select>
  </div>

  <div class="dashboard-grid">
    <section class="dashboard-card full-width">
      <h2 class="card-title">Top Content</h2>
      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>Page</th>
              <th>Views</th>
              <th>Avg. Scroll Depth</th>
              <th>Avg. Time</th>
            </tr>
          </thead>
          <tbody id="top-content-body">
            <tr>
              <td colspan="4" class="empty-state">Loading...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="dashboard-card">
      <h2 class="card-title">Engagement Metrics</h2>
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-label">Total Page Views</span>
          <span class="stat-value" id="total-views">--</span>
        </div>
        <div class="stat-item">
          <span class="stat-label">Unique Visitors</span>
          <span class="stat-value" id="unique-visitors">--</span>
        </div>
      </div>
    </section>

    <section class="dashboard-card">
      <h2 class="card-title">Scroll Depth Distribution</h2>
      <div id="scroll-depth-list">
        <p class="empty-state">Loading...</p>
      </div>
    </section>
  </div>
</DashboardLayout>

<style>
  .dashboard-header {
    margin-bottom: var(--space-8);
  }

  .dashboard-title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-2) 0;
  }

  .dashboard-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin: 0;
  }

  .dashboard-nav {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    padding: var(--space-2);
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    overflow-x: auto;
  }

  .dashboard-nav-link {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-secondary);
    white-space: nowrap;
    transition: all var(--duration-fast) var(--ease-default);
  }

  .dashboard-nav-link:hover {
    color: var(--text-primary);
    background: var(--bg-tertiary);
  }

  .dashboard-nav-link.active {
    color: var(--color-primary);
    background: var(--bg-primary);
    box-shadow: var(--shadow-sm);
  }

  .filters {
    margin-bottom: var(--space-6);
  }

  .filter-select {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-primary);
    color: var(--text-primary);
    font-size: var(--text-sm);
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .dashboard-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .dashboard-card.full-width {
    grid-column: 1 / -1;
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
    margin: 0 0 var(--space-4) 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stat-label {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .stat-value {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
  }

  .table-container {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
  }

  .data-table th,
  .data-table td {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    border-bottom: 1px solid var(--border-color);
  }

  .data-table th {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .data-table td {
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .empty-state {
    color: var(--text-tertiary);
    font-size: var(--text-sm);
    text-align: center;
    padding: var(--space-4);
  }

  @media (max-width: 768px) {
    .dashboard-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  async function loadContentData() {
    const days = document.getElementById('period-filter').value;

    try {
      const response = await fetch(`/api/analytics/dashboard?days=${days}`);
      const data = await response.json();

      // Top content
      const topPages = data.traffic?.viewsByPage || [];
      const topContentBody = document.getElementById('top-content-body');

      if (topPages.length === 0) {
        topContentBody.innerHTML =
          '<tr><td colspan="4" class="empty-state">No content data available</td></tr>';
      } else {
        topContentBody.innerHTML = topPages
          .slice(0, 20)
          .map(
            (p) => `
          <tr>
            <td>${p.page}</td>
            <td>${p.views.toLocaleString()}</td>
            <td>--</td>
            <td>--</td>
          </tr>
        `
          )
          .join('');
      }

      // Engagement metrics
      document.getElementById('total-views').textContent =
        data.traffic?.totalViews?.toLocaleString() || '--';
      document.getElementById('unique-visitors').textContent =
        data.traffic?.uniqueVisitors?.toLocaleString() || '--';

      // Scroll depth
      const scrollDepth = data.engagement?.scrollDepth || [];
      const scrollEl = document.getElementById('scroll-depth-list');

      if (scrollDepth.length === 0) {
        scrollEl.innerHTML = '<p class="empty-state">No scroll data available</p>';
      } else {
        scrollEl.innerHTML = scrollDepth
          .slice(0, 10)
          .map(
            (s) => `
          <div class="list-item">
            <span class="item-label">${s.page}</span>
            <span class="item-value">${Math.round(s.avgDepth * 100)}% avg depth</span>
          </div>
        `
          )
          .join('');
      }
    } catch (error) {
      console.error('Failed to load content data:', error);
    }
  }

  document.getElementById('period-filter').addEventListener('change', loadContentData);
  loadContentData();
</script>
