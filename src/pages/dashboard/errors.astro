---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Error Analytics" description="Monitor and debug errors">
  <header class="dashboard-header">
    <h1 class="dashboard-title">Error Analytics</h1>
    <p class="dashboard-subtitle">Track and resolve errors across your application</p>
  </header>

  <nav class="dashboard-nav">
    <a href="/dashboard" class="dashboard-nav-link">Overview</a>
    <a href="/dashboard/traffic" class="dashboard-nav-link">Traffic</a>
    <a href="/dashboard/performance" class="dashboard-nav-link">Performance</a>
    <a href="/dashboard/errors" class="dashboard-nav-link active">Errors</a>
    <a href="/dashboard/content" class="dashboard-nav-link">Content</a>
    <a href="/dashboard/search" class="dashboard-nav-link">Search</a>
  </nav>

  <div class="filters">
    <select id="period-filter" class="filter-select">
      <option value="7">Last 7 days</option>
      <option value="30">Last 30 days</option>
      <option value="90">Last 90 days</option>
    </select>
    <select id="level-filter" class="filter-select">
      <option value="">All Levels</option>
      <option value="error">Errors</option>
      <option value="warning">Warnings</option>
      <option value="info">Info</option>
    </select>
  </div>

  <div class="dashboard-grid">
    <section class="dashboard-card">
      <h2 class="card-title">Error Summary</h2>
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-label">Total Errors</span>
          <span class="stat-value" id="total-errors">--</span>
        </div>
        <div class="stat-item">
          <span class="stat-label">Error Rate</span>
          <span class="stat-value" id="error-rate">--</span>
        </div>
      </div>
    </section>

    <section class="dashboard-card">
      <h2 class="card-title">Errors by Level</h2>
      <div id="errors-by-level">
        <p class="empty-state">Loading...</p>
      </div>
    </section>

    <section class="dashboard-card full-width">
      <h2 class="card-title">Recent Errors</h2>
      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>Message</th>
              <th>Count</th>
              <th>Last Seen</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody id="recent-errors-body">
            <tr>
              <td colspan="4" class="empty-state">Loading...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="dashboard-card">
      <h2 class="card-title">Errors by Page</h2>
      <div id="errors-by-page">
        <p class="empty-state">Loading...</p>
      </div>
    </section>

    <section class="dashboard-card">
      <h2 class="card-title">Error Trends</h2>
      <div id="error-trends">
        <p class="empty-state">Loading...</p>
      </div>
    </section>
  </div>
</DashboardLayout>

<style>
  .dashboard-header {
    margin-bottom: var(--space-8);
  }

  .dashboard-title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-2) 0;
  }

  .dashboard-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin: 0;
  }

  .dashboard-nav {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    padding: var(--space-2);
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    overflow-x: auto;
  }

  .dashboard-nav-link {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-secondary);
    white-space: nowrap;
    transition: all var(--duration-fast) var(--ease-default);
  }

  .dashboard-nav-link:hover {
    color: var(--text-primary);
    background: var(--bg-tertiary);
  }

  .dashboard-nav-link.active {
    color: var(--color-primary);
    background: var(--bg-primary);
    box-shadow: var(--shadow-sm);
  }

  .filters {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .filter-select {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-primary);
    color: var(--text-primary);
    font-size: var(--text-sm);
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .dashboard-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .dashboard-card.full-width {
    grid-column: 1 / -1;
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
    margin: 0 0 var(--space-4) 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stat-label {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .stat-value {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
  }

  .table-container {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
  }

  .data-table th,
  .data-table td {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    border-bottom: 1px solid var(--border-color);
  }

  .data-table th {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .data-table td {
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .empty-state {
    color: var(--text-tertiary);
    font-size: var(--text-sm);
    text-align: center;
    padding: var(--space-4);
  }

  .error-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  .error-badge.error {
    background: #fecaca;
    color: #991b1b;
  }

  .error-badge.warning {
    background: #fef9c3;
    color: #854d0e;
  }

  .error-badge.info {
    background: #dbeafe;
    color: #1e40af;
  }

  @media (max-width: 768px) {
    .dashboard-grid {
      grid-template-columns: 1fr;
    }

    .filters {
      flex-direction: column;
    }
  }
</style>

<script is:inline>
  async function loadErrorData() {
    const days = document.getElementById('period-filter').value;
    const level = document.getElementById('level-filter').value;

    try {
      const response = await fetch(
        `/api/analytics/errors?days=${days}${level ? `&level=${level}` : ''}`
      );
      const data = await response.json();

      // Error summary
      document.getElementById('total-errors').textContent = data.total?.toLocaleString() || '0';

      // Errors by level
      const byLevel = data.byLevel || [];
      const byLevelEl = document.getElementById('errors-by-level');

      if (byLevel.length === 0) {
        byLevelEl.innerHTML = '<p class="empty-state">No errors recorded</p>';
      } else {
        byLevelEl.innerHTML = byLevel
          .map(
            (l) => `
          <div class="list-item">
            <span class="error-badge ${l.level}">${l.level}</span>
            <span class="item-value">${l.count.toLocaleString()}</span>
          </div>
        `
          )
          .join('');
      }

      // Recent errors
      const recent = data.recent || [];
      const recentBody = document.getElementById('recent-errors-body');

      if (recent.length === 0) {
        recentBody.innerHTML =
          '<tr><td colspan="4" class="empty-state">No errors in this period</td></tr>';
      } else {
        recentBody.innerHTML = recent
          .map(
            (e) => `
          <tr>
            <td>${e.message}</td>
            <td>${e.count.toLocaleString()}</td>
            <td>${new Date(e.lastSeen).toLocaleDateString()}</td>
            <td><span class="error-badge error">Active</span></td>
          </tr>
        `
          )
          .join('');
      }

      // Errors by page
      const byPage = data.byPage || [];
      const byPageEl = document.getElementById('errors-by-page');

      if (byPage.length === 0) {
        byPageEl.innerHTML = '<p class="empty-state">No page errors recorded</p>';
      } else {
        byPageEl.innerHTML = byPage
          .slice(0, 10)
          .map(
            (p) => `
          <div class="list-item">
            <span class="item-label">${p.page || 'Unknown'}</span>
            <span class="item-value">${p.count.toLocaleString()}</span>
          </div>
        `
          )
          .join('');
      }
    } catch (error) {
      console.error('Failed to load error data:', error);
    }
  }

  document.getElementById('period-filter').addEventListener('change', loadErrorData);
  document.getElementById('level-filter').addEventListener('change', loadErrorData);
  loadErrorData();
</script>
