---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout
  title="Performance Analytics"
  description="Core Web Vitals and performance metrics"
>
  <header class="dashboard-header">
    <h1 class="dashboard-title">Performance Analytics</h1>
    <p class="dashboard-subtitle">Monitor Core Web Vitals and API performance</p>
  </header>

  <nav class="dashboard-nav">
    <a href="/dashboard" class="dashboard-nav-link">Overview</a>
    <a href="/dashboard/traffic" class="dashboard-nav-link">Traffic</a>
    <a href="/dashboard/performance" class="dashboard-nav-link active">Performance</a>
    <a href="/dashboard/errors" class="dashboard-nav-link">Errors</a>
    <a href="/dashboard/content" class="dashboard-nav-link">Content</a>
    <a href="/dashboard/search" class="dashboard-nav-link">Search</a>
  </nav>

  <div class="filters">
    <select id="period-filter" class="filter-select">
      <option value="7">Last 7 days</option>
      <option value="30">Last 30 days</option>
      <option value="90">Last 90 days</option>
    </select>
  </div>

  <div class="dashboard-grid">
    <section class="dashboard-card">
      <h2 class="card-title">Largest Contentful Paint (LCP)</h2>
      <div class="metric-display">
        <span class="metric-value" id="lcp-p50">--</span>
        <span class="metric-label">p50</span>
      </div>
      <div class="metric-display">
        <span class="metric-value" id="lcp-p75">--</span>
        <span class="metric-label">p75</span>
      </div>
      <div class="metric-display">
        <span class="metric-value" id="lcp-p90">--</span>
        <span class="metric-label">p90</span>
      </div>
      <div class="metric-status" id="lcp-status">--</div>
    </section>

    <section class="dashboard-card">
      <h2 class="card-title">Cumulative Layout Shift (CLS)</h2>
      <div class="metric-display">
        <span class="metric-value" id="cls-p50">--</span>
        <span class="metric-label">p50</span>
      </div>
      <div class="metric-display">
        <span class="metric-value" id="cls-p75">--</span>
        <span class="metric-label">p75</span>
      </div>
      <div class="metric-display">
        <span class="metric-value" id="cls-p90">--</span>
        <span class="metric-label">p90</span>
      </div>
      <div class="metric-status" id="cls-status">--</div>
    </section>

    <section class="dashboard-card">
      <h2 class="card-title">Interaction to Next Paint (INP)</h2>
      <div class="metric-display">
        <span class="metric-value" id="inp-p50">--</span>
        <span class="metric-label">p50</span>
      </div>
      <div class="metric-display">
        <span class="metric-value" id="inp-p75">--</span>
        <span class="metric-label">p75</span>
      </div>
      <div class="metric-display">
        <span class="metric-value" id="inp-p90">--</span>
        <span class="metric-label">p90</span>
      </div>
      <div class="metric-status" id="inp-status">--</div>
    </section>

    <section class="dashboard-card">
      <h2 class="card-title">Time to First Byte (TTFB)</h2>
      <div class="metric-display">
        <span class="metric-value" id="ttfb-p50">--</span>
        <span class="metric-label">p50</span>
      </div>
      <div class="metric-display">
        <span class="metric-value" id="ttfb-p75">--</span>
        <span class="metric-label">p75</span>
      </div>
      <div class="metric-display">
        <span class="metric-value" id="ttfb-p90">--</span>
        <span class="metric-label">p90</span>
      </div>
      <div class="metric-status" id="ttfb-status">--</div>
    </section>

    <section class="dashboard-card full-width">
      <h2 class="card-title">API Latency</h2>
      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>Endpoint</th>
              <th>Method</th>
              <th>p50</th>
              <th>p95</th>
              <th>p99</th>
              <th>Requests</th>
            </tr>
          </thead>
          <tbody id="api-latency-body">
            <tr>
              <td colspan="6" class="empty-state">Loading...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="dashboard-card full-width">
      <h2 class="card-title">Performance by Page</h2>
      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>Page</th>
              <th>Metric</th>
              <th>Average</th>
            </tr>
          </thead>
          <tbody id="performance-by-page-body">
            <tr>
              <td colspan="3" class="empty-state">Loading...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</DashboardLayout>

<style>
  .dashboard-header {
    margin-bottom: var(--space-8);
  }

  .dashboard-title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-2) 0;
  }

  .dashboard-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin: 0;
  }

  .dashboard-nav {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    padding: var(--space-2);
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    overflow-x: auto;
  }

  .dashboard-nav-link {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-secondary);
    white-space: nowrap;
    transition: all var(--duration-fast) var(--ease-default);
  }

  .dashboard-nav-link:hover {
    color: var(--text-primary);
    background: var(--bg-tertiary);
  }

  .dashboard-nav-link.active {
    color: var(--color-primary);
    background: var(--bg-primary);
    box-shadow: var(--shadow-sm);
  }

  .filters {
    margin-bottom: var(--space-6);
  }

  .filter-select {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-primary);
    color: var(--text-primary);
    font-size: var(--text-sm);
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .dashboard-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .dashboard-card.full-width {
    grid-column: 1 / -1;
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
    margin: 0 0 var(--space-4) 0;
  }

  .metric-display {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .metric-value {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
  }

  .metric-label {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .metric-status {
    margin-top: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-align: center;
  }

  .metric-status.good {
    background: #dcfce7;
    color: #166534;
  }

  .metric-status.needs-improvement {
    background: #fef9c3;
    color: #854d0e;
  }

  .metric-status.poor {
    background: #fecaca;
    color: #991b1b;
  }

  .table-container {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
  }

  .data-table th,
  .data-table td {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    border-bottom: 1px solid var(--border-color);
  }

  .data-table th {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .data-table td {
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .empty-state {
    color: var(--text-tertiary);
    font-size: var(--text-sm);
    text-align: center;
    padding: var(--space-4);
  }

  @media (max-width: 768px) {
    .dashboard-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  function getStatus(metric, value) {
    const thresholds = {
      LCP: { good: 2500, poor: 4000 },
      CLS: { good: 0.1, poor: 0.25 },
      INP: { good: 200, poor: 500 },
      TTFB: { good: 800, poor: 1800 },
    };

    const t = thresholds[metric];
    if (!t) return '';

    if (value <= t.good) return 'good';
    if (value <= t.poor) return 'needs-improvement';
    return 'poor';
  }

  function formatMetric(metric, value) {
    if (metric === 'CLS') return value.toFixed(3);
    return `${Math.round(value)}ms`;
  }

  async function loadPerformanceData() {
    const days = document.getElementById('period-filter').value;

    try {
      const response = await fetch(`/api/analytics/dashboard?days=${days}`);
      const data = await response.json();

      const vitals = data.performance?.coreWebVitals || [];

      for (const vital of vitals) {
        const metric = vital.metric;
        const p50 = vital.p50 || 0;
        const p75 = vital.p75 || 0;
        const p90 = vital.p90 || 0;

        const p50El = document.getElementById(`${metric.toLowerCase()}-p50`);
        const p75El = document.getElementById(`${metric.toLowerCase()}-p75`);
        const p90El = document.getElementById(`${metric.toLowerCase()}-p90`);
        const statusEl = document.getElementById(`${metric.toLowerCase()}-status`);

        if (p50El) p50El.textContent = formatMetric(metric, p50);
        if (p75El) p75El.textContent = formatMetric(metric, p75);
        if (p90El) p90El.textContent = formatMetric(metric, p90);

        if (statusEl) {
          const status = getStatus(metric, p75);
          statusEl.textContent =
            status === 'good'
              ? 'Good'
              : status === 'needs-improvement'
                ? 'Needs Improvement'
                : 'Poor';
          statusEl.className = `metric-status ${status}`;
        }
      }

      // API Latency
      const apiLatency = data.api?.latencyByEndpoint || [];
      const apiBody = document.getElementById('api-latency-body');

      if (apiLatency.length === 0) {
        apiBody.innerHTML =
          '<tr><td colspan="6" class="empty-state">No API data available</td></tr>';
      } else {
        apiBody.innerHTML = apiLatency
          .map(
            (a) => `
          <tr>
            <td>${a.endpoint}</td>
            <td>${a.method}</td>
            <td>${Math.round(a.p50)}ms</td>
            <td>${Math.round(a.p95)}ms</td>
            <td>${Math.round(a.p99)}ms</td>
            <td>${a.count.toLocaleString()}</td>
          </tr>
        `
          )
          .join('');
      }

      // Performance by page
      const byPage = data.performance?.byPage || [];
      const byPageBody = document.getElementById('performance-by-page-body');

      if (byPage.length === 0) {
        byPageBody.innerHTML =
          '<tr><td colspan="3" class="empty-state">No page data available</td></tr>';
      } else {
        byPageBody.innerHTML = byPage
          .map(
            (p) => `
          <tr>
            <td>${p.page}</td>
            <td>${p.metric}</td>
            <td>${formatMetric(p.metric, p.avg)}</td>
          </tr>
        `
          )
          .join('');
      }
    } catch (error) {
      console.error('Failed to load performance data:', error);
    }
  }

  document.getElementById('period-filter').addEventListener('change', loadPerformanceData);
  loadPerformanceData();
</script>
