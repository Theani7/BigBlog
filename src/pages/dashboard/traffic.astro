---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Traffic Analytics" description="Detailed traffic insights">
  <header class="dashboard-header">
    <h1 class="dashboard-title">Traffic Analytics</h1>
    <p class="dashboard-subtitle">Understand your audience and content performance</p>
  </header>

  <nav class="dashboard-nav">
    <a href="/dashboard" class="dashboard-nav-link">Overview</a>
    <a href="/dashboard/traffic" class="dashboard-nav-link active">Traffic</a>
    <a href="/dashboard/performance" class="dashboard-nav-link">Performance</a>
    <a href="/dashboard/errors" class="dashboard-nav-link">Errors</a>
    <a href="/dashboard/content" class="dashboard-nav-link">Content</a>
    <a href="/dashboard/search" class="dashboard-nav-link">Search</a>
  </nav>

  <div class="filters">
    <select id="period-filter" class="filter-select">
      <option value="7">Last 7 days</option>
      <option value="30">Last 30 days</option>
      <option value="90">Last 90 days</option>
    </select>
  </div>

  <div class="dashboard-grid">
    <section class="dashboard-card full-width">
      <h2 class="card-title">Views Over Time</h2>
      <div class="chart-container" id="views-chart">
        <p class="empty-state">Loading chart...</p>
      </div>
    </section>

    <section class="dashboard-card">
      <h2 class="card-title">Top Pages</h2>
      <div id="top-pages-list">
        <p class="empty-state">Loading...</p>
      </div>
    </section>

    <section class="dashboard-card">
      <h2 class="card-title">Referrers</h2>
      <div id="referrers-list">
        <p class="empty-state">Loading...</p>
      </div>
    </section>

    <section class="dashboard-card">
      <h2 class="card-title">Device Types</h2>
      <div id="devices-list">
        <p class="empty-state">Loading...</p>
      </div>
    </section>

    <section class="dashboard-card">
      <h2 class="card-title">Browsers</h2>
      <div id="browsers-list">
        <p class="empty-state">Loading...</p>
      </div>
    </section>
  </div>
</DashboardLayout>

<style>
  .dashboard-header {
    margin-bottom: var(--space-8);
  }

  .dashboard-title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-2) 0;
  }

  .dashboard-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin: 0;
  }

  .dashboard-nav {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    padding: var(--space-2);
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    overflow-x: auto;
  }

  .dashboard-nav-link {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-secondary);
    white-space: nowrap;
    transition: all var(--duration-fast) var(--ease-default);
  }

  .dashboard-nav-link:hover {
    color: var(--text-primary);
    background: var(--bg-tertiary);
  }

  .dashboard-nav-link.active {
    color: var(--color-primary);
    background: var(--bg-primary);
    box-shadow: var(--shadow-sm);
  }

  .filters {
    margin-bottom: var(--space-6);
  }

  .filter-select {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-primary);
    color: var(--text-primary);
    font-size: var(--text-sm);
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .dashboard-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .dashboard-card.full-width {
    grid-column: 1 / -1;
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
    margin: 0 0 var(--space-4) 0;
  }

  .chart-container {
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .empty-state {
    color: var(--text-tertiary);
    font-size: var(--text-sm);
    text-align: center;
    padding: var(--space-4);
  }

  @media (max-width: 768px) {
    .dashboard-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  async function loadTrafficData() {
    const days = document.getElementById('period-filter').value;

    try {
      const response = await fetch(`/api/analytics/dashboard?days=${days}`);
      const data = await response.json();

      // Views over time
      const viewsByDay = data.traffic?.viewsByDay || [];
      const chartEl = document.getElementById('views-chart');

      if (viewsByDay.length === 0) {
        chartEl.innerHTML = '<p class="empty-state">No data available for this period</p>';
      } else {
        const maxViews = Math.max(...viewsByDay.map((d) => d.views));
        chartEl.innerHTML = `
          <div class="bar-chart">
            ${viewsByDay
              .map(
                (d) => `
              <div class="bar-wrapper">
                <div class="bar" style="height: ${(d.views / maxViews) * 100}%"></div>
                <span class="bar-label">${d.date.slice(5)}</span>
                <span class="bar-value">${d.views}</span>
              </div>
            `
              )
              .join('')}
          </div>
        `;
      }

      // Top pages
      const topPages = data.traffic?.viewsByPage || [];
      const topPagesEl = document.getElementById('top-pages-list');

      if (topPages.length === 0) {
        topPagesEl.innerHTML = '<p class="empty-state">No data available</p>';
      } else {
        topPagesEl.innerHTML = topPages
          .slice(0, 10)
          .map(
            (p) => `
          <div class="list-item">
            <span class="item-label">${p.page}</span>
            <span class="item-value">${p.views.toLocaleString()} views</span>
          </div>
        `
          )
          .join('');
      }
    } catch (error) {
      console.error('Failed to load traffic data:', error);
    }
  }

  document.getElementById('period-filter').addEventListener('change', loadTrafficData);
  loadTrafficData();
</script>
