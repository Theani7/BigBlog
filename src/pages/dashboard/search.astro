---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Search Analytics" description="Understand user search behavior">
  <header class="dashboard-header">
    <h1 class="dashboard-title">Search Analytics</h1>
    <p class="dashboard-subtitle">Optimize your search experience based on user behavior</p>
  </header>

  <nav class="dashboard-nav">
    <a href="/dashboard" class="dashboard-nav-link">Overview</a>
    <a href="/dashboard/traffic" class="dashboard-nav-link">Traffic</a>
    <a href="/dashboard/performance" class="dashboard-nav-link">Performance</a>
    <a href="/dashboard/errors" class="dashboard-nav-link">Errors</a>
    <a href="/dashboard/content" class="dashboard-nav-link">Content</a>
    <a href="/dashboard/search" class="dashboard-nav-link active">Search</a>
  </nav>

  <div class="filters">
    <select id="period-filter" class="filter-select">
      <option value="7">Last 7 days</option>
      <option value="30">Last 30 days</option>
      <option value="90">Last 90 days</option>
    </select>
  </div>

  <div class="dashboard-grid">
    <section class="dashboard-card">
      <h2 class="card-title">Search Overview</h2>
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-label">Total Queries</span>
          <span class="stat-value" id="total-queries">--</span>
        </div>
        <div class="stat-item">
          <span class="stat-label">Selection Rate</span>
          <span class="stat-value" id="selection-rate">--</span>
        </div>
      </div>
    </section>

    <section class="dashboard-card">
      <h2 class="card-title">Search Health</h2>
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-label">Queries with Results</span>
          <span class="stat-value" id="queries-with-results">--</span>
        </div>
        <div class="stat-item">
          <span class="stat-label">No Result Rate</span>
          <span class="stat-value" id="no-result-rate">--</span>
        </div>
      </div>
    </section>

    <section class="dashboard-card">
      <h2 class="card-title">Popular Searches</h2>
      <div id="popular-searches">
        <p class="empty-state">Loading...</p>
      </div>
    </section>

    <section class="dashboard-card">
      <h2 class="card-title">No Result Searches</h2>
      <p class="card-description">
        These searches returned no results - consider adding content for these topics
      </p>
      <div id="no-result-searches">
        <p class="empty-state">Loading...</p>
      </div>
    </section>

    <section class="dashboard-card full-width">
      <h2 class="card-title">Search Recommendations</h2>
      <div id="search-recommendations">
        <p class="empty-state">Analyzing search patterns...</p>
      </div>
    </section>
  </div>
</DashboardLayout>

<style>
  .dashboard-header {
    margin-bottom: var(--space-8);
  }

  .dashboard-title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-2) 0;
  }

  .dashboard-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin: 0;
  }

  .dashboard-nav {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    padding: var(--space-2);
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    overflow-x: auto;
  }

  .dashboard-nav-link {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-secondary);
    white-space: nowrap;
    transition: all var(--duration-fast) var(--ease-default);
  }

  .dashboard-nav-link:hover {
    color: var(--text-primary);
    background: var(--bg-tertiary);
  }

  .dashboard-nav-link.active {
    color: var(--color-primary);
    background: var(--bg-primary);
    box-shadow: var(--shadow-sm);
  }

  .filters {
    margin-bottom: var(--space-6);
  }

  .filter-select {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-primary);
    color: var(--text-primary);
    font-size: var(--text-sm);
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .dashboard-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .dashboard-card.full-width {
    grid-column: 1 / -1;
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
    margin: 0 0 var(--space-2) 0;
  }

  .card-description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0 0 var(--space-4) 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stat-label {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .stat-value {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
  }

  .empty-state {
    color: var(--text-tertiary);
    font-size: var(--text-sm);
    text-align: center;
    padding: var(--space-4);
  }

  .recommendation-item {
    padding: var(--space-3);
    background: var(--bg-secondary);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-2);
  }

  .recommendation-item p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .recommendation-item .priority {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: var(--space-1);
  }

  .recommendation-item .priority.high {
    color: #dc2626;
  }

  .recommendation-item .priority.medium {
    color: #d97706;
  }

  .recommendation-item .priority.low {
    color: #059669;
  }

  @media (max-width: 768px) {
    .dashboard-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  async function loadSearchData() {
    const days = document.getElementById('period-filter').value;

    try {
      const response = await fetch(`/api/analytics/dashboard?days=${days}`);
      const data = await response.json();

      const search = data.search || {};

      // Overview
      document.getElementById('total-queries').textContent =
        search.totalQueries?.toLocaleString() || '0';
      document.getElementById('selection-rate').textContent = search.selectionRate
        ? `${(search.selectionRate * 100).toFixed(1)}%`
        : '--';

      // Search health
      const popular = search.popularQueries || [];
      const noResults = search.noResultQueries || [];
      const totalWithResults = search.totalQueries - noResults.reduce((sum, r) => sum + r.count, 0);

      document.getElementById('queries-with-results').textContent =
        totalWithResults.toLocaleString();
      document.getElementById('no-result-rate').textContent =
        search.totalQueries > 0
          ? `${((noResults.reduce((sum, r) => sum + r.count, 0) / search.totalQueries) * 100).toFixed(1)}%`
          : '0%';

      // Popular searches
      const popularEl = document.getElementById('popular-searches');
      if (popular.length === 0) {
        popularEl.innerHTML = '<p class="empty-state">No searches recorded</p>';
      } else {
        popularEl.innerHTML = popular
          .slice(0, 10)
          .map(
            (s) => `
          <div class="list-item">
            <span class="item-label">${s.query}</span>
            <span class="item-value">${s.count}x</span>
          </div>
        `
          )
          .join('');
      }

      // No result searches
      const noResultEl = document.getElementById('no-result-searches');
      if (noResults.length === 0) {
        noResultEl.innerHTML = '<p class="empty-state">No failed searches - great job!</p>';
      } else {
        noResultEl.innerHTML = noResults
          .slice(0, 10)
          .map(
            (s) => `
          <div class="list-item">
            <span class="item-label">${s.query}</span>
            <span class="item-value">${s.count}x</span>
          </div>
        `
          )
          .join('');
      }

      // Recommendations
      const recsEl = document.getElementById('search-recommendations');
      const recommendations = [];

      if (noResults.length > 0) {
        recommendations.push({
          text: `Consider creating content for: "${noResults[0].query}" (${noResults[0].count} searches with no results)`,
          priority: 'high',
        });
      }

      if (search.selectionRate < 0.5 && search.totalQueries > 10) {
        recommendations.push({
          text: 'Low selection rate suggests search results may not match user intent. Consider improving search algorithm.',
          priority: 'medium',
        });
      }

      if (popular.length > 0) {
        recommendations.push({
          text: `Most popular search: "${popular[0].query}" - ensure this content is easily accessible.`,
          priority: 'low',
        });
      }

      if (recommendations.length === 0) {
        recsEl.innerHTML = '<p class="empty-state">No recommendations at this time</p>';
      } else {
        recsEl.innerHTML = recommendations
          .map(
            (r) => `
          <div class="recommendation-item">
            <p>${r.text}</p>
            <span class="priority ${r.priority}">${r.priority} priority</span>
          </div>
        `
          )
          .join('');
      }
    } catch (error) {
      console.error('Failed to load search data:', error);
    }
  }

  document.getElementById('period-filter').addEventListener('change', loadSearchData);
  loadSearchData();
</script>
