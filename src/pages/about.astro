---
import Layout from '../layouts/Layout.astro';
import AuthorCard from '../components/cards/AuthorCard.astro';
import { getCollection } from 'astro:content';
import { canonicalUrl } from '../lib/canonical';
import { breadcrumbSchema, organizationSchema } from '../lib/schema';

const pageTitle = 'About';
const pageDescription =
  'About BigBlog and our mission to empower developers through great writing.';

const authors = await getCollection('authors');

const pageCanonical = canonicalUrl('/about');

const breadcrumbs = [{ label: 'Home', href: '/' }, { label: 'About' }];

const structuredData = [organizationSchema(), breadcrumbSchema(breadcrumbs)];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <section class="about-page">
    <div class="container">
      <p class="page-eyebrow">Our Story</p>
      <h1 class="page-title">About BigBlog</h1>
      <p class="page-subtitle">
        We believe in the power of well-crafted writing for developers. BigBlog is a publishing
        platform built for developers who care about craft, clarity, and community.
      </p>

      <div class="about-content">
        <h2 class="section-title">Our Mission</h2>
        <p class="about-text">
          To empower developers to share their knowledge and experiences through well-crafted,
          accessible writing. We believe that great documentation and blog posts can change the way
          people build software.
        </p>

        <h2 class="section-title">Values</h2>
        <ul class="values-list">
          <li class="value-item">
            <span class="value-icon" aria-hidden="true">◆</span>
            <span>Craftsmanship — every post deserves care and precision</span>
          </li>
          <li class="value-item">
            <span class="value-icon" aria-hidden="true">◆</span>
            <span>Accessibility — writing for everyone, regardless of ability</span>
          </li>
          <li class="value-item">
            <span class="value-icon" aria-hidden="true">◆</span>
            <span>Community — learning together is better than learning alone</span>
          </li>
          <li class="value-item">
            <span class="value-icon" aria-hidden="true">◆</span>
            <span>Clarity — if it can't be explained simply, it isn't understood</span>
          </li>
        </ul>

        <h2 class="section-title">Skills</h2>
        <div class="skills-grid">
          <span class="skill-chip">Astro</span>
          <span class="skill-chip">TypeScript</span>
          <span class="skill-chip">Tailwind CSS</span>
          <span class="skill-chip">Content Collections</span>
          <span class="skill-chip">MDX</span>
          <span class="skill-chip">Static Generation</span>
        </div>

        <h2 class="section-title">Experience</h2>
        <div class="timeline">
          <div class="timeline-item">
            <span class="timeline-date">2024 — Present</span>
            <span class="timeline-role">BigBlog Founder</span>
            <span class="timeline-desc">Building a premium developer publishing platform.</span>
          </div>
          <div class="timeline-item">
            <span class="timeline-date">2022 — 2024</span>
            <span class="timeline-role">Senior Engineer</span>
            <span class="timeline-desc">Building developer tools and documentation at scale.</span>
          </div>
          <div class="timeline-item">
            <span class="timeline-date">2020 — 2022</span>
            <span class="timeline-role">Software Engineer</span>
            <span class="timeline-desc">Full-stack development and open source contributions.</span>
          </div>
        </div>

        <h2 class="section-title">Technology Stack</h2>
        <div class="stack-grid">
          <span class="stack-chip">Astro 7</span>
          <span class="stack-chip">TypeScript</span>
          <span class="stack-chip">Tailwind CSS v4</span>
          <span class="stack-chip">Vercel</span>
          <span class="stack-chip">MDX</span>
          <span class="stack-chip">Lucide Icons</span>
        </div>

        <h2 class="section-title">Our Team</h2>
        <div class="team-grid">
          {
            authors.map((author) => (
              <AuthorCard
                name={author.data.name}
                slug={author.slug}
                bio={author.data.bio}
                avatar={author.data.avatar}
                twitter={author.data.twitter}
                github={author.data.github}
                linkedin={author.data.linkedin}
                website={author.data.website}
              />
            ))
          }
        </div>

        <h2 class="section-title">Speaking &amp; Writing</h2>
        <p class="about-text">
          Regular speaker at developer conferences and contributor to technical publications.
          Content coming soon.
        </p>

        <div class="contact-cta">
          <h3 class="cta-title">Get in Touch</h3>
          <p class="cta-desc">Have a question or want to collaborate? Reach out.</p>
          <a href="/contact" class="btn btn-primary">Contact Us</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-page {
    padding: 5rem 0 6rem;
  }

  .page-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .page-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-4);
  }

  .page-subtitle {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    max-width: 32rem;
    margin: 0 0 var(--space-8);
  }

  .about-content {
    max-width: 48rem;
  }

  .section-title {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    margin: var(--space-8) 0 var(--space-4);
  }

  .about-text {
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-4);
  }

  .values-list {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .value-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-base);
    color: var(--text-primary);
    line-height: var(--leading-relaxed);
  }

  .value-icon {
    color: var(--color-primary);
    font-size: var(--text-sm);
    margin-top: 0.25em;
    flex-shrink: 0;
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .skill-chip {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background: var(--bg-tertiary);
    color: var(--text-primary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    border-radius: var(--radius-full);
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .timeline-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-primary);
  }

  .timeline-date {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    font-weight: var(--weight-semibold);
  }

  .timeline-role {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
  }

  .timeline-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .stack-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .stack-chip {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background: var(--accent-soft);
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    border-radius: var(--radius-full);
  }

  .team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-4);
  }

  .contact-cta {
    margin-top: var(--space-8);
    padding: var(--space-6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
    text-align: center;
  }

  .cta-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    margin: 0 0 var(--space-2);
  }

  .cta-desc {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-4);
  }

  @media (min-width: 768px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
