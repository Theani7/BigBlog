---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { getPostsByAuthor, filterDrafts, getSeries } from '../../lib/content';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((author) => ({
    params: { slug: author.slug ?? author.data.name.toLowerCase().replace(/\s+/g, '-') },
    props: {
      name: author.data.name,
      bio: author.data.bio,
      avatar: author.data.avatar,
      twitter: author.data.twitter,
      github: author.data.github,
      linkedin: author.data.linkedin,
      website: author.data.website,
    },
  }));
}

const { name, bio, avatar, twitter, github, linkedin, website } = Astro.props;
const allPosts = await getCollection('blog');
const publishedPosts = filterDrafts(allPosts);
const authorPosts = getPostsByAuthor(allPosts, name);
const featuredPosts = authorPosts.filter((p) => p.data.featured);

const authorSeries = [
  ...new Set(authorPosts.filter((p) => p.data.series).map((p) => p.data.series)),
];

const allTags = [...new Set(authorPosts.flatMap((p) => p.data.tags))];
const tagCounts = allTags
  .map((tag) => ({
    name: tag,
    count: authorPosts.filter((p) => p.data.tags.includes(tag)).length,
  }))
  .sort((a, b) => b.count - a.count);

const totalWords = authorPosts.reduce((acc, p) => acc + (p.body?.split(/\s+/).length || 0), 0);
const totalReadingTime = Math.max(1, Math.round(totalWords / 200));

const pageTitle = `${name} — Author`;
const pageDescription = bio || `Articles by ${name}.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={`https://bigblog.dev/author/${name.toLowerCase().replace(/\s+/g, '-')}`}
>
  <section class="author-page">
    <div class="container">
      <div class="author-header">
        <div class="author-avatar">
          {
            avatar ? (
              <img src={avatar} alt={name} class="author-avatar-img" />
            ) : (
              <div class="author-avatar-initials">
                {name
                  .split(' ')
                  .map((n) => n[0])
                  .join('')
                  .slice(0, 2)}
              </div>
            )
          }
        </div>
        <div class="author-info">
          <p class="page-eyebrow">Author</p>
          <h1 class="page-title">{name}</h1>
          {bio && <p class="author-bio">{bio}</p>}

          <div class="author-social">
            {
              twitter && (
                <a
                  href={`https://twitter.com/${twitter}`}
                  class="author-social-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z" />
                  </svg>
                  Twitter
                </a>
              )
            }
            {
              github && (
                <a
                  href={`https://github.com/${github}`}
                  class="author-social-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                  </svg>
                  GitHub
                </a>
              )
            }
            {
              linkedin && (
                <a
                  href={`https://linkedin.com/in/${linkedin}`}
                  class="author-social-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <>
                      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                      <rect x="2" y="9" width="4" height="12" />
                      <circle cx="4" cy="4" r="2" />
                    </>
                  </svg>
                  LinkedIn
                </a>
              )
            }
            {
              website && (
                <a
                  href={website}
                  class="author-social-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <>
                      <circle cx="12" cy="12" r="10" />
                      <line x1="2" y1="12" x2="22" y2="12" />
                      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                    </>
                  </svg>
                  Website
                </a>
              )
            }
          </div>
        </div>
      </div>

      <div class="author-stats">
        <div class="stat">
          <span class="stat-value">{authorPosts.length}</span>
          <span class="stat-label">Articles</span>
        </div>
        <div class="stat">
          <span class="stat-value">{authorSeries.length}</span>
          <span class="stat-label">Series</span>
        </div>
        <div class="stat">
          <span class="stat-value">~{totalReadingTime}</span>
          <span class="stat-label">Total min read</span>
        </div>
        <div class="stat">
          <span class="stat-value">{allTags.length}</span>
          <span class="stat-label">Topics</span>
        </div>
      </div>

      <div class="author-layout">
        <div class="author-main">
          {
            featuredPosts.length > 0 && (
              <section class="author-featured" aria-label="Featured articles">
                <h2 class="section-label">Featured</h2>
                <div class="featured-grid">
                  {featuredPosts.slice(0, 2).map((post) => (
                    <ArticleCard post={post} />
                  ))}
                </div>
              </section>
            )
          }

          <section class="author-articles" aria-label="All articles">
            <h2 class="section-label">All Articles</h2>
            {
              authorPosts.length > 0 ? (
                <div class="article-grid">
                  {authorPosts.map((post) => (
                    <ArticleCard post={post} />
                  ))}
                </div>
              ) : (
                <div class="empty-state">
                  <p>No articles by this author yet.</p>
                  <a href="/blog" class="empty-state-link">
                    Browse all articles
                  </a>
                </div>
              )
            }
          </section>
        </div>

        <aside class="author-sidebar" aria-label="Author sidebar">
          {
            tagCounts.length > 0 && (
              <section class="sidebar-section">
                <h3 class="sidebar-heading">Topics</h3>
                <div class="sidebar-tags">
                  {tagCounts.slice(0, 10).map((tag) => (
                    <a href={`/tag/${tag.name.toLowerCase()}`} class="sidebar-tag">
                      <span class="sidebar-tag-name">{tag.name}</span>
                      <span class="sidebar-tag-count">{tag.count}</span>
                    </a>
                  ))}
                </div>
              </section>
            )
          }

          {
            authorSeries.length > 0 && (
              <section class="sidebar-section">
                <h3 class="sidebar-heading">Series</h3>
                <div class="sidebar-links">
                  {authorSeries.map((series) => (
                    <a
                      href={`/series/${series.toLowerCase().replace(/\s+/g, '-')}`}
                      class="sidebar-link"
                    >
                      {series}
                    </a>
                  ))}
                </div>
              </section>
            )
          }
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .author-page {
    padding: 5rem 0 6rem;
  }

  .author-header {
    display: flex;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
    align-items: flex-start;
  }

  .author-avatar {
    flex-shrink: 0;
  }

  .author-avatar-img {
    width: 5rem;
    height: 5rem;
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  .author-avatar-initials {
    width: 5rem;
    height: 5rem;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: var(--text-inverse);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
  }

  .author-info {
    flex: 1;
  }

  .page-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-3) 0;
  }

  .author-bio {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-4) 0;
    max-width: 40rem;
  }

  .author-social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .author-social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-default);
  }

  .author-social-link:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .author-stats {
    display: flex;
    gap: var(--space-8);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    margin-bottom: var(--space-8);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stat-value {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
  }

  .stat-label {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .author-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .section-label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: var(--space-6);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .article-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .empty-state {
    padding: var(--space-8) 0;
    text-align: center;
    color: var(--text-tertiary);
  }

  .empty-state-link {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--color-primary);
    font-weight: var(--weight-medium);
  }

  .author-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .sidebar-section {
    padding: var(--space-5);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
  }

  .sidebar-heading {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0 0 var(--space-4) 0;
  }

  .sidebar-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .sidebar-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    transition: all var(--duration-fast) var(--ease-default);
  }

  .sidebar-tag:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    text-decoration: none;
  }

  .sidebar-tag-count {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .sidebar-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .sidebar-link {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    padding: var(--space-2) 0;
    transition: color var(--duration-fast) var(--ease-default);
  }

  .sidebar-link:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .author-layout {
      grid-template-columns: 1fr 280px;
      align-items: start;
    }

    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .article-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .article-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .author-social-link,
    .sidebar-tag,
    .sidebar-link {
      transition: none;
    }
  }
</style>
