---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { getPostsByAuthor } from '../../lib/content';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((author) => ({
    params: { slug: author.slug ?? author.data.name.toLowerCase().replace(/\s+/g, '-') },
    props: { name: author.data.name },
  }));
}

const { name } = Astro.props;
const allPosts = await getCollection('blog');
const authorPosts = getPostsByAuthor(allPosts, name);
const pageTitle = `${name} — Author`;
const pageDescription = `Articles by ${name}.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={`https://bigblog.dev/author/${name.toLowerCase().replace(/\s+/g, '-')}`}
>
  <section class="author-page">
    <div class="container">
      <p class="page-eyebrow">Author</p>
      <h1 class="page-title">{name}</h1>
      <p class="page-subtitle">{authorPosts.length} article{authorPosts.length !== 1 ? 's' : ''}</p>

      {
        authorPosts.length > 0 ? (
          <div class="article-grid">
            {authorPosts.map((post) => (
              <ArticleCard post={post} />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>No articles by this author yet.</p>
          </div>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .author-page {
    padding: 5rem 0 6rem;
  }

  .page-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .page-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-4) 0;
  }

  .page-subtitle {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-8) 0;
  }

  .article-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .empty-state {
    padding: var(--space-8) 0;
    text-align: center;
    color: var(--text-tertiary);
  }

  @media (min-width: 768px) {
    .article-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .article-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
