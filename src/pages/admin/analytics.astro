---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createDatabase, type Env } from '../../db';
import { User } from '../../db/schema';
import { verifyAuthToken } from '../../lib/auth';

const env = (Astro.locals as { env: Env }).env;
if (!env) throw new Error('Environment not configured');
await createDatabase(env);

const token = Astro.cookies.get('auth_token')?.value;
let isAdmin = false;
if (token) {
  const payload = await verifyAuthToken(token, env);
  if (payload?.role === 'ADMIN' && payload?.userId) {
    const dbUser = await User.findById(payload.userId).lean();
    isAdmin = !!dbUser && dbUser.role === 'ADMIN' && !dbUser.suspended;
  }
}
if (!isAdmin) return Astro.redirect('/dashboard');
---

<AdminLayout title="Analytics - BigBlog" description="Platform analytics" activeNav="analytics">
  <header class="admin-page-head">
    <div>
      <h1 class="admin-page-title">Analytics</h1>
      <p class="admin-page-subtitle">Traffic, performance, errors, and search data.</p>
    </div>
    <div class="admin-range" role="group" aria-label="Date range">
      <button type="button" class="admin-range-btn" data-days="7">7d</button>
      <button type="button" class="admin-range-btn" data-days="30">30d</button>
      <button type="button" class="admin-range-btn" data-days="90">90d</button>
    </div>
  </header>

  <div class="admin-stats-grid" id="analytics-stat-grid" aria-busy="true">
    <div class="admin-stat">
      <div class="admin-stat-value">&hellip;</div><div class="admin-stat-label">Page views</div>
    </div>
    <div class="admin-stat">
      <div class="admin-stat-value">&hellip;</div><div class="admin-stat-label">
        Unique visitors
      </div>
    </div>
    <div class="admin-stat">
      <div class="admin-stat-value">&hellip;</div><div class="admin-stat-label">Search queries</div>
    </div>
    <div class="admin-stat">
      <div class="admin-stat-value">&hellip;</div><div class="admin-stat-label">Errors</div>
    </div>
  </div>

  <section class="admin-card admin-card--canvas">
    <h2 class="admin-card-title">Views per day</h2>
    <p class="admin-card-subtitle">Page views over the selected period.</p>
    <div class="admin-bar-chart" id="analytics-bar-chart" aria-hidden="true"></div>
    <div class="admin-chart-labels" id="analytics-bar-labels"></div>
  </section>

  <div class="admin-two-col">
    <section class="admin-card admin-card--canvas">
      <h2 class="admin-card-title">Top pages</h2>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead><tr><th>Page</th><th style="text-align:right;">Views</th></tr></thead>
          <tbody id="analytics-top-pages">
            <tr><td colspan="2" class="admin-muted">Loading&hellip;</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="admin-card admin-card--canvas">
      <h2 class="admin-card-title">Search queries</h2>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead><tr><th>Query</th><th style="text-align:right;">Count</th></tr></thead>
          <tbody id="analytics-search">
            <tr><td colspan="2" class="admin-muted">Loading&hellip;</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <div class="admin-two-col">
    <section class="admin-card admin-card--canvas">
      <h2 class="admin-card-title">Core Web Vitals</h2>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead
            ><tr
              ><th>Metric</th><th style="text-align:right;">Avg</th><th style="text-align:right;"
                >Samples</th
              ></tr
            ></thead
          >
          <tbody id="analytics-vitals">
            <tr><td colspan="3" class="admin-muted">Loading&hellip;</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="admin-card admin-card--canvas">
      <h2 class="admin-card-title">API latency</h2>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead
            ><tr
              ><th>Endpoint</th><th style="text-align:right;">Avg ms</th><th
                style="text-align:right;">Error %</th
              ></tr
            ></thead
          >
          <tbody id="analytics-api">
            <tr><td colspan="3" class="admin-muted">Loading&hellip;</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <section class="admin-card admin-card--canvas">
    <h2 class="admin-card-title">Recent errors</h2>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead><tr><th>Level</th><th>Message</th><th>Page</th><th>Time</th></tr></thead>
        <tbody id="analytics-errors">
          <tr><td colspan="4" class="admin-muted">Loading&hellip;</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</AdminLayout>

<script>
  interface AnalyticsData {
    traffic: {
      totalViews: number;
      uniqueVisitors: number;
      viewsByPage: Array<{ page: string; count: number }>;
      viewsByDay: Array<{ date: string; count: number }>;
    };
    performance: {
      coreWebVitals: Array<{ metric: string; avg: number; count: number }>;
    };
    errors: {
      total: number;
      recent: Array<{
        id: string;
        level: string;
        message: string;
        page: string;
        createdAt: string;
      }>;
    };
    search: {
      totalQueries: number;
      popularQueries: Array<{ query: string; count: number; noResult: boolean }>;
    };
    api: {
      latencyByEndpoint: Array<{
        endpoint: string;
        avgMs: number;
        count: number;
        errorRate: number;
      }>;
    };
  }

  let currentDays = 7;
  const rangeBtns = document.querySelectorAll('.admin-range-btn');

  function fmt(n: number): string {
    if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
    if (n >= 1000) return (n / 1000).toFixed(1) + 'k';
    return String(n);
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function fmtDate(iso: string): string {
    const d = new Date(iso);
    const diff = Date.now() - d.getTime();
    const mins = Math.floor(diff / 60000);
    if (mins < 1) return 'just now';
    if (mins < 60) return mins + 'm ago';
    const hours = Math.floor(mins / 60);
    if (hours < 24) return hours + 'h ago';
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

  function shortDate(date: string): string {
    const d = new Date(date + 'T00:00:00');
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

  function renderBarChart(viewsByDay: Array<{ date: string; count: number }>) {
    const chart = document.getElementById('analytics-bar-chart');
    const labels = document.getElementById('analytics-bar-labels');
    if (!chart) return;

    const max = Math.max(...viewsByDay.map((d) => d.count), 1);
    chart.innerHTML = viewsByDay
      .map((d) => {
        const h = Math.max((d.count / max) * 100, 2);
        return '<div class="admin-bar" style="height:' + h + '%;" title="' + d.count + '"></div>';
      })
      .join('');

    if (labels) {
      const step = Math.max(Math.floor(viewsByDay.length / 7), 1);
      labels.innerHTML = viewsByDay
        .map((d, i) =>
          i % step === 0 || i === viewsByDay.length - 1
            ? '<span class="admin-bar-label">' + shortDate(d.date) + '</span>'
            : '<span class="admin-bar-label"></span>'
        )
        .join('');
    }
  }

  async function loadAnalytics(days: number) {
    currentDays = days;
    rangeBtns.forEach((btn) => {
      btn.classList.toggle('admin-range-btn--active', Number(btn.dataset.days) === days);
    });

    const grid = document.getElementById('analytics-stat-grid');
    try {
      const res = await fetch('/api/analytics/dashboard?days=' + days);
      const json = await res.json();
      if (!json.success) throw new Error(json.error || 'Failed to load');

      const data: AnalyticsData = json.data;
      grid?.setAttribute('aria-busy', 'false');

      const stats: Array<[string, string]> = [
        [fmt(data.traffic.totalViews), 'Page views'],
        [fmt(data.traffic.uniqueVisitors), 'Unique visitors'],
        [fmt(data.search.totalQueries), 'Search queries'],
        [fmt(data.errors.total), 'Errors'],
      ];
      if (grid) {
        grid.innerHTML = stats
          .map(
            (s) =>
              '<div class="admin-stat"><div class="admin-stat-value">' +
              s[0] +
              '</div><div class="admin-stat-label">' +
              s[1] +
              '</div></div>'
          )
          .join('');
      }

      renderBarChart(data.traffic.viewsByDay);

      const topPages = document.getElementById('analytics-top-pages');
      if (topPages) {
        topPages.innerHTML = data.traffic.viewsByPage.length
          ? data.traffic.viewsByPage
              .map(
                (v) =>
                  '<tr><td class="admin-muted" style="max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' +
                  escapeHtml(v.page) +
                  '</td><td style="text-align:right;">' +
                  fmt(v.count) +
                  '</td></tr>'
              )
              .join('')
          : '<tr><td colspan="2" class="admin-muted">No page views yet.</td></tr>';
      }

      const searchEl = document.getElementById('analytics-search');
      if (searchEl) {
        searchEl.innerHTML = data.search.popularQueries.length
          ? data.search.popularQueries
              .map(
                (q) =>
                  '<tr><td>' +
                  escapeHtml(q.query) +
                  (q.noResult
                    ? ' <span class="admin-badge admin-badge--danger">no results</span>'
                    : '') +
                  '</td><td style="text-align:right;">' +
                  q.count +
                  '</td></tr>'
              )
              .join('')
          : '<tr><td colspan="2" class="admin-muted">No search queries yet.</td></tr>';
      }

      const vitalsEl = document.getElementById('analytics-vitals');
      if (vitalsEl) {
        vitalsEl.innerHTML = data.performance.coreWebVitals.length
          ? data.performance.coreWebVitals
              .map(
                (v) =>
                  '<tr><td>' +
                  escapeHtml(v.metric) +
                  '</td><td style="text-align:right;">' +
                  v.avg +
                  '</td><td style="text-align:right;" class="admin-muted">' +
                  v.count +
                  '</td></tr>'
              )
              .join('')
          : '<tr><td colspan="3" class="admin-muted">No performance data yet.</td></tr>';
      }

      const apiEl = document.getElementById('analytics-api');
      if (apiEl) {
        apiEl.innerHTML = data.api.latencyByEndpoint.length
          ? data.api.latencyByEndpoint
              .map(
                (l) =>
                  '<tr><td class="admin-muted" style="max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' +
                  escapeHtml(l.endpoint) +
                  '</td><td style="text-align:right;">' +
                  l.avgMs +
                  '</td><td style="text-align:right;">' +
                  l.errorRate +
                  '%</td></tr>'
              )
              .join('')
          : '<tr><td colspan="3" class="admin-muted">No API latency data yet.</td></tr>';
      }

      const errEl = document.getElementById('analytics-errors');
      if (errEl) {
        errEl.innerHTML = data.errors.recent.length
          ? data.errors.recent
              .map(
                (e) =>
                  '<tr><td>' +
                  '<span class="admin-badge admin-badge--danger">' +
                  escapeHtml(e.level) +
                  '</span></td><td>' +
                  escapeHtml(e.message.slice(0, 90)) +
                  '</td><td class="admin-muted">' +
                  escapeHtml(e.page || '-') +
                  '</td><td class="admin-muted">' +
                  fmtDate(e.createdAt) +
                  '</td></tr>'
              )
              .join('')
          : '<tr><td colspan="4" class="admin-muted">No errors recorded.</td></tr>';
      }
    } catch (err) {
      console.error('Analytics load failed:', err);
    }
  }

  rangeBtns.forEach((btn) => {
    btn.addEventListener('click', () => loadAnalytics(Number(btn.dataset.days) || 7));
  });

  loadAnalytics(7);
</script>

<style>
  .admin-range {
    display: flex;
    gap: 4px;
    padding: 3px;
    background: var(--bg-surface-soft, #f5f0e8);
    border-radius: var(--radius-md, 8px);
  }

  .admin-range-btn {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 13px;
    font-weight: 500;
    padding: 6px 12px;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: var(--color-muted, #6c6a64);
    cursor: pointer;
    transition:
      background 0.15s,
      color 0.15s;
  }

  .admin-range-btn--active {
    background: #ffffff;
    color: var(--color-ink, #141413);
    box-shadow: 0 1px 3px rgba(24, 23, 21, 0.12);
  }

  .admin-chart-labels {
    display: flex;
    gap: 4px;
    margin-top: 6px;
  }

  .admin-chart-labels .admin-bar-label {
    flex: 1;
  }

  .admin-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg, 24px);
    align-items: start;
  }

  @media (max-width: 768px) {
    .admin-two-col {
      grid-template-columns: 1fr;
    }
  }
</style>
