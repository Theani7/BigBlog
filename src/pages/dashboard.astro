---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/dashboard/Sidebar.astro';
---

<Layout title="Dashboard — BigBlog" description="Your personalized feed and writing dashboard.">
  <!-- Loading state shown while checking auth -->
  <div class="dashboard-loading" id="dashboard-loading">
    <div class="loading-spinner"></div>
    <p class="loading-text">Loading your dashboard...</p>
  </div>

  <!-- Main dashboard container (hidden until auth confirmed) -->
  <div class="dashboard" id="dashboard-main" style="display: none;">
    <!-- Left Sidebar -->
    <Sidebar activePage="home" />

    <!-- ═══════════════════════════════════════════════════════════════════
         CENTER FEED
         ═══════════════════════════════════════════════════════════════════ -->
    <main class="feed" id="main-feed">
      <!-- Feed Tabs -->
      <div class="feed-tabs">
        <button class="feed-tab feed-tab--active" data-tab="for-you">For you</button>
        <button class="feed-tab" data-tab="featured">Featured</button>
      </div>

      <!-- Feed Content -->
      <div class="feed-content" id="feed-content">
        <!-- Article Card 1 -->
        <article class="feed-card">
          <div class="feed-card-body">
            <div class="feed-card-author">
              <div
                class="feed-card-avatar"
                style="background: linear-gradient(135deg, #cc785c, #e8a55a);"
              >
                <span>LG</span>
              </div>
              <div class="feed-card-author-info">
                <span class="feed-card-author-name">Leo Godin</span>
                <span class="feed-card-date">Jul 28</span>
              </div>
            </div>
            <div class="feed-card-content-row">
              <div class="feed-card-text">
                <h2 class="feed-card-title">The Future of AI is Not What You Think</h2>
                <p class="feed-card-excerpt">
                  Exploring the nuances of artificial intelligence beyond the hype — what developers
                  and researchers actually see on the horizon.
                </p>
                <div class="feed-card-footer">
                  <div class="feed-card-meta">
                    <span class="feed-card-star">⭐</span>
                    <span class="feed-card-stat">6.1K</span>
                    <span class="feed-card-stat">💬 193</span>
                    <span class="feed-card-stat">🔄 147</span>
                  </div>
                  <div class="feed-card-actions">
                    <button class="feed-card-action" aria-label="Dismiss">
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        ><path
                          d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zm7-13h2.67A2.31 2.31 0 0 1 22 4v7a2.31 2.31 0 0 1-2.33 2H17"
                        ></path></svg
                      >
                    </button>
                    <button class="feed-card-action" aria-label="Save">
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        ><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg
                      >
                    </button>
                    <button class="feed-card-action" aria-label="More">
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        ><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"
                        ></circle><circle cx="5" cy="12" r="1"></circle></svg
                      >
                    </button>
                  </div>
                </div>
              </div>
              <div class="feed-card-thumbnail">
                <img
                  src="https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=400&q=80"
                  alt="AI visualization"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </article>

        <!-- Article Card 2 -->
        <article class="feed-card">
          <div class="feed-card-body">
            <div class="feed-card-author">
              <div
                class="feed-card-avatar"
                style="background: linear-gradient(135deg, #5db8a6, #3d8b7a);"
              >
                <span>DP</span>
              </div>
              <div class="feed-card-author-info">
                <span class="feed-card-source">In <strong>Books Are Our Superpower</strong> by</span
                >
                <span class="feed-card-author-name">Desiree Peralta</span>
                <span class="feed-card-verified">✓</span>
                <span class="feed-card-date">· Jul 25</span>
              </div>
            </div>
            <div class="feed-card-content-row">
              <div class="feed-card-text">
                <h2 class="feed-card-title">Building Resilient Distributed Systems</h2>
                <p class="feed-card-excerpt">
                  Lessons learned from scaling microservices at a major tech company — the patterns
                  that saved us.
                </p>
                <div class="feed-card-footer">
                  <div class="feed-card-meta">
                    <span class="feed-card-star">⭐</span>
                    <span class="feed-card-stat">12.1K</span>
                    <span class="feed-card-stat">💬 676</span>
                    <span class="feed-card-stat">🔄 580</span>
                  </div>
                  <div class="feed-card-actions">
                    <button class="feed-card-action" aria-label="Dismiss">
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        ><path
                          d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zm7-13h2.67A2.31 2.31 0 0 1 22 4v7a2.31 2.31 0 0 1-2.33 2H17"
                        ></path></svg
                      >
                    </button>
                    <button class="feed-card-action" aria-label="Save">
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        ><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg
                      >
                    </button>
                    <button class="feed-card-action" aria-label="More">
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        ><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"
                        ></circle><circle cx="5" cy="12" r="1"></circle></svg
                      >
                    </button>
                  </div>
                </div>
              </div>
              <div class="feed-card-thumbnail">
                <img
                  src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=400&q=80"
                  alt="Server infrastructure"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </article>

        <!-- Article Card 3 -->
        <article class="feed-card">
          <div class="feed-card-body">
            <div class="feed-card-note">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                ><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                ></path><polyline points="14 2 14 8 20 8"></polyline></svg
              >
              <span>Because you follow <strong>Technology</strong></span>
            </div>
            <div class="feed-card-author">
              <div
                class="feed-card-avatar"
                style="background: linear-gradient(135deg, #6366f1, #8b5cf6);"
              >
                <span>ML</span>
              </div>
              <div class="feed-card-author-info">
                <span class="feed-card-source">In <strong>The Daily Draft</strong> by</span>
                <span class="feed-card-author-name">Matt Lillywhite</span>
                <span class="feed-card-date">· Jul 22</span>
              </div>
            </div>
            <div class="feed-card-content-row">
              <div class="feed-card-text">
                <h2 class="feed-card-title">
                  I'll Instantly Know A Writer Used ChatGPT When I See This
                </h2>
                <p class="feed-card-excerpt">
                  It's pretty damn obvious now that I know what to look for.
                </p>
                <div class="feed-card-footer">
                  <div class="feed-card-meta">
                    <span class="feed-card-star">⭐</span>
                    <span class="feed-card-stat">17.1K</span>
                    <span class="feed-card-stat">💬 721</span>
                    <span class="feed-card-stat">🔄 201</span>
                  </div>
                  <div class="feed-card-actions">
                    <button class="feed-card-action" aria-label="Dismiss">
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        ><path
                          d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zm7-13h2.67A2.31 2.31 0 0 1 22 4v7a2.31 2.31 0 0 1-2.33 2H17"
                        ></path></svg
                      >
                    </button>
                    <button class="feed-card-action" aria-label="Save">
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        ><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg
                      >
                    </button>
                    <button class="feed-card-action" aria-label="More">
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        ><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"
                        ></circle><circle cx="5" cy="12" r="1"></circle></svg
                      >
                    </button>
                  </div>
                </div>
              </div>
              <div class="feed-card-thumbnail">
                <img
                  src="https://images.unsplash.com/photo-1504384308090-c894fdcc538d?auto=format&fit=crop&w=400&q=80"
                  alt="Writer at desk"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </article>

        <!-- Article Card 4 -->
        <article class="feed-card">
          <div class="feed-card-body">
            <div class="feed-card-author">
              <div
                class="feed-card-avatar"
                style="background: linear-gradient(135deg, #f59e0b, #d97706);"
              >
                <span>AS</span>
              </div>
              <div class="feed-card-author-info">
                <span class="feed-card-author-name">Anna Saraiva</span>
                <span class="feed-card-date">Jul 20</span>
              </div>
            </div>
            <div class="feed-card-content-row">
              <div class="feed-card-text">
                <h2 class="feed-card-title">The Psychology of Clean Code</h2>
                <p class="feed-card-excerpt">
                  Why readable code matters more than clever code — insights from cognitive science
                  applied to software engineering.
                </p>
                <div class="feed-card-footer">
                  <div class="feed-card-meta">
                    <span class="feed-card-star">⭐</span>
                    <span class="feed-card-stat">8.4K</span>
                    <span class="feed-card-stat">💬 312</span>
                    <span class="feed-card-stat">🔄 89</span>
                  </div>
                  <div class="feed-card-actions">
                    <button class="feed-card-action" aria-label="Dismiss">
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        ><path
                          d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zm7-13h2.67A2.31 2.31 0 0 1 22 4v7a2.31 2.31 0 0 1-2.33 2H17"
                        ></path></svg
                      >
                    </button>
                    <button class="feed-card-action" aria-label="Save">
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        ><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg
                      >
                    </button>
                    <button class="feed-card-action" aria-label="More">
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        ><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"
                        ></circle><circle cx="5" cy="12" r="1"></circle></svg
                      >
                    </button>
                  </div>
                </div>
              </div>
              <div class="feed-card-thumbnail">
                <img
                  src="https://images.unsplash.com/photo-1461749280684-dccba630e2f6?auto=format&fit=crop&w=400&q=80"
                  alt="Code on screen"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </article>
      </div>
    </main>

    <!-- ═══════════════════════════════════════════════════════════════════
         RIGHT SIDEBAR
         ═══════════════════════════════════════════════════════════════════ -->
    <aside class="right-sidebar" id="right-sidebar">
      <!-- Staff Picks -->
      <section class="staff-picks">
        <h3 class="right-sidebar-title">Staff Picks</h3>

        <div class="pick-item">
          <div class="pick-author">
            <div class="pick-avatar" style="background: linear-gradient(135deg, #10b981, #059669);">
              <span>AC</span>
            </div>
            <span class="pick-author-name">Admiral Cloudberg</span>
          </div>
          <a href="#" class="pick-title"
            >Reaping the Whirlwind | Inside the Architecture of Large-Scale Systems</a
          >
          <span class="pick-date">1d ago</span>
        </div>

        <div class="pick-item">
          <div class="pick-author">
            <div class="pick-avatar" style="background: linear-gradient(135deg, #8b5cf6, #6d28d9);">
              <span>AS</span>
            </div>
            <span class="pick-author-name">Anna Saraiva</span>
          </div>
          <a href="#" class="pick-title">Night(mare) at the Museum of Code</a>
          <span class="pick-date">Jul 20</span>
        </div>

        <div class="pick-item">
          <div class="pick-author">
            <div class="pick-avatar" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
              <span>JT</span>
            </div>
            <span class="pick-author-name">In <strong>Our Game</strong> by John Thorn</span>
          </div>
          <a href="#" class="pick-title">Engineering Culture: A Love Story</a>
          <span class="pick-date">Oct 7, 2025</span>
        </div>

        <a href="#" class="see-full-list">See the full list</a>
      </section>

      <!-- Recommended Topics -->
      <section class="recommended-topics">
        <h3 class="right-sidebar-title">Recommended topics</h3>
        <div class="topic-chips">
          <a href="#" class="topic-chip">Programming <span class="chip-plus">+</span></a>
          <a href="#" class="topic-chip">Self Improvement <span class="chip-plus">+</span></a>
          <a href="#" class="topic-chip">Writing <span class="chip-plus">+</span></a>
          <a href="#" class="topic-chip">Relationships <span class="chip-plus">+</span></a>
          <a href="#" class="topic-chip">Machine Learning <span class="chip-plus">+</span></a>
          <a href="#" class="topic-chip">Politics <span class="chip-plus">+</span></a>
          <a href="#" class="topic-chip">Cryptocurrency <span class="chip-plus">+</span></a>
        </div>
        <a href="#" class="see-more-topics">See more topics</a>
      </section>

      <!-- Admin Section (only visible to admins) -->
      <section class="admin-panel" id="admin-panel" style="display: none;">
        <h3 class="right-sidebar-title">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg
          >
          Admin Panel
        </h3>
        <div class="admin-links">
          <a href="#" class="admin-link">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              ><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle
                cx="9"
                cy="7"
                r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path
                d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
            >
            Manage Users
          </a>
          <a href="#" class="admin-link">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              ><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline
                points="14 2 14 8 20 8"></polyline></svg
            >
            Review Content
          </a>
          <a href="#" class="admin-link">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              ><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line
                x1="3"
                y1="9"
                x2="21"
                y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg
            >
            Site Settings
          </a>
          <a href="#" class="admin-link">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg
            >
            Analytics
          </a>
        </div>
      </section>
    </aside>
  </div>
</Layout>

<script>
  // ═══════════════════════════════════════════════════════════════════
  // Authentication & Dashboard Logic
  // ═══════════════════════════════════════════════════════════════════
  interface DashboardUser {
    id: string;
    email: string;
    name?: string;
    role: 'ADMIN' | 'AUTHOR';
  }

  async function initDashboard() {
    const loading = document.getElementById('dashboard-loading');
    const dashboard = document.getElementById('dashboard-main');

    try {
      const res = await fetch('/api/auth/me');
      const data = await res.json();

      if (!data.success || !data.user) {
        // Not authenticated — redirect to home
        window.location.href = '/';
        return;
      }

      const user: DashboardUser = data.user;

      // Show dashboard
      if (loading) loading.style.display = 'none';
      if (dashboard) dashboard.style.display = 'grid';

      // Show admin panel if user is ADMIN
      if (user.role === 'ADMIN') {
        const adminPanel = document.getElementById('admin-panel');
        if (adminPanel) adminPanel.style.display = 'block';
      }

      // Set user info in the header (update the auth links)
      updateHeaderForLoggedInUser(user);
    } catch (err) {
      console.error('Dashboard auth check failed:', err);
      window.location.href = '/';
    }
  }

  function updateHeaderForLoggedInUser(user: DashboardUser) {
    const authLinks = document.querySelector('.auth-links');
    if (!authLinks) return;

    const displayName = user.name || user.email.split('@')[0];
    const initials = displayName
      .split(' ')
      .map((n: string) => n[0])
      .join('')
      .toUpperCase()
      .slice(0, 2);

    authLinks.innerHTML = `
      <a href="/write" class="nav-link dashboard-write-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
        </svg>
        Write
      </a>
      <button class="dashboard-notification-btn" aria-label="Notifications">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
      </button>
      <div class="dashboard-user-menu">
        <button class="dashboard-avatar-btn" aria-label="User menu" aria-expanded="false">
          <div class="dashboard-avatar">${initials}</div>
        </button>
        <div class="dashboard-dropdown" id="user-dropdown">
          <div class="dropdown-header">
            <span class="dropdown-user-name">${displayName}</span>
            <span class="dropdown-user-email">${user.email}</span>
            <span class="dropdown-user-role">${user.role}</span>
          </div>
          <div class="dropdown-divider"></div>
          <a href="/write" class="dropdown-link">Write a story</a>
          <a href="#" class="dropdown-link">Stories</a>
          <a href="#" class="dropdown-link">Stats</a>
          <div class="dropdown-divider"></div>
          <a href="#" class="dropdown-link">Settings</a>
          <button class="dropdown-link dropdown-logout" id="dashboard-logout-btn">Sign out</button>
        </div>
      </div>
    `;

    // Setup dropdown toggle
    const avatarBtn = document.querySelector('.dashboard-avatar-btn');
    const dropdown = document.getElementById('user-dropdown');

    avatarBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = dropdown?.classList.contains('is-open');
      dropdown?.classList.toggle('is-open');
      avatarBtn?.setAttribute('aria-expanded', String(!isOpen));
    });

    document.addEventListener('click', () => {
      dropdown?.classList.remove('is-open');
      avatarBtn?.setAttribute('aria-expanded', 'false');
    });

    // Logout handler
    document.getElementById('dashboard-logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/';
    });
  }

  // Feed tab switching
  document.querySelectorAll('.feed-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.feed-tab').forEach((t) => t.classList.remove('feed-tab--active'));
      tab.classList.add('feed-tab--active');
    });
  });

  // Sidebar active link
  document.querySelectorAll('.sidebar-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      // Don't prevent default for actual navigation, just for hash links
      if (link.getAttribute('href') === '#') {
        e.preventDefault();
      }
      document
        .querySelectorAll('.sidebar-link')
        .forEach((l) => l.classList.remove('sidebar-link--active'));
      link.classList.add('sidebar-link--active');
    });
  });

  // Init
  if (typeof window !== 'undefined') {
    initDashboard();
  }
</script>

<style>
  /* ═══════════════════════════════════════════════════════════════════
     LOADING STATE
     ═══════════════════════════════════════════════════════════════════ */
  .dashboard-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--header-height));
    gap: var(--space-md);
  }

  .loading-spinner {
    width: 32px;
    height: 32px;
