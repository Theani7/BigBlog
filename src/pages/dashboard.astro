---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/dashboard/Sidebar.astro';
import Feed from '../components/dashboard/Feed.astro';
import RightSidebar from '../components/dashboard/RightSidebar.astro';
import { createDatabase, type Env } from '../db';
import { Story } from '../db/schema';
import type { StorySummary } from '../types/content';

// Auth is verified in middleware; no client-side /api/auth/me round trip.
const user = (Astro.locals as { user?: { id: string; email: string; name?: string; role: string } })
  .user;
if (!user) {
  return Astro.redirect('/login?redirect=/dashboard');
}

const env = (Astro.locals as { env: Env }).env;
let publishedStories: StorySummary[] = [];
if (env) {
  try {
    await createDatabase(env);
    publishedStories = (await Story.find({ status: 'PUBLISHED' })
      .populate('authorId', 'name avatar')
      .sort({ publishedAt: -1 })) as unknown as StorySummary[];
  } catch (error) {
    console.error('Failed to load published stories for dashboard feed:', error);
  }
}
---

<Layout title="Dashboard — BigBlog" description="Your personalized feed and writing dashboard.">
  <meta name="dashboard-user" content={JSON.stringify({ role: user.role })} />
  <!-- Loading state shown while scripts initialize -->
  <div class="dashboard-loading" id="dashboard-loading">
    <div class="loading-spinner"></div>
    <p class="loading-text">Loading your dashboard...</p>
  </div>

  <!-- Main dashboard container (hidden until auth confirmed) -->
  <div class="dashboard" id="dashboard-main" style="display: none;">
    <!-- Left Sidebar -->
    <Sidebar activePage="home" />

    <Feed publishedStories={publishedStories} />
    <RightSidebar />
  </div>
</Layout>

<script>
  // ═══════════════════════════════════════════════════════════════════
  // Dashboard Logic — auth is already verified server-side; this script
  // only reveals the (already-authenticated) UI.
  // ═══════════════════════════════════════════════════════════════════
  function initDashboard() {
    const loading = document.getElementById('dashboard-loading');
    const dashboard = document.getElementById('dashboard-main');

    const meta = document.querySelector<HTMLMetaElement>('meta[name="dashboard-user"]');
    let role = 'AUTHOR';
    if (meta) {
      try {
        role = (JSON.parse(meta.content) as { role?: string }).role || 'AUTHOR';
      } catch {
        /* malformed meta, default to AUTHOR */
      }
    }

    if (loading) loading.style.display = 'none';
    if (dashboard) dashboard.style.display = 'grid';

    // Show admin panel if user is ADMIN
    if (role === 'ADMIN') {
      const adminPanel = document.getElementById('admin-panel');
      if (adminPanel) adminPanel.style.display = 'block';
    }
  }

  // Feed tab switching
  document.querySelectorAll('.feed-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.feed-tab').forEach((t) => t.classList.remove('feed-tab--active'));
      tab.classList.add('feed-tab--active');
    });
  });

  // Sidebar active link
  document.querySelectorAll('.sidebar-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      // Don't prevent default for actual navigation, just for hash links
      if (link.getAttribute('href') === '#') {
        e.preventDefault();
      }
      document
        .querySelectorAll('.sidebar-link')
        .forEach((l) => l.classList.remove('sidebar-link--active'));
      link.classList.add('sidebar-link--active');
    });
  });

  document.addEventListener('astro:page-load', () => {
    if (document.getElementById('dashboard-loading')) {
      initDashboard();
    }
  });
</script>

<style>
  /* ═══════════════════════════════════════════════════════════════════
     LOADING STATE
     ═══════════════════════════════════════════════════════════════════ */
  .dashboard-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--header-height));
    gap: var(--space-md);
  }

  .loading-spinner {
    width: 32px;
    height: 32px;
    border: 2px solid var(--color-hairline);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .loading-text {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-muted);
  }

  /* ═══════════════════════════════════════════════════════════════════
     DASHBOARD GRID
     ═══════════════════════════════════════════════════════════════════ */
  .dashboard {
    display: grid;
    grid-template-columns: 240px 1fr 340px;
    min-height: calc(100vh - var(--header-height));
    max-width: 100%;
    margin: 0 auto;
  }

  /* ═══════════════════════════════════════════════════════════════════
     LEFT SIDEBAR
     ═══════════════════════════════════════════════════════════════════ */
  .sidebar {
    position: sticky;
    top: var(--header-height);
    height: calc(100vh - var(--header-height));
    overflow-y: auto;
    padding: var(--space-lg) var(--space-lg) var(--space-lg) var(--space-md);
    border-right: 1px solid var(--color-hairline);
  }

  .sidebar::-webkit-scrollbar {
    width: 0;
  }

  .sidebar-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: 10px 12px;
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-body);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: all var(--duration-fast) var(--ease-default);
    font-weight: 400;
  }

  .sidebar-link:hover {
    background: var(--bg-surface-soft);
    color: var(--color-ink);
    text-decoration: none;
  }

  .sidebar-link--active {
    color: var(--color-ink);
    font-weight: 500;
  }

  .sidebar-link svg {
    flex-shrink: 0;
    opacity: 0.7;
  }

  .sidebar-link--active svg {
    opacity: 1;
  }

  .sidebar-divider {
    height: 1px;
    background: var(--color-hairline);
    margin: var(--space-lg) 0;
  }

  .sidebar-section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 12px;
    margin-bottom: var(--space-sm);
  }

  .sidebar-section-title {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: var(--color-ink);
  }

  .sidebar-section-gear {
    background: none;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    padding: 4px;
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast);
  }

  .sidebar-section-gear:hover {
    color: var(--color-ink);
  }

  .sidebar-sub-section {
    margin-top: var(--space-md);
    padding: 0 12px;
  }

  .sidebar-sub-title {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
    text-transform: none;
    margin-bottom: var(--space-xs);
    font-weight: 400;
  }

  .sidebar-topic-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar-topic-link {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 6px 0;
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-body);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .sidebar-topic-link:hover {
    color: var(--color-ink);
    text-decoration: none;
  }

  .sidebar-topic-link svg {
    opacity: 0.4;
    flex-shrink: 0;
  }

  /* ═══════════════════════════════════════════════════════════════════
     HEADER OVERRIDES FOR LOGGED-IN STATE
     ═══════════════════════════════════════════════════════════════════ */
  :global(.dashboard-write-btn) {
    display: inline-flex !important;
    align-items: center;
    gap: 6px;
    font-weight: 400 !important;
    color: var(--color-body) !important;
  }

  :global(.dashboard-write-btn:hover) {
    color: var(--color-ink) !important;
    text-decoration: none !important;
  }

  :global(.dashboard-notification-btn) {
    background: none;
    border: none;
    color: var(--color-body);
    cursor: pointer;
    padding: 6px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color var(--duration-fast);
  }

  :global(.dashboard-notification-btn:hover) {
    color: var(--color-ink);
  }

  :global(.dashboard-user-menu) {
    position: relative;
  }

  :global(.dashboard-avatar-btn) {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  :global(.dashboard-avatar) {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent-amber));
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    color: white;
    transition: opacity var(--duration-fast);
  }

  :global(.dashboard-avatar-btn:hover .dashboard-avatar) {
    opacity: 0.85;
  }

  :global(.dashboard-dropdown) {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 220px;
    background: var(--bg-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: all var(--duration-fast) var(--ease-default);
    z-index: var(--z-dropdown);
    overflow: hidden;
  }

  :global(.dashboard-dropdown.is-open) {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  :global(.dropdown-header) {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  :global(.dropdown-user-name) {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: var(--color-ink);
  }

  :global(.dropdown-user-email) {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
  }

  :global(.dropdown-user-role) {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-primary);
    background: rgba(30, 16, 51, 0.1);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
    margin-top: 4px;
    width: fit-content;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  :global(.dropdown-divider) {
    height: 1px;
    background: var(--color-hairline);
  }

  :global(.dropdown-link) {
    display: block;
    width: 100%;
    text-align: left;
    padding: 10px var(--space-md);
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-body);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    transition: background var(--duration-fast);
  }

  :global(.dropdown-link:hover) {
    background: var(--bg-surface-soft);
    color: var(--color-ink);
    text-decoration: none;
  }

  :global(.dropdown-logout) {
    color: var(--color-error);
  }

  /* ═══════════════════════════════════════════════════════════════════
     RESPONSIVE
     ═══════════════════════════════════════════════════════════════════ */
  @media (max-width: 1100px) {
    .dashboard {
      grid-template-columns: 240px 1fr;
    }

    .right-sidebar {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .dashboard {
      grid-template-columns: 1fr;
    }

    .sidebar {
      display: none;
    }

    .feed {
      padding: 0 var(--space-md);
      border-right: none;
    }

    .feed-card-thumbnail {
      width: 80px;
      height: 80px;
    }

    .feed-card-title {
      font-size: 1.1rem;
    }
  }

  /* ═══════════════════════════════════════════════════════════════════
     SECTION EYEBROW (shared)
     ═══════════════════════════════════════════════════════════════════ */
  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: var(--space-xs);
  }

  .section-eyebrow--on-dark {
    color: var(--color-on-dark-soft);
  }

  .section-heading--on-dark {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3vw, 2.5rem);
    color: var(--color-on-dark);
    margin-bottom: var(--space-md);
  }
</style>
