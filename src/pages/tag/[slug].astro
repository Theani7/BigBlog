---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { getPostsByTag } from '../../lib/content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags))].sort();
  return allTags.map((tag) => ({
    params: { slug: tag.toLowerCase() },
    props: { label: tag },
  }));
}

const { label } = Astro.props;
const allPosts = await getCollection('blog');
const tagPosts = getPostsByTag(allPosts, label);
const pageTitle = `${label} — Tag`;
const pageDescription = `Articles tagged with ${label}.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={`https://bigblog.dev/tag/${label.toLowerCase()}`}
>
  <section class="tag-page">
    <div class="container">
      <p class="page-eyebrow">Tag</p>
      <h1 class="page-title">{label}</h1>
      <p class="page-subtitle">{tagPosts.length} article{tagPosts.length !== 1 ? 's' : ''}</p>

      {
        tagPosts.length > 0 ? (
          <div class="article-grid">
            {tagPosts.map((post) => (
              <ArticleCard post={post} />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>No articles with this tag yet.</p>
          </div>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .tag-page {
    padding: 5rem 0 6rem;
  }

  .page-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .page-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-4) 0;
  }

  .page-subtitle {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-8) 0;
  }

  .article-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .empty-state {
    padding: var(--space-8) 0;
    text-align: center;
    color: var(--text-tertiary);
  }

  @media (min-width: 768px) {
    .article-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .article-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
