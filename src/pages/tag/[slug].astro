---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { getPostsByTag, filterDrafts } from '../../lib/content';
import { tagCanonical } from '../../lib/canonical';
import { breadcrumbSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags))].sort();
  return allTags.map((tag) => ({
    params: { slug: tag.toLowerCase() },
    props: { label: tag },
  }));
}

const { label } = Astro.props;
const allPosts = await getCollection('blog');
const publishedPosts = filterDrafts(allPosts);
const tagPosts = getPostsByTag(allPosts, label);
const newestPosts = [...tagPosts].sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const allTags = [...new Set(publishedPosts.flatMap((p) => p.data.tags))].sort();
const tagCounts = allTags
  .map((tag) => ({
    name: tag,
    count: publishedPosts.filter((p) => p.data.tags.includes(tag)).length,
  }))
  .sort((a, b) => b.count - a.count);

const relatedTags = tagCounts
  .filter((t) => t.name.toLowerCase() !== label.toLowerCase())
  .slice(0, 12);

const pageTitle = `${label} — Tag`;
const pageDescription = `Articles tagged with ${label}.`;
const pageCanonical = tagCanonical(label);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tags', href: '/blog' },
  { label: `#${label}` },
];

const structuredData = breadcrumbSchema(breadcrumbs);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <section class="tag-page">
    <div class="container">
      <div class="tag-header">
        <p class="page-eyebrow">Tag</p>
        <h1 class="page-title">#{label}</h1>
        <p class="page-subtitle">{tagPosts.length} article{tagPosts.length !== 1 ? 's' : ''}</p>
      </div>

      <div class="tag-layout">
        <div class="tag-main">
          <section class="tag-articles" aria-label="Articles with this tag">
            {
              tagPosts.length > 0 ? (
                <div class="article-grid">
                  {tagPosts.map((post) => (
                    <ArticleCard post={post} />
                  ))}
                </div>
              ) : (
                <div class="empty-state">
                  <p>No articles with this tag yet.</p>
                  <a href="/blog" class="empty-state-link">
                    Browse all articles
                  </a>
                </div>
              )
            }
          </section>
        </div>

        <aside class="tag-sidebar" aria-label="Tag sidebar">
          {
            relatedTags.length > 0 && (
              <section class="sidebar-section">
                <h3 class="sidebar-heading">Related Tags</h3>
                <div class="sidebar-tags">
                  {relatedTags.map((tag) => (
                    <a href={`/tag/${tag.name.toLowerCase()}`} class="sidebar-tag">
                      <span class="sidebar-tag-name">#{tag.name}</span>
                      <span class="sidebar-tag-count">{tag.count}</span>
                    </a>
                  ))}
                </div>
              </section>
            )
          }

          <section class="sidebar-section">
            <h3 class="sidebar-heading">Browse by Category</h3>
            <div class="sidebar-links">
              {
                [...new Set(publishedPosts.map((p) => p.data.category))].sort().map((cat) => (
                  <a href={`/category/${cat.toLowerCase()}`} class="sidebar-link">
                    {cat}
                  </a>
                ))
              }
            </div>
          </section>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .tag-page {
    padding: 5rem 0 6rem;
  }

  .tag-header {
    margin-bottom: var(--space-8);
  }

  .page-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .page-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-3) 0;
    color: var(--color-primary);
  }

  .page-subtitle {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .tag-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .article-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .empty-state {
    padding: var(--space-8) 0;
    text-align: center;
    color: var(--text-tertiary);
  }

  .empty-state-link {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--color-primary);
    font-weight: var(--weight-medium);
  }

  .tag-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .sidebar-section {
    padding: var(--space-5);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
  }

  .sidebar-heading {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0 0 var(--space-4) 0;
  }

  .sidebar-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .sidebar-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    transition: all var(--duration-fast) var(--ease-default);
  }

  .sidebar-tag:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    text-decoration: none;
  }

  .sidebar-tag-count {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .sidebar-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .sidebar-link {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    padding: var(--space-2) 0;
    transition: color var(--duration-fast) var(--ease-default);
  }

  .sidebar-link:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .tag-layout {
      grid-template-columns: 1fr 280px;
      align-items: start;
    }

    .article-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .article-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-tag,
    .sidebar-link {
      transition: none;
    }
  }
</style>
