---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Write a Blog — BigBlog" description="Publish your thoughts to the world.">
  <!-- Load Quill.js CSS (Bubble theme for a Medium-like popup toolbar) -->
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.bubble.css" rel="stylesheet" />

  <div class="write-layout">
    <div class="write-toolbar">
      <div class="toolbar-left">
        <span class="draft-status" id="draft-status">Draft in progress</span>
        <span class="word-count" id="word-count">0 words &bull; 0 min read</span>
      </div>
      <div class="toolbar-right">
        <button class="btn btn-secondary btn-sm" id="save-draft-btn">Save Draft</button>
        <button class="btn btn-primary btn-sm" id="publish-btn">Publish</button>
      </div>
    </div>

    <div class="write-container" id="editor-container" style="display: none;">
      <div class="cover-image-container" id="cover-image-container">
        <button class="add-cover-btn" id="add-cover-btn" type="button">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            ><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle
              cx="8.5"
              cy="8.5"
              r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg
          >
          Add cover image
        </button>
        <img id="cover-image-preview" src="" alt="Cover Preview" style="display: none;" />
        <button class="remove-cover-btn" id="remove-cover-btn" type="button" style="display: none;"
          >&times;</button
        >
        <input type="file" id="cover-image-input" accept="image/*" style="display: none;" />
      </div>

      <input
        type="text"
        class="write-title-input"
        id="post-title"
        placeholder="Title"
        autocomplete="off"
        spellcheck="false"
      />
      <input
        type="text"
        class="write-subtitle-input"
        id="post-subtitle"
        placeholder="Subtitle (optional)"
        autocomplete="off"
        spellcheck="false"
      />

      <div class="write-meta">
        <div class="write-tags-container" id="tags-container">
          <div class="tags-list" id="tags-list"></div>
          <input
            type="text"
            class="write-tags-input"
            id="post-tags-input"
            placeholder="Add up to 7 tags (press Enter)..."
            aria-label="Tags"
            autocomplete="off"
          />
        </div>
      </div>

      <div class="write-body">
        <div id="floating-action-menu" class="floating-action-menu">
          <button
            id="floating-toggle-btn"
            class="floating-toggle-btn"
            aria-label="Add content"
            type="button"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              ><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"
              ></line></svg
            >
          </button>
          <div id="floating-actions" class="floating-actions">
            <button id="floating-image-btn" aria-label="Add image" type="button">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                ><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle
                  cx="8.5"
                  cy="8.5"
                  r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg
              >
            </button>
          </div>
        </div>
        <!-- Quill Editor Container -->
        <div id="quill-editor"></div>
      </div>
    </div>
  </div>

  <div class="loading-state" id="loading-state">
    <p>Verifying authentication...</p>
  </div>

  <!-- Publish Settings Drawer -->
  <div class="publish-drawer-overlay" id="publish-drawer-overlay">
    <div class="publish-drawer" id="publish-drawer" role="dialog" aria-modal="true">
      <div class="publish-drawer-header">
        <h2 class="publish-drawer-title">Publish Settings</h2>
        <button class="publish-drawer-close" id="publish-drawer-close" aria-label="Close"
          >&times;</button
        >
      </div>
      <div class="publish-drawer-body">
        <div class="publish-form-group">
          <label class="publish-label">SEO Excerpt</label>
          <p class="publish-help">
            A brief description for search engines and social media previews.
          </p>
          <textarea
            id="post-excerpt"
            class="publish-textarea"
            rows="3"
            placeholder="Write a captivating summary..."></textarea>
        </div>
        <div class="publish-preview-card">
          <p class="publish-preview-label">Social Preview</p>
          <div class="preview-card-inner">
            <div class="preview-img-placeholder" id="preview-cover">No cover image</div>
            <div class="preview-content">
              <h4 id="preview-title">Your Title Here</h4>
              <p id="preview-excerpt">Your excerpt will appear here.</p>
            </div>
          </div>
        </div>
      </div>
      <div class="publish-drawer-footer">
        <button class="btn btn-primary" id="confirm-publish-btn" style="width: 100%;"
          >Publish now</button
        >
      </div>
    </div>
  </div>
</Layout>

<!-- Load Quill.js and Markdown extension -->
<script is:inline src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
<script
  is:inline
  src="https://cdn.jsdelivr.net/npm/quilljs-markdown@latest/dist/quilljs-markdown.js"></script>

<script is:inline>
  // Initialize Quill Editor
  let quill;

  document.addEventListener('astro:page-load', () => {
    const editorContainer = document.getElementById('quill-editor');
    if (!editorContainer) return; // Not on the write page

    // Reset quill instance
    quill = null;

    async function checkAuth() {
      try {
        const res = await fetch('/api/auth/me');
        const data = await res.json();

        if (!data.success || !data.user) {
          window.location.href = '/login?redirect=/write';
        } else {
          const loader = document.getElementById('loading-state');
          const editorWrap = document.getElementById('editor-container');
          if (loader) loader.style.display = 'none';
          if (editorWrap) editorWrap.style.display = 'flex'; // Use flex to match our CSS

          // Check if Quill is already initialized in this container to prevent double initialization
          if (!document.querySelector('.ql-toolbar')) {
            initQuill();
          }
        }
      } catch (err) {
        console.error('Failed to authenticate:', err);
        window.location.href = '/login?redirect=/write';
      }
    }

    function initQuill() {
      quill = new Quill('#quill-editor', {
        theme: 'bubble', // 'bubble' gives the beautiful highlight-to-format Medium style popup
        placeholder: 'Tell your story...',
        modules: {
          toolbar: [
            ['bold', 'italic', 'underline', 'strike'],
            [{ header: [1, 2, 3, false] }],
            [{ color: [] }, { background: [] }],
            ['blockquote', 'code-block'],
            [{ list: 'ordered' }, { list: 'bullet' }],
            ['link', 'image', 'video'],
            ['clean'],
          ],
        },
      });

      // Enable Markdown shortcuts
      new window.QuillMarkdown(quill, {
        ignoreTags: ['strikethrough', 'image', 'video'], // Ignore some complex or buggy tags if needed
      });

      // Medium-style Floating Action Menu
      const floatMenu = document.getElementById('floating-action-menu');
      const floatToggleBtn = document.getElementById('floating-toggle-btn');
      const floatActions = document.getElementById('floating-actions');
      const floatImgBtn = document.getElementById('floating-image-btn');

      let currentRange = null;

      const hideFloatMenu = () => {
        if (floatMenu) floatMenu.style.display = 'none';
        if (floatActions) floatActions.style.display = 'none';
        if (floatToggleBtn) floatToggleBtn.classList.remove('open');
      };

      quill.on('editor-change', (eventName) => {
        if (eventName === 'text-change') {
          updateWordCount();
          triggerAutoSave();
        }
        if (eventName === 'selection-change' || eventName === 'text-change') {
          const range = quill.getSelection();
          if (range && range.length === 0) {
            const [line] = quill.getLine(range.index);
            // Quill empty line usually has length 1 (a newline)
            if (line && line.length() === 1 && !line.domNode.closest('.ql-code-block')) {
              const bounds = quill.getBounds(range.index);
              if (bounds && floatMenu) {
                floatMenu.style.display = 'flex';
                // Center vertically on the line (subtracting half button height)
                floatMenu.style.top = `${bounds.top + bounds.height / 2 - 16}px`;
                currentRange = range;
              }
            } else {
              hideFloatMenu();
            }
          } else {
            hideFloatMenu();
          }
        }
      });

      floatToggleBtn?.addEventListener('click', () => {
        const isOpen = floatToggleBtn.classList.toggle('open');
        floatActions.style.display = isOpen ? 'flex' : 'none';
      });

      floatImgBtn?.addEventListener('click', () => {
        const input = document.createElement('input');
        input.setAttribute('type', 'file');
        input.setAttribute('accept', 'image/*');
        input.click();

        input.onchange = () => {
          const file = input.files[0];
          if (file && currentRange) {
            const reader = new FileReader();
            reader.onload = (e) => {
              quill.insertEmbed(currentRange.index, 'image', e.target.result);
              quill.setSelection(currentRange.index + 1);
              hideFloatMenu();
            };
            reader.readAsDataURL(file);
          }
        };
      });
    }

    // Attach Event Listeners to fresh DOM elements
    const saveBtn = document.getElementById('save-draft-btn');
    const publishBtn = document.getElementById('publish-btn');
    const titleInput = document.getElementById('post-title');
    const subtitleInput = document.getElementById('post-subtitle');
    const tagsInput = document.getElementById('post-tags-input');
    const tagsListEl = document.getElementById('tags-list');

    // Word Count
    const wordCountEl = document.getElementById('word-count');
    function updateWordCount() {
      if (!quill || !wordCountEl) return;
      const text = quill.getText().trim();
      const words = text ? text.split(/\s+/).length : 0;
      const readTime = Math.max(1, Math.ceil(words / 200));
      wordCountEl.innerHTML = `${words} words &bull; ${readTime} min read`;
    }

    // Cover Image
    let coverImageDataUrl = '';
    const addCoverBtn = document.getElementById('add-cover-btn');
    const removeCoverBtn = document.getElementById('remove-cover-btn');
    const coverImagePreview = document.getElementById('cover-image-preview');
    const coverImageInput = document.getElementById('cover-image-input');

    addCoverBtn?.addEventListener('click', () => coverImageInput?.click());

    coverImageInput?.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (evt) => {
          coverImageDataUrl = evt.target.result;
          coverImagePreview.src = coverImageDataUrl;
          coverImagePreview.style.display = 'block';
          removeCoverBtn.style.display = 'flex';
          addCoverBtn.style.display = 'none';
          triggerAutoSave();
        };
        reader.readAsDataURL(file);
      }
    });

    removeCoverBtn?.addEventListener('click', () => {
      coverImageDataUrl = '';
      coverImagePreview.src = '';
      coverImagePreview.style.display = 'none';
      removeCoverBtn.style.display = 'none';
      addCoverBtn.style.display = 'flex';
      coverImageInput.value = '';
      triggerAutoSave();
    });

    const MAX_TAGS = 7;
    let tagsArray = [];

    // Normalization logic: lowercase, trim, and strip basic trailing 's'
    function normalizeTag(tag) {
      let t = tag.toLowerCase().trim();
      if (t.endsWith('s') && !t.endsWith('ss') && t.length > 3 && t !== 'news') {
        t = t.slice(0, -1);
      }
      return t;
    }

    function renderTags() {
      if (!tagsListEl) return;
      tagsListEl.innerHTML = '';
      tagsArray.forEach((tag, index) => {
        const chip = document.createElement('span');
        chip.className = 'tag-chip';
        chip.textContent = '#' + tag;

        const closeBtn = document.createElement('button');
        closeBtn.innerHTML = '&times;';
        closeBtn.onclick = () => {
          tagsArray.splice(index, 1);
          renderTags();
        };

        chip.appendChild(closeBtn);
        tagsListEl.appendChild(chip);
      });

      if (tagsArray.length >= MAX_TAGS) {
        tagsInput.style.display = 'none';
      } else {
        tagsInput.style.display = 'block';
        tagsInput.placeholder =
          tagsArray.length === 0 ? 'Add up to 7 tags (press Enter)...' : 'Add another tag...';
      }
    }

    tagsInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ',') {
        e.preventDefault();
        const val = tagsInput.value;
        if (val) {
          const normalized = normalizeTag(val);
          if (normalized && !tagsArray.includes(normalized) && tagsArray.length < MAX_TAGS) {
            tagsArray.push(normalized);
            renderTags();
          }
          tagsInput.value = '';
        }
      } else if (e.key === 'Backspace' && tagsInput.value === '' && tagsArray.length > 0) {
        tagsArray.pop();
        renderTags();
      }
    });

    const getPostData = (status) => {
      const title = titleInput.value;
      const subtitle = subtitleInput.value;
      const htmlContent = quill.getSemanticHTML();
      return {
        title,
        subtitle,
        content: htmlContent,
        status,
        tags: tagsArray,
        coverImage: coverImageDataUrl,
      };
    };

    // Auto-save logic
    const draftStatusEl = document.getElementById('draft-status');
    let currentStoryId = null;
    let autoSaveTimeout = null;
    let isSaving = false;

    function triggerAutoSave() {
      if (!titleInput.value) return; // Need a title to save
      if (autoSaveTimeout) clearTimeout(autoSaveTimeout);
      draftStatusEl.textContent = 'Saving...';

      autoSaveTimeout = setTimeout(async () => {
        if (isSaving) return;
        isSaving = true;

        const payload = getPostData('DRAFT');
        try {
          const url = '/api/stories';
          const method = currentStoryId ? 'PUT' : 'POST';
          if (currentStoryId) payload.storyId = currentStoryId;

          const res = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (data.success) {
            currentStoryId = data.story.id;
            draftStatusEl.textContent = 'Draft saved to cloud ☁️';
          } else {
            draftStatusEl.textContent = 'Failed to save';
          }
        } catch (e) {
          draftStatusEl.textContent = 'Network error';
        } finally {
          isSaving = false;
        }
      }, 2000); // Debounce by 2 seconds
    }

    titleInput.addEventListener('input', triggerAutoSave);
    subtitleInput.addEventListener('input', triggerAutoSave);

    saveBtn?.addEventListener('click', () => {
      triggerAutoSave();
    });

    // Publish Drawer Logic
    const publishDrawerOverlay = document.getElementById('publish-drawer-overlay');
    const publishDrawerClose = document.getElementById('publish-drawer-close');
    const confirmPublishBtn = document.getElementById('confirm-publish-btn');
    const postExcerpt = document.getElementById('post-excerpt');

    publishBtn?.addEventListener('click', () => {
      if (!titleInput.value) {
        alert('Please enter a title before publishing.');
        return;
      }

      // Populate preview
      document.getElementById('preview-title').textContent = titleInput.value;
      if (coverImageDataUrl) {
        document.getElementById('preview-cover').innerHTML =
          `<img src="${coverImageDataUrl}" style="width: 100%; height: 100%; object-fit: cover;" />`;
      } else {
        document.getElementById('preview-cover').innerHTML = 'No cover image';
      }

      // Auto-generate excerpt if empty
      if (!postExcerpt.value && quill) {
        const text = quill.getText().trim();
        postExcerpt.value = text.substring(0, 150) + (text.length > 150 ? '...' : '');
      }
      document.getElementById('preview-excerpt').textContent =
        postExcerpt.value || 'Your excerpt will appear here.';

      publishDrawerOverlay.style.display = 'flex';
    });

    postExcerpt?.addEventListener('input', (e) => {
      document.getElementById('preview-excerpt').textContent =
        e.target.value || 'Your excerpt will appear here.';
    });

    publishDrawerClose?.addEventListener('click', () => {
      publishDrawerOverlay.style.display = 'none';
    });

    publishDrawerOverlay?.addEventListener('click', (e) => {
      if (e.target === publishDrawerOverlay) publishDrawerOverlay.style.display = 'none';
    });

    confirmPublishBtn?.addEventListener('click', async () => {
      const dataPayload = getPostData('PUBLISHED');
      dataPayload.excerpt = postExcerpt.value;

      try {
        confirmPublishBtn.textContent = 'Publishing...';
        confirmPublishBtn.disabled = true;
        const method = currentStoryId ? 'PUT' : 'POST';
        if (currentStoryId) dataPayload.storyId = currentStoryId;

        const res = await fetch('/api/stories', {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(dataPayload),
        });
        const data = await res.json();
        if (data.success) {
          window.location.href = `/p/${data.story.slug}`;
        } else {
          alert('Error: ' + data.error);
        }
      } catch (e) {
        alert('Failed to publish story.');
      } finally {
        confirmPublishBtn.textContent = 'Publish now';
        confirmPublishBtn.disabled = false;
      }
    });

    // Run auth check which will initialize Quill
    checkAuth();
  });
</script>

<style>
  .loading-state {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(100vh - 64px);
    font-family: var(--font-sans);
    color: var(--color-muted);
  }

  .write-layout {
    background-color: var(--color-canvas);
    min-height: calc(100vh - 64px);
    display: flex;
    flex-direction: column;
  }

  .write-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-sm) var(--space-md);
    background-color: var(--color-surface-soft);
    border-bottom: 1px solid var(--color-hairline);
    position: sticky;
    top: 64px; /* Below the main site header */
    z-index: 10;
  }

  .draft-status {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-muted-soft);
  }

  .toolbar-right {
    display: flex;
    gap: var(--space-sm);
  }

  .btn-sm {
    padding: 0.375rem 1rem;
    font-size: 0.875rem;
  }

  .write-container {
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-md) var(--space-3xl);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .write-title-input {
    width: 100%;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 4rem);
    border: none;
    background: transparent;
    color: var(--color-ink);
    outline: none;
    letter-spacing: -1.5px;
    line-height: 1.05;
    padding: 0;
    margin-bottom: var(--space-xs);
  }

  .write-title-input::placeholder {
    color: var(--color-muted-soft);
    opacity: 0.5;
  }

  [data-theme='dark'] .write-title-input::placeholder {
    color: rgba(255, 255, 255, 0.2);
  }

  .write-subtitle-input {
    width: 100%;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    border: none;
    background: transparent;
    color: var(--color-muted);
    outline: none;
    line-height: 1.3;
    padding: 0;
    margin-bottom: var(--space-xl);
  }

  .write-subtitle-input::placeholder {
    color: var(--color-muted-soft);
    opacity: 0.5;
  }

  /* Cover Image Styling */
  .cover-image-container {
    margin-bottom: var(--space-xl);
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-surface-soft);
    min-height: 48px;
    display: flex;
    align-items: center;
  }

  .add-cover-btn {
    background: none;
    border: none;
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    padding: 12px 16px;
    transition: color 0.2s ease;
  }

  .add-cover-btn:hover {
    color: var(--color-ink);
  }

  #cover-image-preview {
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    display: block;
  }

  .remove-cover-btn {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    color: white;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .remove-cover-btn:hover {
    background: rgba(0, 0, 0, 0.8);
  }

  /* Publish Drawer Styling */
  .publish-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    z-index: 1000;
    display: none;
    justify-content: center;
    align-items: flex-end;
  }

  .publish-drawer {
    background: var(--bg-canvas);
    width: 100%;
    max-width: 600px;
    border-radius: 16px 16px 0 0;
    padding: var(--space-xl);
    box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.1);
    animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes slideUp {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  .publish-drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-xl);
  }

  .publish-drawer-title {
    font-family: var(--font-serif);
    font-size: 24px;
    margin: 0;
  }

  .publish-drawer-close {
    background: none;
    border: none;
    font-size: 28px;
    line-height: 1;
    color: var(--color-muted);
    cursor: pointer;
  }

  .publish-form-group {
    margin-bottom: var(--space-xl);
  }

  .publish-label {
    display: block;
    font-family: var(--font-sans);
    font-weight: 600;
    margin-bottom: 4px;
  }

  .publish-help {
    font-size: 13px;
    color: var(--color-muted);
    margin-bottom: 12px;
  }

  .publish-textarea {
    width: 100%;
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
    padding: 12px;
    font-family: var(--font-sans);
    background: var(--bg-surface-soft);
    color: var(--color-ink);
    resize: vertical;
  }

  .publish-preview-card {
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
    padding: 16px;
    background: var(--bg-surface-soft);
  }

  .publish-preview-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-muted);
    margin-bottom: 12px;
    font-weight: 600;
  }

  .preview-card-inner {
    background: var(--bg-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
    overflow: hidden;
  }

  .preview-img-placeholder {
    width: 100%;
    height: 160px;
    background: var(--color-hairline);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    font-size: 14px;
  }

  .preview-content {
    padding: 16px;
  }

  #preview-title {
    margin: 0 0 8px 0;
    font-family: var(--font-serif);
