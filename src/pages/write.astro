---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Write a Blog — BigBlog" description="Publish your thoughts to the world.">
  <!-- Load Quill.js CSS (Bubble theme for a Medium-like popup toolbar) -->
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.bubble.css" rel="stylesheet" />

  <div class="write-container" id="editor-container" style="display: none;">
    <div class="write-header">
      <input type="text" class="write-title-input" id="post-title" placeholder="Title" />
      <div class="write-actions">
        <button class="btn btn-secondary" id="save-draft-btn">Save Draft</button>
        <button class="btn btn-primary" id="publish-btn">Publish</button>
      </div>
    </div>

    <div class="write-body">
      <!-- Quill Editor Container -->
      <div id="quill-editor">
        <p>Tell your story...</p>
      </div>
    </div>
  </div>

  <div class="loading-state" id="loading-state">
    <p>Verifying authentication...</p>
  </div>
</Layout>

<!-- Load Quill.js -->
<script is:inline src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>

<script is:inline>
  // Initialize Quill Editor
  let quill;

  async function checkAuth() {
    try {
      const res = await fetch('/api/auth/me');
      const data = await res.json();

      if (!data.success || !data.user) {
        window.location.href = '/login?redirect=/write';
      } else {
        const loader = document.getElementById('loading-state');
        const editor = document.getElementById('editor-container');
        if (loader) loader.style.display = 'none';
        if (editor) editor.style.display = 'block';

        // Initialize Quill after making container visible
        initQuill();
      }
    } catch (err) {
      console.error('Failed to authenticate:', err);
      window.location.href = '/login?redirect=/write';
    }
  }

  function initQuill() {
    quill = new Quill('#quill-editor', {
      theme: 'bubble', // 'bubble' gives the beautiful highlight-to-format Medium style popup
      placeholder: 'Tell your story...',
      modules: {
        toolbar: [
          ['bold', 'italic', 'underline', 'strike'],
          [{ header: [1, 2, 3, false] }],
          [{ color: [] }, { background: [] }],
          ['blockquote', 'code-block'],
          [{ list: 'ordered' }, { list: 'bullet' }],
          ['link', 'image', 'video'],
          ['clean'],
        ],
      },
    });

    // Native Drag and Drop is supported automatically by Quill (inserts as Base64 images).
    // In a real production app, you would intercept the image drop, upload it to S3/Cloudflare R2,
    // and replace the Base64 src with the real image URL.
  }

  // Handle Save / Publish Logic
  document.getElementById('save-draft-btn')?.addEventListener('click', () => {
    if (!quill) return;
    const title = document.getElementById('post-title').value;
    const deltaJson = quill.getContents(); // The smart way to save rich text! (Delta JSON)
    const htmlContent = quill.getSemanticHTML(); // Alternative: Save as raw HTML

    console.log('--- SAVING DRAFT ---');
    console.log('Title:', title);
    console.log('Delta JSON (Database):', deltaJson);
    console.log('HTML Output (Render):', htmlContent);
    alert('Draft saved! Check the console to see the JSON data structure.');
  });

  document.getElementById('publish-btn')?.addEventListener('click', () => {
    if (!quill) return;
    const title = document.getElementById('post-title').value;
    alert(`Publishing "${title}"... (See console for payload)`);
  });

  // Run on mount
  if (typeof window !== 'undefined') {
    checkAuth();
  }
</script>

<style>
  .loading-state {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(100vh - 64px);
    font-family: var(--font-sans);
    color: var(--color-muted);
  }

  .write-container {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-md);
    min-height: calc(100vh - 64px);
  }

  .write-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-xl);
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .write-title-input {
    flex: 1;
    min-width: 200px;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    border: none;
    background: transparent;
    color: var(--color-ink);
    outline: none;
    letter-spacing: -1px;
    line-height: 1.1;
  }

  .write-title-input::placeholder {
    color: rgba(0, 0, 0, 0.2);
  }

  [data-theme='dark'] .write-title-input::placeholder {
    color: rgba(255, 255, 255, 0.2);
  }

  .write-actions {
    display: flex;
    gap: var(--space-sm);
  }

  .write-body {
    display: flex;
    flex-direction: column;
    min-height: 50vh;
  }

  /* Override Quill Styles to match BigBlog */
  :global(.ql-editor) {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    line-height: 1.8;
    color: var(--color-ink);
    padding: 0;
    min-height: 50vh;
  }

  :global(.ql-editor.ql-blank::before) {
    color: rgba(0, 0, 0, 0.2);
    font-style: normal;
    left: 0;
  }

  :global([data-theme='dark'] .ql-editor.ql-blank::before) {
    color: rgba(255, 255, 255, 0.2);
  }

  :global(.ql-container.ql-bubble) {
    border: none !important;
  }
</style>
