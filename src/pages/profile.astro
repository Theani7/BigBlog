---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/dashboard/Sidebar.astro';
import FollowsModal from '../components/profile/FollowsModal.astro';

import { createDatabase, type Env } from '../db';
import { User, Story, Repost, comments, authorFollows, articleBookmarks } from '../db/schema';
import { verifyAuthToken } from '../lib/auth';
import { formatCompactNumber } from '../lib/formatters';
import type { StorySummary } from '../types/content';

const env = (Astro.locals as { env: Env }).env;
if (!env) {
  throw new Error('Environment not configured');
}
await createDatabase(env);

const token = Astro.cookies.get('auth_token')?.value;
let userId = null;
if (token) {
  const payload = await verifyAuthToken(token, env);
  userId = payload?.userId;
}

if (!userId) {
  return Astro.redirect('/login?redirect=/profile');
}

const dbUser = await User.findById(userId);
const user = {
  id: userId.toString(),
  name: dbUser?.name || 'Anonymous',
  username: `@${dbUser?.name?.toLowerCase().replace(/\s+/g, '') || 'user'}`,
  avatar: dbUser?.avatar || '',
  bio: dbUser?.bio || '',
  pronouns: dbUser?.pronouns || '',
  website: dbUser?.website || '',
  twitter: dbUser?.twitter || '',
  github: dbUser?.github || '',
  linkedin: dbUser?.linkedin || '',
  role: dbUser?.role || 'AUTHOR',
  createdAt: dbUser?.createdAt || new Date(),
};

const publishedCount = await Story.countDocuments({ authorId: userId, status: 'PUBLISHED' });
const followerCount = await authorFollows.countDocuments({ authorId: userId });
const followingCount = await authorFollows.countDocuments({ userId: userId });

const userInitials = (user.name || 'U')
  .trim()
  .split(/\s+/)
  .map((part: string) => part[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();

const publishedStories = (await Story.find({
  authorId: userId,
  status: 'PUBLISHED',
}).sort({ createdAt: -1 })) as unknown as StorySummary[];
const storyCount = publishedStories.length;
const totalViews = publishedStories.reduce((acc: number, s) => acc + (s.views || 0), 0);

const reposts = await Repost.find({ userId }).populate({
  path: 'storyId',
  populate: { path: 'authorId' },
});

const userComments = await comments.find({ userId }).lean();

const sessionId = Astro.cookies.get('bb_session')?.value;
let savedStories: StorySummary[] = [];
if (sessionId) {
  try {
    const bookmarks = await articleBookmarks.find({ sessionId }).sort({ createdAt: -1 }).lean();
    if (bookmarks.length) {
      const slugs = bookmarks.map((b) => b.articleSlug);
      const stories = (await Story.find({ slug: { $in: slugs }, status: 'PUBLISHED' })
        .populate('authorId', 'name avatar')
        .lean()) as unknown as StorySummary[];
      const storyBySlug = new Map(stories.map((s) => [s.slug, s]));
      savedStories = bookmarks
        .map((b) => ({ ...(storyBySlug.get(b.articleSlug) || {}), savedAt: b.createdAt }))
        .filter((s): s is StorySummary => Boolean(s.title));
    }
  } catch (err) {
    console.error('Failed to load saved stories:', err);
  }
}
---

<Layout title="Profile - BigBlog">
  <div class="profile-page-wrapper">
    <!-- Left Sidebar -->
    <Sidebar activePage="profile" />

    <!-- Center Profile Content -->
    <main class="profile-main-content">
      <!-- Instagram-Style Profile Header Card -->
      <div class="instagram-profile-header">
        <div class="instagram-avatar-container">
          {
            user.avatar ? (
              <img src={user.avatar} alt={user.name} class="instagram-avatar-img" />
            ) : (
              <div class="instagram-avatar-fallback">
                <span>{userInitials}</span>
              </div>
            )
          }
        </div>

        <div class="instagram-profile-details">
          <div class="instagram-profile-top-row">
            <div class="instagram-name-badges-group">
              <h1 class="instagram-display-name">{user.name}</h1>
              <div class="instagram-badges-row">
                <span class="instagram-role-badge">{user.role}</span>
                {user.pronouns && <span class="instagram-pronouns-pill">{user.pronouns}</span>}
              </div>
            </div>

            <div class="instagram-profile-actions">
              <button
                type="button"
                id="open-edit-profile-btn"
                class="instagram-btn instagram-btn-primary"
                data-tab-target="edit"
              >
                Edit Profile
              </button>
              <button
                type="button"
                id="share-profile-btn"
                class="instagram-btn instagram-btn-secondary"
              >
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                  <polyline points="16 6 12 2 8 6"></polyline>
                  <line x1="12" y1="2" x2="12" y2="15"></line>
                </svg>
                <span>Share Profile</span>
              </button>
            </div>
          </div>

          <div class="instagram-metrics-row">
            <div class="instagram-metric-item">
              <span class="instagram-metric-value">{formatCompactNumber(publishedCount)}</span>
              <span class="instagram-metric-label">Posts</span>
            </div>
            <div class="instagram-metric-item follows-trigger" data-open-follows="followers">
              <span class="instagram-metric-value">{formatCompactNumber(followerCount)}</span>
              <span class="instagram-metric-label">Followers</span>
            </div>
            <div class="instagram-metric-item follows-trigger" data-open-follows="following">
              <span class="instagram-metric-value">{formatCompactNumber(followingCount)}</span>
              <span class="instagram-metric-label">Following</span>
            </div>
          </div>

          {
            user.bio ? (
              <p class="instagram-bio-text">{user.bio}</p>
            ) : (
              <p class="instagram-bio-text empty-bio">No bio added yet.</p>
            )
          }

          {
            (user.website || user.twitter || user.github || user.linkedin) && (
              <div class="instagram-socials-row">
                {user.website && (
                  <a
                    href={
                      user.website.startsWith('http') ? user.website : `https://${user.website}`
                    }
                    target="_blank"
                    rel="noopener noreferrer"
                    class="instagram-social-link"
                  >
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="12" r="10" />
                      <line x1="2" y1="12" x2="22" y2="12" />
                      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10z" />
                    </svg>
                    <span>{user.website.replace(/^https?:\/\//, '')}</span>
                  </a>
                )}
                {user.twitter && (
                  <a
                    href={
                      user.twitter.startsWith('http')
                        ? user.twitter
                        : `https://twitter.com/${user.twitter.replace('@', '')}`
                    }
                    target="_blank"
                    rel="noopener noreferrer"
                    class="instagram-social-link"
                  >
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z" />
                    </svg>
                    <span>{user.twitter.startsWith('@') ? user.twitter : `@${user.twitter}`}</span>
                  </a>
                )}
                {user.github && (
                  <a
                    href={
                      user.github.startsWith('http')
                        ? user.github
                        : `https://github.com/${user.github.replace('@', '')}`
                    }
                    target="_blank"
                    rel="noopener noreferrer"
                    class="instagram-social-link"
                  >
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                    </svg>
                    <span>
                      {user.github.replace(/^https?:\/\/github\.com\//, '').replace('@', '')}
                    </span>
                  </a>
                )}
                {user.linkedin && (
                  <a
                    href={
                      user.linkedin.startsWith('http')
                        ? user.linkedin
                        : `https://linkedin.com/in/${user.linkedin}`
                    }
                    target="_blank"
                    rel="noopener noreferrer"
                    class="instagram-social-link"
                  >
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                      <rect x="2" y="9" width="4" height="12" />
                      <circle cx="4" cy="4" r="2" />
                    </svg>
                    <span>LinkedIn</span>
                  </a>
                )}
              </div>
            )
          }
        </div>
      </div>

      <!-- Instagram Workspace Tabs Bar -->
      <nav class="profile-tabs instagram-tabs">
        <button type="button" class="profile-tab active profile-tab--active" data-tab="posts">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="3" y1="9" x2="21" y2="9"></line>
            <line x1="9" y1="21" x2="9" y2="9"></line>
          </svg>
          <span>Posts</span>
        </button>
        <button type="button" class="profile-tab" data-tab="edit">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
          <span>Edit Profile</span>
        </button>
        <button type="button" class="profile-tab" data-tab="saved">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
          </svg>
          <span>Saved</span>
        </button>
        <button type="button" class="profile-tab" data-tab="stats">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="20" x2="18" y2="10"></line>
            <line x1="12" y1="20" x2="12" y2="4"></line>
            <line x1="6" y1="20" x2="6" y2="14"></line>
          </svg>
          <span>Stats</span>
        </button>
      </nav>

      <div class="profile-content">
        <!-- 1. Posts Panel (data-tab="posts") -->
        <div id="tab-panel-posts" class="tab-content tab-content-posts tab-panel active">
          {
            publishedStories.length > 0 ? (
              <div class="published-stories-section">
                <div class="story-card-list">
                  {publishedStories.map((story) => (
                    <article class="story-card">
                      <div class="story-card-content">
                        <h4 class="story-card-title">
                          <a href={`/p/${story.slug}`}>{story.title}</a>
                        </h4>
                        <p class="story-card-excerpt">
                          {story.content
                            ? story.content.replace(/<[^>]+>/g, '').slice(0, 140) + '...'
                            : ''}
                        </p>
                        <div class="story-card-meta">
                          <span>
                            {new Date(story.publishedAt || story.createdAt).toLocaleDateString(
                              'en-US',
                              { month: 'short', day: 'numeric', year: 'numeric' }
                            )}
                          </span>
                          <span>·</span>
                          <span>{formatCompactNumber(story.views || 0)} views</span>
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            ) : (
              <div class="empty-state">
                <p class="empty-state-title">No published posts yet</p>
                <p class="empty-state-subtitle">
                  Share your stories with the world to see them listed here.
                </p>
              </div>
            )
          }
        </div>

        <!-- 2. Dedicated In-Page Edit Profile Panel (data-tab="edit") -->
        <div id="tab-panel-edit" class="tab-content tab-content-edit tab-panel" hidden>
          <div class="inpage-edit-profile-card">
            <div class="inpage-edit-header">
              <h2 class="inpage-edit-title">Edit Profile</h2>
              <p class="inpage-edit-subtitle">
                Update your personal profile information and social presence.
              </p>
            </div>

            <form id="inpage-edit-profile-form" class="inpage-edit-form" novalidate>
              <div class="form-row form-row--two-col">
                <div class="form-group">
                  <label for="inpage-name">Full Name <span class="required-star">*</span></label>
                  <input
                    type="text"
                    id="inpage-name"
                    name="name"
                    value={user.name}
                    placeholder="Your full name"
                    required
                  />
                </div>

                <div class="form-group">
                  <label for="inpage-pronouns">Pronouns</label>
                  <input
                    type="text"
                    id="inpage-pronouns"
                    name="pronouns"
                    value={user.pronouns}
                    placeholder="e.g. they/them"
                  />
                </div>
              </div>

              <div class="form-group">
                <label>Profile Picture</label>
                <div class="avatar-upload-widget" id="avatar-upload-widget">
                  <div class="avatar-preview-wrapper">
                    <img
                      id="inpage-avatar-preview"
                      src={user.avatar || 'https://i.pravatar.cc/150'}
                      alt="Avatar preview"
                      class="avatar-preview-img"
                    />
                    <div class="avatar-overlay" id="avatar-overlay">
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path
                          d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"
                        ></path>
                        <circle cx="12" cy="13" r="4"></circle>
                      </svg>
                    </div>
                  </div>

                  <div class="avatar-upload-controls">
                    <button
                      type="button"
                      id="trigger-avatar-file-btn"
                      class="instagram-btn instagram-btn-secondary"
                    >
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                      </svg>
                      <span>Upload photo from device</span>
                    </button>
                    <button type="button" id="remove-avatar-btn" class="avatar-remove-link">
                      Remove photo
                    </button>
                  </div>

                  <input
                    type="file"
                    id="inpage-avatar-file"
                    accept="image/png, image/jpeg, image/webp, image/gif"
                    style="display: none;"
                  />
                  <input type="hidden" id="inpage-avatar" name="avatar" value={user.avatar} />
                </div>
                <span class="field-hint"
                  >PNG, JPG, or WEBP. Drag and drop file or choose from your device.</span
                >
              </div>

              <div class="form-group">
                <label for="inpage-bio">Bio</label>
                <textarea
                  id="inpage-bio"
                  name="bio"
                  placeholder="Write a short bio..."
                  rows="3"
                  maxlength="280">{user.bio}</textarea
                >
                <span class="field-hint">Maximum 280 characters.</span>
              </div>

              <div class="form-section-title">Social Links</div>

              <div class="form-row form-row--two-col">
                <div class="form-group">
                  <label for="inpage-website">Website</label>
                  <input
                    type="text"
                    id="inpage-website"
                    name="website"
                    value={user.website}
                    placeholder="https://yourwebsite.com"
                  />
                </div>

                <div class="form-group">
                  <label for="inpage-twitter">Twitter / X handle</label>
                  <input
                    type="text"
                    id="inpage-twitter"
                    name="twitter"
                    value={user.twitter}
                    placeholder="@username"
                  />
                </div>
              </div>

              <div class="form-row form-row--two-col">
                <div class="form-group">
                  <label for="inpage-github">GitHub handle/link</label>
                  <input
                    type="text"
                    id="inpage-github"
                    name="github"
                    value={user.github}
                    placeholder="username or link"
                  />
                </div>

                <div class="form-group">
                  <label for="inpage-linkedin">LinkedIn link</label>
                  <input
                    type="text"
                    id="inpage-linkedin"
                    name="linkedin"
                    value={user.linkedin}
                    placeholder="https://linkedin.com/in/username"
                  />
                </div>
              </div>

              <div id="inpage-edit-alert" class="alert-message" style="display: none;" role="alert">
              </div>

              <div class="inpage-form-actions">
                <button type="submit" id="inpage-edit-submit" class="btn-save">
                  <span class="btn-text">Save changes</span>
                  <span id="inpage-edit-spinner" class="spinner" style="display: none;"></span>
                </button>
              </div>
            </form>

            <form id="inpage-edit-password-form" class="inpage-edit-form" novalidate>
              <div class="form-section-title">Password</div>

              <div class="form-group">
                <label for="inpage-current-password">Current password</label>
                <input
                  type="password"
                  id="inpage-current-password"
                  name="currentPassword"
                  placeholder="Enter your current password"
                  autocomplete="current-password"
                />
              </div>

              <div class="form-row form-row--two-col">
                <div class="form-group">
                  <label for="inpage-new-password">New password</label>
                  <input
                    type="password"
                    id="inpage-new-password"
                    name="newPassword"
                    placeholder="At least 8 characters"
                    autocomplete="new-password"
                  />
                </div>

                <div class="form-group">
                  <label for="inpage-confirm-password">Confirm new password</label>
                  <input
                    type="password"
                    id="inpage-confirm-password"
                    name="confirmPassword"
                    placeholder="Repeat new password"
                    autocomplete="new-password"
                  />
                </div>
              </div>

              <div
                id="inpage-password-message"
                class="alert-message"
                style="display: none;"
                role="alert"
              >
              </div>

              <div class="inpage-form-actions">
                <button type="submit" id="inpage-password-submit" class="btn-save">
                  <span class="btn-text">Update password</span>
                  <span id="inpage-password-spinner" class="spinner" style="display: none;"></span>
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- 3. Saved Panel (data-tab="saved") -->
        <div id="tab-panel-saved" class="tab-content tab-content-saved tab-panel" hidden>
          {
            savedStories.length > 0 ? (
              <div class="story-card-list">
                {savedStories.map((story) => (
                  <article class="story-card">
                    <div class="story-card-content">
                      {story.authorId && (
                        <div class="story-author-row">
                          <img
                            src={story.authorId.avatar || 'https://i.pravatar.cc/150'}
                            class="author-avatar-sm"
                            alt={story.authorId.name}
                          />
                          <span class="author-name-sm">{story.authorId.name || 'Anonymous'}</span>
                        </div>
                      )}
                      <h4 class="story-card-title">
                        <a href={`/p/${story.slug}`}>{story.title}</a>
                      </h4>
                      <p class="story-card-excerpt">
                        {story.content
                          ? story.content.replace(/<[^>]+>/g, '').slice(0, 140) + '...'
                          : ''}
                      </p>
                      <div class="story-card-meta">
                        <span>
                          Saved on{' '}
                          {new Date(story.savedAt).toLocaleDateString('en-US', {
                            month: 'short',
                            day: 'numeric',
                            year: 'numeric',
                          })}
                        </span>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <div class="empty-state">
                <p class="empty-state-title">No saved stories yet</p>
                <p class="empty-state-subtitle">
                  Articles you bookmark while reading will appear here.
                </p>
              </div>
            )
          }
        </div>

        <!-- 4. Stats Panel (data-tab="stats") -->
        <div id="tab-panel-stats" class="tab-content tab-content-stats tab-panel" hidden>
          <div class="stats-overview-card">
            <h3 class="section-title">Analytics & Performance Overview</h3>
            <div class="stats-grid">
              <div class="stat-card">
                <div class="stat-value">{formatCompactNumber(publishedCount)}</div>
                <div class="stat-label">Published Posts</div>
              </div>
              <div class="stat-card">
                <div class="stat-value">{formatCompactNumber(totalViews)}</div>
                <div class="stat-label">Total Post Views</div>
              </div>
              <div class="stat-card">
                <div class="stat-value">{formatCompactNumber(followerCount)}</div>
                <div class="stat-label">Followers</div>
              </div>
              <div class="stat-card">
                <div class="stat-value">{formatCompactNumber(followingCount)}</div>
                <div class="stat-label">Following</div>
              </div>
              <div class="stat-card">
                <div class="stat-value">{formatCompactNumber(reposts.length)}</div>
                <div class="stat-label">Story Reposts</div>
              </div>
              <div class="stat-card">
                <div class="stat-value">{formatCompactNumber(userComments.length)}</div>
                <div class="stat-label">Comments</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>

<FollowsModal authorId={user.id} />

<script>
  import { compressImage } from '../lib/compressImage';
  window['compressImage'] = compressImage;
</script>

<script is:inline data-astro-rerun>
  function setupProfileWorkspace() {
    const tabs = document.querySelectorAll('.profile-tab');
    const panels = document.querySelectorAll('.tab-panel, .tab-content');

    function switchTab(targetTab) {
      tabs.forEach((t) => {
        if (t.getAttribute('data-tab') === targetTab) {
          t.classList.add('active', 'profile-tab--active');
        } else {
          t.classList.remove('active', 'profile-tab--active');
        }
      });

      panels.forEach((panel) => {
        const isTarget =
          panel.id === `tab-panel-${targetTab}` ||
          panel.classList.contains(`tab-content-${targetTab}`);
        if (isTarget) {
          panel.removeAttribute('hidden');
          panel.classList.add('active');
        } else {
          panel.setAttribute('hidden', '');
          panel.classList.remove('active');
        }
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        const targetTab = tab.getAttribute('data-tab');
        if (targetTab) switchTab(targetTab);
      });
    });

    const editBtns = document.querySelectorAll('[data-tab-target="edit"], #open-edit-profile-btn');
    editBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        switchTab('edit');
        const nameInput = document.getElementById('inpage-name');
        if (nameInput) nameInput.focus();
      });
    });

    // In-page form submit handler
    const form = document.getElementById('inpage-edit-profile-form');
    const avatarInput = document.getElementById('inpage-avatar');
    const avatarPreview = document.getElementById('inpage-avatar-preview');
    const avatarFileInput = document.getElementById('inpage-avatar-file');
    const avatarUploadBtn = document.getElementById('trigger-avatar-file-btn');
    const avatarOverlay = document.getElementById('avatar-overlay');
    const avatarRemoveBtn = document.getElementById('remove-avatar-btn');
    const avatarDropWidget = document.getElementById('avatar-upload-widget');

    function handleAvatarFile(file) {
      if (!file || !file.type || !file.type.startsWith('image/')) return;
      var compress =
        window.compressImage ||
        function (f, opts) {
          return Promise.reject('Compressor not ready');
        };
      compress(file, { maxWidth: 400, maxHeight: 400, quality: 0.85 })
        .then(function (dataUrl) {
          if (avatarPreview) avatarPreview.src = dataUrl;
          if (avatarInput) avatarInput.value = dataUrl;
        })
        .catch(function (err) {
          console.error('Failed to compress avatar image:', err);
        });
    }

    if (avatarUploadBtn && avatarFileInput) {
      avatarUploadBtn.addEventListener('click', function () {
        avatarFileInput.click();
      });
    }

    if (avatarOverlay && avatarFileInput) {
      avatarOverlay.addEventListener('click', function () {
        avatarFileInput.click();
      });
    }

    if (avatarFileInput) {
      avatarFileInput.addEventListener('change', function (e) {
        const file = e.target.files && e.target.files[0];
        if (file) {
          handleAvatarFile(file);
        }
      });
    }

    if (avatarRemoveBtn) {
      avatarRemoveBtn.addEventListener('click', function () {
        if (avatarFileInput) avatarFileInput.value = '';
        if (avatarInput) avatarInput.value = '';
        if (avatarPreview) avatarPreview.src = 'https://i.pravatar.cc/150';
      });
    }

    if (avatarDropWidget) {
      ['dragenter', 'dragover'].forEach(function (eventName) {
        avatarDropWidget.addEventListener(eventName, function (e) {
          e.preventDefault();
          e.stopPropagation();
          avatarDropWidget.classList.add('is-dragover');
        });
      });

      ['dragleave', 'drop'].forEach(function (eventName) {
        avatarDropWidget.addEventListener(eventName, function (e) {
          e.preventDefault();
          e.stopPropagation();
          avatarDropWidget.classList.remove('is-dragover');
        });
      });

      avatarDropWidget.addEventListener('drop', function (e) {
        const dt = e.dataTransfer;
        const files = dt && dt.files;
        if (files && files.length > 0) {
          handleAvatarFile(files[0]);
        }
      });
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const alertEl = document.getElementById('inpage-edit-alert');
        const submitBtn = document.getElementById('inpage-edit-submit');
        const spinner = document.getElementById('inpage-edit-spinner');

        if (alertEl) {
          alertEl.style.display = 'none';
          alertEl.className = 'alert-message';
          alertEl.textContent = '';
        }

        const nameVal = document.getElementById('inpage-name')?.value || '';
        if (!nameVal.trim()) {
          if (alertEl) {
            alertEl.textContent = 'Full Name is required.';
            alertEl.className = 'alert-message error';
            alertEl.style.display = 'block';
          }
          return;
        }

        if (submitBtn) submitBtn.disabled = true;
        if (spinner) spinner.style.display = 'inline-block';

        const payload = {
          name: nameVal.trim(),
          pronouns: document.getElementById('inpage-pronouns')?.value || '',
          avatar: document.getElementById('inpage-avatar')?.value || '',
          bio: document.getElementById('inpage-bio')?.value || '',
          website: document.getElementById('inpage-website')?.value || '',
          twitter: document.getElementById('inpage-twitter')?.value || '',
          github: document.getElementById('inpage-github')?.value || '',
          linkedin: document.getElementById('inpage-linkedin')?.value || '',
        };

        try {
          const res = await fetch('/api/user/profile', {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(payload),
          });

          const data = await res.json();
          if (res.ok && data.success) {
            if (alertEl) {
              alertEl.textContent = 'Profile updated successfully!';
              alertEl.className = 'alert-message success';
              alertEl.style.display = 'block';
            }
            setTimeout(() => {
              window.location.reload();
            }, 800);
          } else {
            if (alertEl) {
              alertEl.textContent = data.error || 'Failed to update profile. Please try again.';
              alertEl.className = 'alert-message error';
              alertEl.style.display = 'block';
            }
          }
        } catch (err) {
          if (alertEl) {
            alertEl.textContent = 'An unexpected network error occurred.';
            alertEl.className = 'alert-message error';
            alertEl.style.display = 'block';
          }
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (spinner) spinner.style.display = 'none';
        }
      });
    }

    const passwordForm = document.getElementById('inpage-edit-password-form');

    function showPasswordMessage(message, isError) {
      const msgEl = document.getElementById('inpage-password-message');
      if (!msgEl) return;
      msgEl.textContent = message;
      msgEl.className = isError ? 'alert-message error' : 'alert-message success';
      msgEl.style.display = 'block';
    }

    if (passwordForm) {
      passwordForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const msgEl = document.getElementById('inpage-password-message');
        const submitBtn = document.getElementById('inpage-password-submit');
        const spinner = document.getElementById('inpage-password-spinner');

        if (msgEl) {
          msgEl.style.display = 'none';
          msgEl.textContent = '';
        }

        const currentPassword = document.getElementById('inpage-current-password')?.value || '';
        const newPassword = document.getElementById('inpage-new-password')?.value || '';
        const confirmPassword = document.getElementById('inpage-confirm-password')?.value || '';

        if (!currentPassword || !newPassword) {
          showPasswordMessage('Current and new password are required', true);
          return;
        }
        if (newPassword.length < 8) {
          showPasswordMessage('New password must be at least 8 characters', true);
          return;
        }
        if (newPassword !== confirmPassword) {
          showPasswordMessage('New passwords do not match', true);
          return;
        }

        if (submitBtn) submitBtn.disabled = true;
        if (spinner) spinner.style.display = 'inline-block';

        try {
          const res = await fetch('/api/auth/change-password', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ currentPassword, newPassword }),
          });

          const data = await res.json();
          if (res.ok && data.success) {
            showPasswordMessage('Password updated successfully', false);
            passwordForm.reset();
          } else {
            showPasswordMessage(data.error || 'Failed to update password. Please try again.', true);
          }
        } catch (err) {
          showPasswordMessage('An unexpected network error occurred.', true);
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (spinner) spinner.style.display = 'none';
        }
      });
    }

    const shareBtn = document.getElementById('share-profile-btn');
    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        try {
          if (navigator.share) {
            await navigator.share({
              title: document.title,
              url: window.location.href,
            });
          } else {
            await navigator.clipboard.writeText(window.location.href);
            const span = shareBtn.querySelector('span');
            if (span) {
              const originalText = span.textContent;
              span.textContent = 'Link Copied!';
              setTimeout(() => {
                span.textContent = originalText;
              }, 2000);
            }
          }
        } catch (err) {
          if (err && err.name !== 'AbortError') {
            console.error('Error sharing:', err);
          }
        }
      });
    }

    // Followers / Following modal triggers
    document.querySelectorAll('.follows-trigger[data-open-follows]').forEach(function (el) {
      el.addEventListener('click', function () {
        var type = el.getAttribute('data-open-follows') || 'followers';
        if (typeof window.openFollowsModal === 'function') {
          window.openFollowsModal(type);
        }
      });
    });
  }

  document.addEventListener('astro:page-load', setupProfileWorkspace);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupProfileWorkspace);
  } else {
    setupProfileWorkspace();
  }
</script>

