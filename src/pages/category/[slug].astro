---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { getPostsByCategory, filterDrafts } from '../../lib/content';
import { categoryCanonical } from '../../lib/canonical';
import { categoryPageSchemas } from '../../lib/schema';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  return categories.map((cat) => ({
    params: { slug: cat.slug ?? cat.data.title.toLowerCase() },
    props: {
      title: cat.data.title,
      description: cat.data.description,
      slug: cat.slug ?? cat.data.title.toLowerCase(),
    },
  }));
}

const { title, description, slug } = Astro.props;
const allPosts = await getCollection('blog');
const publishedPosts = filterDrafts(allPosts);
const categoryPosts = getPostsByCategory(allPosts, title);
const featuredPost = categoryPosts.find((p) => p.data.featured) || categoryPosts[0];

const allTags = [...new Set(categoryPosts.flatMap((p) => p.data.tags))].sort();
const tagCounts = allTags
  .map((tag) => ({
    name: tag,
    count: categoryPosts.filter((p) => p.data.tags.includes(tag)).length,
  }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 10);

const otherCategories = [...new Set(publishedPosts.map((p) => p.data.category))]
  .filter((c) => c.toLowerCase() !== title.toLowerCase())
  .map((cat) => ({
    name: cat,
    count: publishedPosts.filter((p) => p.data.category === cat).length,
  }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 6);

const totalWords = categoryPosts.reduce((acc, p) => acc + (p.body?.split(/\s+/).length || 0), 0);
const avgReadingTime = Math.max(1, Math.round(totalWords / (categoryPosts.length * 200)));

const pageTitle = `${title} — Category`;
const pageDescription = description || `Articles in the ${title} category.`;
const pageCanonical = categoryCanonical(slug);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Categories', href: '/blog' },
  { label: title },
];

const structuredData = categoryPageSchemas(
  {
    title: `${title} — Category`,
    description: pageDescription,
    canonical: pageCanonical,
    itemCount: categoryPosts.length,
  },
  breadcrumbs
);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <section class="category-page">
    <div class="container">
      <div class="category-header">
        <p class="page-eyebrow">Category</p>
        <h1 class="page-title">{title}</h1>
        {description && <p class="page-description">{description}</p>}

        <div class="category-stats">
          <div class="stat">
            <span class="stat-value">{categoryPosts.length}</span>
            <span class="stat-label">Articles</span>
          </div>
          <div class="stat">
            <span class="stat-value">{allTags.length}</span>
            <span class="stat-label">Topics</span>
          </div>
          <div class="stat">
            <span class="stat-value">~{avgReadingTime}</span>
            <span class="stat-label">Avg. min read</span>
          </div>
        </div>
      </div>

      <div class="category-layout">
        <div class="category-main">
          {
            featuredPost && (
              <section class="category-featured" aria-label="Featured article">
                <h2 class="section-label">Featured</h2>
                <ArticleCard post={featuredPost} />
              </section>
            )
          }

          <section class="category-articles" aria-label="All articles">
            <h2 class="section-label">All Articles</h2>
            {
              categoryPosts.length > 0 ? (
                <div class="article-grid">
                  {categoryPosts
                    .filter((p) => p.id !== featuredPost?.id)
                    .map((post) => (
                      <ArticleCard post={post} />
                    ))}
                </div>
              ) : (
                <div class="empty-state">
                  <p>No articles in this category yet.</p>
                  <a href="/blog" class="empty-state-link">
                    Browse all articles
                  </a>
                </div>
              )
            }
          </section>
        </div>

        <aside class="category-sidebar" aria-label="Category sidebar">
          {
            tagCounts.length > 0 && (
              <section class="sidebar-section">
                <h3 class="sidebar-heading">Popular Topics</h3>
                <div class="sidebar-tags">
                  {tagCounts.map((tag) => (
                    <a href={`/tag/${tag.name.toLowerCase()}`} class="sidebar-tag">
                      <span class="sidebar-tag-name">{tag.name}</span>
                      <span class="sidebar-tag-count">{tag.count}</span>
                    </a>
                  ))}
                </div>
              </section>
            )
          }

          {
            otherCategories.length > 0 && (
              <section class="sidebar-section">
                <h3 class="sidebar-heading">Other Categories</h3>
                <div class="sidebar-categories">
                  {otherCategories.map((cat) => (
                    <a href={`/category/${cat.name.toLowerCase()}`} class="sidebar-category">
                      <span class="sidebar-category-name">{cat.name}</span>
                      <span class="sidebar-category-count">{cat.count}</span>
                    </a>
                  ))}
                </div>
              </section>
            )
          }
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .category-page {
    padding: 5rem 0 6rem;
  }

  .category-header {
    margin-bottom: var(--space-8);
  }

  .page-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .page-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-3) 0;
  }

  .page-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-6) 0;
    max-width: 40rem;
  }

  .category-stats {
    display: flex;
    gap: var(--space-8);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stat-value {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
  }

  .stat-label {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .category-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .section-label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: var(--space-6);
  }

  .category-featured {
    margin-bottom: var(--space-8);
  }

  .article-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .empty-state {
    padding: var(--space-8) 0;
    text-align: center;
    color: var(--text-tertiary);
  }

  .empty-state-link {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--color-primary);
    font-weight: var(--weight-medium);
  }

  .category-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .sidebar-section {
    padding: var(--space-5);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
  }

  .sidebar-heading {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0 0 var(--space-4) 0;
  }

  .sidebar-tags,
  .sidebar-categories {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .sidebar-tag,
  .sidebar-category {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition:
      background var(--duration-fast) var(--ease-default),
      color var(--duration-fast) var(--ease-default);
  }

  .sidebar-tag:hover,
  .sidebar-category:hover {
    background: var(--bg-tertiary);
    color: var(--color-primary);
    text-decoration: none;
  }

  .sidebar-tag-count,
  .sidebar-category-count {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    background: var(--bg-tertiary);
    padding: 0.15em 0.5em;
    border-radius: var(--radius-full);
  }

  @media (min-width: 768px) {
    .category-layout {
      grid-template-columns: 1fr 280px;
      align-items: start;
    }

    .article-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .article-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-tag,
    .sidebar-category {
      transition: none;
    }
  }
</style>
