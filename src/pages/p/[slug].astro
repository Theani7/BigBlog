---
import Layout from '../../layouts/Layout.astro';
import { createDatabase, type Env } from '../../db';
import { Story } from '../../db/schema';

const { slug } = Astro.params;

const env = (Astro.locals as { env: Env }).env;
if (!env) {
  throw new Error('Environment not configured');
}
await createDatabase(env);

// We must populate the author's details using Mongoose
const story = await Story.findOne({ slug, status: 'PUBLISHED' }).populate(
  'authorId',
  'name avatar'
);

if (!story) {
  return Astro.redirect('/404');
}

// ---------------------------------------------------------
// SMART DYNAMIC READ TIME CALCULATION
// ---------------------------------------------------------
// 1. Strip all HTML tags to get pure text content
const plainText = story.content ? story.content.replace(/<[^>]+>/g, '') : '';
// 2. Count words by splitting on whitespace
const wordCount = plainText.split(/\s+/).filter(Boolean).length;
// 3. Average reading speed is ~225 words per minute. Minimum 1 min read.
const readTime = Math.max(1, Math.ceil(wordCount / 225));

const author = story.authorId;
const authorId = (author as any)?._id?.toString() || '';
const publishDate = new Date(story.publishedAt || story.createdAt).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://bigblog.dev').toString();
---

<Layout title={`${story.title} - BigBlog`} description={plainText.substring(0, 150) + '...'}>
  <meta name="story-slug" content={story.slug} />
  <meta name="story-author" content={authorId} />
  <!-- Load Quill CSS to maintain identical formatting from the editor -->
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.bubble.css" rel="stylesheet" />

  <article class="post-container">
    <header class="post-header">
      <h1 class="post-title">{story.title}</h1>

      <div class="post-meta">
        <div class="author-info">
          <img
            src={author?.avatar || 'https://i.pravatar.cc/150?img=11'}
            alt={author?.name || 'Anonymous'}
            class="author-avatar"
          />
          <div class="author-details">
            <div class="author-line">
              <span class="author-name">{author?.name || 'Anonymous'}</span>
              <button
                class="follow-btn"
                id="follow-btn"
                data-author-id={authorId}
                aria-pressed="false"
                hidden
              >
                Follow
              </button>
            </div>
            <div class="post-stats">
              <span class="post-date">{publishDate}</span>
              <span class="meta-separator">·</span>
              <span class="read-time">{readTime} min read</span>
              <span class="meta-separator">·</span>
              <span class="follower-count" id="follower-count">0 followers</span>
            </div>
          </div>
        </div>

        <div class="post-actions">
          <button class="action-btn" id="comments-btn" aria-label="Comments" title="Comments">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
              ></path></svg
            >
          </button>
          <span class="count" id="comment-count">0</span>

          <button class="action-btn" id="like-btn" aria-label="Like story" aria-pressed="false">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"
              ></path></svg
            >
          </button>
          <span class="count like-count" id="like-count">0</span>

          <button class="action-btn" id="repost-btn" aria-label="Repost story" aria-pressed="false">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="m17 2 4 4-4 4"></path><path d="M3 11v-1a4 4 0 0 1 4-4h14"></path><path
                d="m7 22-4-4 4-4"></path><path d="M21 13v1a4 4 0 0 1-4 4H3"></path></svg
            >
          </button>
          <span class="count" id="repost-count">0</span>

          <button
            class="action-btn"
            id="bookmark-btn"
            aria-label="Bookmark story"
            aria-pressed="false"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg
            >
          </button>

          <div class="share-wrap">
            <button
              class="action-btn"
              id="share-btn"
              aria-label="Share story"
              aria-haspopup="menu"
              aria-expanded="false"
            >
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle
                  cx="18"
                  cy="19"
                  r="3"></circle><path d="m8.59 13.51 6.83 3.98"></path><path
                  d="m15.41 6.51-6.82 3.98"></path></svg
              >
            </button>
            <div class="share-menu" id="share-menu" role="menu" hidden>
              <button type="button" role="menuitem" data-share-copy>Copy link</button>
              <button type="button" role="menuitem" data-share-native hidden>Share…</button>
              <a role="menuitem" target="_blank" rel="noopener noreferrer" data-share-twitter
                >Post on X</a
              >
              <a role="menuitem" target="_blank" rel="noopener noreferrer" data-share-linkedin
                >Share on LinkedIn</a
              >
              <a role="menuitem" target="_blank" rel="noopener noreferrer" data-share-facebook
                >Share on Facebook</a
              >
              <a role="menuitem" data-share-email>Email</a>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="post-content ql-editor">
      <Fragment set:html={story.content} />
    </div>

    <!-- Comments section -->
    <section class="comments-section" id="comments-section" aria-label="Comments">
      <h2 class="comments-title">Responses <span id="comments-title-count">0</span></h2>

      <div class="comment-auth-gate" id="comment-auth-gate" hidden>
        <div class="gate-icon" aria-hidden="true">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
            ></path></svg
          >
        </div>
        <h3 class="gate-title">Join the conversation</h3>
        <p class="gate-text">
          Sign in to share your thoughts, reply to readers, and react to comments.
        </p>
        <button type="button" class="btn-primary" data-auth-modal="login">Sign in to comment</button
        >
      </div>

      <form class="comment-form" id="comment-form" novalidate hidden>
        <div class="comment-as" id="comment-as" hidden>
          Commenting as <strong id="comment-as-name"></strong>
        </div>
        <textarea
          id="comment-content"
          class="comment-content text-input"
          placeholder="Share your thoughts on this story…"
          maxlength="5000"
          rows="4"
          required></textarea>
        <div class="comment-form-actions">
          <span class="comment-error" id="comment-error" role="alert" hidden></span>
          <button type="submit" class="btn-primary" id="comment-submit">Respond</button>
        </div>
      </form>

      <div class="comment-status" id="comment-status" role="status" hidden></div>

      <div class="comment-list" id="comment-list"></div>
    </section>
  </article>

  <div class="toast" role="status" aria-live="polite" id="page-toast" hidden>
    <span class="toast__text" id="page-toast-text"></span>
  </div>
</Layout>

<style>
  .post-container {
    max-width: 720px; /* Claude editorial width (~68ch for readability) */
    margin: 0 auto;
    padding: var(--space-section) var(--space-lg);
    min-height: calc(100vh - 64px);
    background-color: var(--bg-canvas); /* Ensures tinted cream canvas */
  }

  .post-header {
    margin-bottom: var(--space-xl);
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: var(--text-display-lg);
    font-weight: 400;
    line-height: var(--leading-tight);
    letter-spacing: -1px;
    color: var(--color-ink);
    margin-bottom: var(--space-lg);
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-hairline);
    margin-bottom: var(--space-xl);
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  .author-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxs);
  }

  .author-line {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .author-name {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    font-weight: 500;
    color: var(--color-ink);
  }

  .follow-btn {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--color-ink);
    background: transparent;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: 4px 12px;
    cursor: pointer;
    transition: all var(--duration-fast);
  }

  .follow-btn:hover {
    background: var(--bg-surface-soft);
  }

  .follow-btn.is-following {
    background: var(--bg-surface-soft);
    color: var(--color-ink);
    border-color: var(--color-hairline);
  }

  .post-stats {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
  }

  .meta-separator {
    padding: 0 4px;
  }

  .post-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .action-btn {
    background: transparent;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    padding: var(--space-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    transition:
      background var(--duration-fast),
      color var(--duration-fast);
  }

  .action-btn:hover {
    color: var(--color-ink);
    background: var(--bg-surface-soft);
  }

  .action-btn.is-active {
    color: var(--color-primary);
  }
  .action-btn.is-active svg {
    fill: var(--color-primary);
  }

  .count {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-muted);
    min-width: 1.5rem;
    text-align: left;
  }

  /* Share dropdown */
  .share-wrap {
    position: relative;
  }

  .share-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 220px;
    background: var(--bg-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    padding: var(--space-xs);
    z-index: var(--z-dropdown);
    display: flex;
    flex-direction: column;
  }

  .share-menu[hidden] {
    display: none;
  }

  .share-menu button,
  .share-menu a {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    padding: 10px 12px;
    background: none;
    border: none;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-ink);
    cursor: pointer;
    text-decoration: none;
    text-align: left;
    transition: background var(--duration-fast);
  }

  .share-menu button:hover,
  .share-menu a:hover {
    background: var(--bg-surface-soft);
  }

  /* Content Formatting */
  .post-content {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    line-height: var(--leading-normal);
    color: var(--color-body);
    padding: 0;
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3) {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: -0.5px;
    margin-top: 2em;
    margin-bottom: 0.75em;
    color: var(--color-ink);
  }

  .post-content :global(h1) {
    font-size: var(--text-display-md);
  }
  .post-content :global(h2) {
    font-size: var(--text-display-sm);
  }
  .post-content :global(h3) {
    font-size: var(--text-title-lg);
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: 0;
  }

  .post-content :global(p) {
    margin-bottom: 1.55em;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    margin: var(--space-xl) 0;
  }

  .post-content :global(blockquote) {
    border-left: 2px solid var(--color-ink);
    padding-left: var(--space-lg);
    margin-left: 0;
    font-style: italic;
    color: var(--color-body-strong);
    font-family: var(--font-serif);
    font-size: var(--text-title-md);
  }

  /* Comments */
  .comments-section {
    margin-top: var(--space-section);
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--space-xl);
  }

  .comments-title {
    font-family: var(--font-serif);
    font-size: var(--text-display-sm);
    font-weight: 400;
    letter-spacing: -0.3px;
    color: var(--color-ink);
    margin-bottom: var(--space-xl);
  }

  .comments-title span {
    color: var(--color-muted);
  }

  .comment-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .comment-form[hidden],
  .comment-auth-gate[hidden] {
    display: none;
  }

  .comment-auth-gate {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xl);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-xl);
    text-align: center;
    background: var(--bg-surface-soft);
  }

  .gate-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink);
    margin-bottom: var(--space-xs);
  }

  .gate-title {
    font-family: var(--font-sans);
    font-size: var(--text-title-md);
    font-weight: 500;
    color: var(--color-ink);
    margin: 0;
  }

  .gate-text {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    line-height: var(--leading-normal);
    color: var(--color-muted);
    margin: 0 0 var(--space-md);
    max-width: 360px;
  }

  .btn-primary {
    font-family: var(--font-sans);
    font-size: var(--text-button);
    font-weight: 500;
    padding: 12px 20px;
    height: 40px;
    border: none;
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-on-primary);
    cursor: pointer;
    transition: background var(--duration-fast);
  }

  .btn-primary:hover {
    background: var(--color-primary-active);
  }

  .btn-primary:disabled {
    background: var(--color-primary-disabled);
    color: var(--color-muted);
    cursor: not-allowed;
  }

  .comment-as {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-muted);
  }

  .comment-as strong {
    color: var(--color-ink);
    font-weight: 500;
  }

  .text-input {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    padding: 10px 14px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--bg-canvas);
    color: var(--color-ink);
    resize: vertical;
    min-height: 96px;
  }

  .text-input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .comment-form-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-md);
  }

  .comment-error {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-error);
    flex: 1;
    text-align: left;
  }

  .comment-status {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--color-success);
    padding: var(--space-sm) 0;
    margin-bottom: var(--space-md);
  }

  .comment-status[hidden] {
    display: none;
  }

  /* Overriding old comment list styles injected by JS */
  :global(.comment-list) {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  :global(.comment-item) {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  :global(.comment-item.is-reply) {
    padding-left: var(--space-lg);
    border-left: 1px solid var(--color-hairline);
  }

  :global(.comment-head) {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  :global(.comment-avatar) {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: var(--bg-surface-card);
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-weight: 500;
    flex-shrink: 0;
  }

  :global(.comment-author) {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: var(--color-ink);
  }

  :global(.comment-time) {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
  }

  :global(.comment-edited) {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
    font-style: italic;
  }

  :global(.comment-body) {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    line-height: var(--leading-normal);
    color: var(--color-body);
    white-space: pre-wrap;
    word-break: break-word;
  }

  :global(.comment-foot) {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  :global(.reaction-btn) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: none;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    padding: 2px 10px;
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
    cursor: pointer;
    transition: all var(--duration-fast);
  }

  :global(.reaction-btn:hover) {
    border-color: var(--color-muted);
  }

  :global(.reaction-btn.is-active) {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: var(--bg-surface-soft);
  }

  :global(.comment-reply-btn) {
    background: none;
    border: none;
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted);
    cursor: pointer;
    padding: 2px 4px;
    transition: color var(--duration-fast);
  }

  :global(.comment-reply-btn:hover) {
    color: var(--color-ink);
  }

  :global(.comment-menu) {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  :global(.comment-menu-btn) {
    background: none;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    padding: 4px 6px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    transition:
      color var(--duration-fast),
      background var(--duration-fast);
  }

  :global(.comment-menu-btn:hover) {
    color: var(--color-ink);
    background: var(--bg-surface-soft);
  }

  :global(.comment-empty) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    text-align: center;
    padding: var(--space-xl);
    border-top: 1px solid var(--color-hairline);
    border-bottom: 1px solid var(--color-hairline);
  }

  :global(.comment-empty-title) {
    font-family: var(--font-sans);
    font-size: var(--text-title-md);
    font-weight: 500;
    color: var(--color-ink);
    margin: 0;
  }

  :global(.comment-empty-text) {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    color: var(--color-muted);
    margin: 0;
    max-width: 340px;
    line-height: var(--leading-normal);
  }

