---
import '../../styles/pages/article.css';
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/dashboard/Sidebar.astro';
import ArticleHeader from '../../components/article/ArticleHeader.astro';
import ArticleActions from '../../components/article/ArticleActions.astro';
import CommentsSection from '../../components/article/CommentsSection.astro';
import { createDatabase, type Env } from '../../db';
import { Story } from '../../db/schema';

const { slug } = Astro.params;

const env = (Astro.locals as { env: Env }).env;
if (!env) {
  throw new Error('Environment not configured');
}
await createDatabase(env);

// We must populate the author's details using Mongoose
const story = await Story.findOne({ slug, status: 'PUBLISHED' }).populate(
  'authorId',
  'name avatar'
);

if (!story) {
  return Astro.redirect('/404');
}

const authUser = (Astro.locals as { user?: { id: string; email: string; name?: string } }).user;

// ---------------------------------------------------------
// SMART DYNAMIC READ TIME CALCULATION
// ---------------------------------------------------------
// 1. Strip all HTML tags to get pure text content
const plainText = story.content ? story.content.replace(/<[^>]+>/g, '') : '';
// 2. Count words by splitting on whitespace
const wordCount = plainText.split(/\s+/).filter(Boolean).length;
// 3. Average reading speed is ~225 words per minute. Minimum 1 min read.
const readTime = Math.max(1, Math.ceil(wordCount / 225));

const author = story.authorId;
const authorId = (author as any)?._id?.toString() || '';
const publishDate = new Date(story.publishedAt || story.createdAt).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://bigblog.dev').toString();
---

<Layout title={`${story.title} - BigBlog`} description={plainText.substring(0, 150) + '...'}>
  <meta name="story-slug" content={story.slug} />
  <meta name="story-author" content={authorId} />
  <meta
    name="current-user"
    content={authUser
      ? JSON.stringify({ id: authUser.id, name: authUser.name || '', email: authUser.email })
      : ''}
  />
  <!-- Quill CSS is only needed to style stored editor markup; load it without blocking first paint -->
  <link
    href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.bubble.css"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.bubble.css" rel="stylesheet" />
  </noscript>

  <div class="read-layout">
    <Sidebar />
    <article class="post-container">
      <ArticleHeader
        title={story.title}
        author={author}
        authorId={authorId}
        publishDate={publishDate}
        readTime={readTime}
      >
        <ArticleActions />
      </ArticleHeader>

      <div class="post-content ql-editor">
        <Fragment set:html={story.content} />
      </div>

      <CommentsSection />
    </article>
  </div>

  <div class="toast" role="status" aria-live="polite" id="page-toast" hidden>
    <span class="toast__text" id="page-toast-text"></span>
  </div>
</Layout>

<script src="../../scripts/pages/article.ts"></script>
