---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import FeaturedCard from '../../components/cards/FeaturedCard.astro';
import CategoryPill from '../../components/article/CategoryPill.astro';
import TagChip from '../../components/article/TagChip.astro';
import { sortPosts, filterDrafts } from '../../lib/content';
import { formatDate } from '../../utils/content';

const allPosts = await getCollection('blog');
const publishedPosts = filterDrafts(allPosts).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const featuredPosts = publishedPosts.filter((p) => p.data.featured);
const latestPosts = publishedPosts.slice(0, 6);
const allCategories = [...new Set(allPosts.map((p) => p.data.category as string))].sort();
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags as string[]))].sort();

const pageTitle = 'Blog';
const pageDescription =
  'Read the latest articles on software engineering, web development, and developer experience.';
---

<Layout title={pageTitle} description={pageDescription} canonical="https://bigblog.dev/blog">
  <section class="blog-hero">
    <div class="container">
      <p class="blog-eyebrow">The Blog</p>
      <h1 class="blog-title">Insights &amp; Ideas</h1>
      <p class="blog-subtitle">
        Deep dives into software engineering, web development, and the craft of building great
        products.
      </p>
    </div>
  </section>

  <section class="blog-content">
    <div class="container">
      <div class="blog-layout">
        <div class="blog-main">
          {
            featuredPosts.length > 0 && (
              <section class="blog-featured" aria-label="Featured articles">
                <h2 class="section-label">Featured</h2>
                <div class="featured-grid">
                  {featuredPosts.slice(0, 2).map((post) => (
                    <FeaturedCard post={post} />
                  ))}
                </div>
              </section>
            )
          }

          <section class="blog-latest" aria-label="Latest articles">
            <h2 class="section-label">Latest Articles</h2>
            {
              latestPosts.length > 0 ? (
                <div class="article-grid">
                  {latestPosts.map((post) => (
                    <ArticleCard post={post} />
                  ))}
                </div>
              ) : (
                <div class="empty-state">
                  <p>No articles published yet.</p>
                </div>
              )
            }
          </section>

          <nav class="blog-pagination" aria-label="Pagination">
            <span class="pagination-info">
              {publishedPosts.length} articles
            </span>
          </nav>
        </div>

        <aside class="blog-sidebar" aria-label="Blog sidebar">
          <section class="sidebar-section">
            <h3 class="sidebar-heading">Categories</h3>
            <div class="sidebar-chips">
              {
                allCategories.map((cat) => (
                  <CategoryPill label={cat} href={`/category/${cat.toLowerCase()}`} />
                ))
              }
            </div>
          </section>

          <section class="sidebar-section">
            <h3 class="sidebar-heading">Topics</h3>
            <div class="sidebar-chips">
              {allTags.map((tag) => <TagChip label={tag} href={`/tag/${tag.toLowerCase()}`} />)}
            </div>
          </section>

          <section class="sidebar-section">
            <h3 class="sidebar-heading">Search</h3>
            <p class="sidebar-placeholder">Search functionality coming soon.</p>
          </section>

          <section class="sidebar-section">
            <h3 class="sidebar-heading">Sort</h3>
            <p class="sidebar-placeholder">Sort options coming soon.</p>
          </section>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-hero {
    padding: 5rem 0 3rem;
    text-align: center;
    border-bottom: 1px solid var(--border-color);
  }

  .blog-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .blog-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-4) 0;
  }

  .blog-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 36rem;
    margin: 0 auto;
  }

  .blog-content {
    padding: var(--space-12) 0;
  }

  .blog-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }

  .section-label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: var(--space-6);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  .article-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .empty-state {
    padding: var(--space-8) 0;
    text-align: center;
    color: var(--text-tertiary);
  }

  .blog-pagination {
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-color);
    margin-top: var(--space-8);
  }

  .pagination-info {
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }

  .blog-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .sidebar-section {
    padding: var(--space-6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
  }

  .sidebar-heading {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0 0 var(--space-4) 0;
  }

  .sidebar-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .sidebar-placeholder {
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    font-style: italic;
    margin: 0;
  }

  @media (min-width: 768px) {
    .blog-layout {
      grid-template-columns: 1fr 300px;
      align-items: start;
    }

    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .article-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .article-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
