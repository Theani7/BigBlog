---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(sorted.flatMap((post) => post.data.tags || []))].sort();
---

<Layout title="Blog — All Posts">
  <section class="blog-page">
    <div class="container">
      <div class="page-header">
        <p class="page-eyebrow">The Archive</p>
        <h1 class="page-title">Writing</h1>
        <p class="page-subtitle">Thoughts, experiments, and reflections on design and technology.</p>
      </div>

      <div class="search-bar">
        <input type="search" id="blog-search" placeholder="Search posts..." autocomplete="off" />
        <span id="tag-count" class="result-count">{sorted.length} posts</span>
      </div>

      {allTags.length > 0 && (
        <div class="tag-filters">
          {allTags.map((tag) => (
            <button class="tag-filter" data-tag={tag}>{tag}</button>
          ))}
        </div>
      )}

      <div id="blog-no-results" class="no-results" style="display: none;">
        No posts match your search or filter.
      </div>

      <div class="post-list">
        {sorted.map((post) => (
          <article class="post-card" data-tags={(post.data.tags || []).join(',')}>
            <a href={`/blog/${post.id}`}>
              <div class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                </time>
              </div>
              <h2 class="post-title">{post.data.title}</h2>
              {post.data.description && (
                <p class="post-description">{post.data.description}</p>
              )}
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="post-tags">
                  {post.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
              <span class="post-read">Read more →</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script src="/js/search.js" is:inline></script>

<style>
  .blog-page {
    padding: 5rem 0 6rem;
  }

  .page-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .page-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .page-subtitle {
    color: var(--text-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
    max-width: 32rem;
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  #blog-search {
    flex: 1;
    max-width: 400px;
    padding: 0.75rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  #blog-search:focus {
    border-color: var(--accent);
  }

  #blog-search::placeholder {
    color: var(--text-muted);
  }

  .result-count {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .tag-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .tag-filter {
    padding: 0.375rem 0.875rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tag-filter:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .tag-filter.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .no-results {
    padding: 2rem 0;
    color: var(--text-muted);
    font-size: 0.9375rem;
    text-align: center;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-card {
    padding: 2rem 0;
    border-bottom: 1px solid var(--border);
    transition: border-color 0.2s ease;
  }

  .post-card:last-child {
    border-bottom: none;
  }

  .post-card a {
    color: var(--text);
    text-decoration: none;
    display: block;
  }

  .post-meta {
    margin-bottom: 0.5rem;
  }

  time {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin-bottom: 0.5rem;
    transition: color 0.2s ease;
  }

  .post-card:hover .post-title {
    color: var(--accent);
  }

  .post-description {
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 0.5rem;
  }

  .tag {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: 999px;
  }

  .post-read {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.02em;
  }
</style>