---
import Layout from '../../layouts/Layout.astro';
import { getEntry, getCollection } from 'astro:content';
import { getSeriesNavigation, getRelatedPosts, getAdjacentPosts } from '../../lib/content';
import { formatDate, readingTime } from '../../utils/content';
import ArticleHero from '../../components/article/ArticleHero.astro';
import AuthorBadge from '../../components/article/AuthorBadge.astro';
import MetadataRow from '../../components/article/MetadataRow.astro';
import ReadingTime from '../../components/article/ReadingTime.astro';
import CategoryPill from '../../components/article/CategoryPill.astro';
import TagChip from '../../components/article/TagChip.astro';
import SeriesBadge from '../../components/article/SeriesBadge.astro';
import ShareButtons from '../../components/article/ShareButtons.astro';
import NewsletterBlock from '../../components/article/NewsletterBlock.astro';
import Icon from '../../components/ui/Icon.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({
      params: { slug: post.data.slug ?? post.slug },
      props: { id: post.id },
    }));
}

const { id } = Astro.props;
const post = await getEntry('blog', id);

if (!post) {
  return Astro.redirect('/404');
}

const allPosts = await getCollection('blog');
const seriesNav = getSeriesNavigation(allPosts, post);
const relatedPosts = getRelatedPosts(allPosts, post, 3);
const adjacentPosts = getAdjacentPosts(allPosts, post);
const rt = readingTime(post.body);
const pageTitle = post.data.title;
const pageDescription = post.data.description;
const pageCanonical =
  post.data.canonical ?? `https://bigblog.dev/blog/${post.data.slug ?? post.slug}`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Blog', href: '/blog' },
    { label: post.data.category, href: `/category/${post.data.category.toLowerCase()}` },
    { label: post.data.title },
  ]}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishedAt.toISOString(),
    dateModified: post.data.updatedAt?.toISOString() ?? post.data.publishedAt.toISOString(),
    author: {
      '@type': 'Person',
      name: post.data.author,
    },
    keywords: post.data.tags,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': pageCanonical,
    },
  }}
  ogImage={post.data.cover}
  keywords={post.data.keywords}
>
  <ArticleHero
    title={post.data.title}
    description={post.data.description}
    cover={post.data.cover}
    coverAlt={post.data.coverAlt}
    publishedAt={post.data.publishedAt}
    author={post.data.author}
    category={post.data.category}
  />

  <div class="article-page">
    <div class="article-page__layout">
      <aside class="article-page__toc" aria-label="Table of contents">
        <h2 class="toc-title">Contents</h2>
        <nav class="toc-nav">
          <ul class="toc-list" id="toc-list"></ul>
        </nav>
      </aside>

      <div class="article-page__main">
        <div
          class="reading-progress"
          role="progressbar"
          aria-valuenow="0"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-label="Reading progress"
        >
          <div class="reading-progress__bar" id="reading-progress"></div>
          <span class="reading-progress__text" id="reading-progress-text">0%</span>
        </div>

        <div class="article-page__meta">
          <div class="article-page__meta-row">
            <CategoryPill
              label={post.data.category}
              href={`/category/${post.data.category.toLowerCase()}`}
            />
            {
              post.data.tags.map((tag) => (
                <TagChip label={tag} href={`/tag/${tag.toLowerCase()}`} />
              ))
            }
          </div>
          <MetadataRow
            author={post.data.author}
            publishedAt={post.data.publishedAt}
            readingTime={rt.minutes}
          />
          {
            post.data.series && (
              <SeriesBadge
                title={post.data.series}
                order={post.data.seriesOrder}
                href={`/series/${post.data.series.toLowerCase()}`}
              />
            )
          }
        </div>

        <div class="article-page__body" set:html={post.body} />

        {
          seriesNav && (
            <nav class="article-page__series" aria-label="Series navigation">
              <div class="series-progress">
                <span>
                  Part {seriesNav.progress.current} of {seriesNav.progress.total}
                </span>
                <div class="progress-bar">
                  <div class="progress-fill" style={`width: ${seriesNav.progress.percentage}%`} />
                </div>
              </div>
              <div class="series-nav-links">
                {seriesNav.previous && (
                  <a href={`/blog/${seriesNav.previous.slug}`} class="series-prev">
                    ← {seriesNav.previous.data.title}
                  </a>
                )}
                {seriesNav.next && (
                  <a href={`/blog/${seriesNav.next.slug}`} class="series-next">
                    {seriesNav.next.data.title} →
                  </a>
                )}
              </div>
              <div class="series-continue">
                {seriesNav.next && (
                  <a href={`/blog/${seriesNav.next.slug}`} class="series-continue__link">
                    Continue reading <Icon name="ArrowRight" size="xs" aria-hidden="true" />
                  </a>
                )}
                <span class="series-continue__time">~{rt.minutes} min read</span>
              </div>
            </nav>
          )
        }

        <ShareButtons title={post.data.title} url={pageCanonical} />

        {
          relatedPosts.length > 0 && (
            <section class="article-page__related" aria-label="Related articles">
              <h2>Related Articles</h2>
              <div class="related-grid">
                {relatedPosts.map(({ post: related }) => (
                  <a href={`/blog/${related.slug}`} class="related-card">
                    <span class="related-card-category">{related.data.category}</span>
                    <h3 class="related-card-title">{related.data.title}</h3>
                    <p class="related-card-desc">{related.data.description}</p>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <NewsletterBlock />
      </div>
    </div>
  </div>

  <nav class="article-page__nav" aria-label="Article navigation">
    {
      adjacentPosts.previous && (
        <a href={`/blog/${adjacentPosts.previous.slug}`} class="nav-card nav-card--prev">
          <span class="nav-card__label">← Previous</span>
          <span class="nav-card__title">{adjacentPosts.previous.data.title}</span>
          <span class="nav-card__meta">
            {adjacentPosts.previous.data.category} · ~
            {readingTime(adjacentPosts.previous.body).minutes} min read
          </span>
        </a>
      )
    }
    {
      adjacentPosts.next && (
        <a href={`/blog/${adjacentPosts.next.slug}`} class="nav-card nav-card--next">
          <span class="nav-card__label">Next →</span>
          <span class="nav-card__title">{adjacentPosts.next.data.title}</span>
          <span class="nav-card__meta">
            {adjacentPosts.next.data.category} · ~{readingTime(adjacentPosts.next.body).minutes} min
            read
          </span>
        </a>
      )
    }
  </nav>
  <nav class="article-page__back" aria-label="Back navigation">
    <a href="/blog" class="back-to-blog"> ← Back to Blog </a>
    <a href={`/category/${post.data.category.toLowerCase()}`} class="back-to-category">
      Back to {post.data.category}
    </a>
  </nav>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const progressBar = document.getElementById('reading-progress');
    const progressText = document.getElementById('reading-progress-text');
    const progressContainer = document.querySelector('.reading-progress');
    const tocList = document.getElementById('toc-list');
    const articleBody = document.querySelector('.article-page__body');

    if (!progressBar || !tocList || !articleBody) return;

    const headings = articleBody.querySelectorAll('h2, h3, h4');
    const headingIds = Array.from(headings).map((h) => {
      const id =
        h.id ||
        h.textContent
          ?.toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');
      if (!h.id) h.id = id;
      return id;
    });

    tocList.innerHTML = headingIds
      .map((id, i) => {
        const heading = headings[i];
        const level = heading?.tagName.toLowerCase().replace('h', '') || '2';
        const text = heading?.textContent?.trim() || '';
        return `<li class="toc-item toc-level-${level}" data-heading-id="${id}"><a href="#${id}">${text}</a></li>`;
      })
      .join('');

    const tocItems = tocList.querySelectorAll('.toc-item a');
    const tocItemElements = tocList.querySelectorAll('.toc-item');

    let currentProgress = 0;
    let hideTimeout = null;

    const updateProgress = () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? Math.min((scrollTop / docHeight) * 100, 100) : 0;

      if (Math.abs(progress - currentProgress) > 0.5) {
        currentProgress = progress;
        progressBar.style.width = `${progress}%`;
        if (progressText) progressText.textContent = `${Math.round(progress)}%`;
        if (progressContainer) {
          progressContainer.setAttribute('aria-valuenow', String(Math.round(progress)));
        }
      }
    };

    const updateTocHighlight = () => {
      const scrollPos = window.scrollY + 120;
      let currentId = '';
      const completedIds = new Set();

      headings.forEach((heading, i) => {
        const rect = heading.getBoundingClientRect();
        const headingTop = rect.top + window.scrollY;

        if (headingTop <= scrollPos) {
          completedIds.add(heading.id);
          currentId = heading.id;
        }
      });

      tocItemElements.forEach((item) => {
        const link = item.querySelector('a');
        if (!link) return;
        const href = link.getAttribute('href')?.slice(1);
        const isActive = href === currentId;
        const isCompleted = completedIds.has(href || '') && !isActive;

        item.classList.toggle('toc-item--active', isActive);
        item.classList.toggle('toc-item--completed', isCompleted);
        link.classList.toggle('active', isActive);

        if (isActive) {
          link.setAttribute('aria-current', 'true');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            updateProgress();
            updateTocHighlight();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true }
    );

    tocList.addEventListener('click', (e) => {
      const link = e.target.closest('a');
      if (!link) return;
      e.preventDefault();
      const targetId = link.getAttribute('href')?.slice(1);
      const target = document.getElementById(targetId);
      if (target) {
        const headerOffset = 80;
        const elementPosition = target.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.scrollY - headerOffset;

        window.scrollTo({
          top: offsetPosition,
          behavior: 'smooth',
        });
        history.pushState(null, '', `#${targetId}`);
      }
    });

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (progressBar) {
      progressBar.style.transition = prefersReducedMotion ? 'none' : 'width 0.1s linear';
    }

    updateProgress();
    updateTocHighlight();

    headings.forEach((heading) => {
      const anchor = document.createElement('a');
      anchor.href = `#${heading.id}`;
      anchor.className = 'heading-anchor';
      anchor.setAttribute('aria-label', `Link to ${heading.textContent}`);
      anchor.innerHTML =
        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>';
      heading.appendChild(anchor);

      anchor.addEventListener('click', (e) => {
        e.preventDefault();
        const url = new URL(window.location.href);
        url.hash = heading.id;
        history.pushState(null, '', url.toString());
        navigator.clipboard.writeText(url.toString()).then(() => {
          showToast('Link copied to clipboard');
        });
        const headerOffset = 80;
        const elementPosition = heading.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.scrollY - headerOffset;
        window.scrollTo({ top: offsetPosition, behavior: 'smooth' });
      });
    });

    document.addEventListener('keydown', (e) => {
      if (
        e.target.tagName === 'INPUT' ||
        e.target.tagName === 'TEXTAREA' ||
        e.target.isContentEditable
      )
        return;

      const scrollAmount = window.innerHeight * 0.8;

      if (e.key === 'j' || (e.key === 'ArrowDown' && e.altKey)) {
        e.preventDefault();
        window.scrollBy({ top: scrollAmount, behavior: 'smooth' });
      } else if (e.key === 'k' || (e.key === 'ArrowUp' && e.altKey)) {
        e.preventDefault();
        window.scrollBy({ top: -scrollAmount, behavior: 'smooth' });
      } else if (e.key === 'g' && !e.shiftKey) {
        if (e.ctrlKey || e.metaKey) return;
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else if (e.key === 'G' || (e.key === 'g' && e.shiftKey)) {
        e.preventDefault();
        window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
      }
    });

    function showToast(message) {
      const existing = document.querySelector('.heading-toast');
      if (existing) existing.remove();
      const toast = document.createElement('div');
      toast.className = 'heading-toast';
      toast.setAttribute('role', 'status');
      toast.setAttribute('aria-live', 'polite');
      toast.textContent = message;
      document.body.appendChild(toast);
      requestAnimationFrame(() => toast.classList.add('heading-toast--visible'));
      setTimeout(() => {
        toast.classList.remove('heading-toast--visible');
        setTimeout(() => toast.remove(), 300);
      }, 2000);
    }
  });
</script>

<style>
  .article-page {
    padding: var(--space-8) 0;
  }

  .article-page__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  @media (min-width: 1024px) {
    .article-page__layout {
      grid-template-columns: 240px 1fr;
      gap: var(--space-12);
      padding: 0 var(--space-8);
    }
  }

  .article-page__toc {
    display: none;
  }

  @media (min-width: 1024px) {
    .article-page__toc {
      display: block;
      position: sticky;
      top: calc(var(--header-height) + var(--space-8));
      max-height: calc(100vh - var(--header-height) - var(--space-16));
      overflow-y: auto;
      padding-right: var(--space-4);
    }
  }

  .toc-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .toc-nav {
    font-size: var(--text-sm);
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    padding: 0.125rem 0;
  }

  .toc-item a {
    color: var(--text-secondary);
    text-decoration: none;
    display: block;
    padding: 0.25rem 0;
    border-left: 2px solid transparent;
    padding-left: var(--space-3);
    transition:
      color var(--duration-fast) var(--ease-default),
      border-color var(--duration-fast) var(--ease-default);
  }

  .toc-item a:hover {
    color: var(--color-primary);
  }

  .toc-item--active a {
    color: var(--color-primary);
    border-left-color: var(--color-primary);
    font-weight: var(--weight-medium);
  }

  .toc-item--completed a {
    color: var(--text-tertiary);
    border-left-color: var(--border-color);
  }

  .toc-item--completed a::before {
    content: '✓ ';
    font-size: 0.7em;
  }

  .toc-level-2 {
    padding-left: 0;
  }

  .toc-level-3 {
    padding-left: var(--space-4);
  }

  .toc-level-4 {
    padding-left: var(--space-8);
  }

  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: transparent;
    z-index: var(--z-fixed);
    pointer-events: none;
  }

  .reading-progress__bar {
    height: 100%;
    width: 0;
    background: var(--color-primary);
    transition: width 0.1s linear;
    will-change: width;
  }

  .reading-progress__text {
    position: fixed;
    top: 7px;
    right: var(--space-4);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-default);
    pointer-events: none;
    z-index: var(--z-fixed);
  }

  .reading-progress:hover ~ .reading-progress__text,
  .reading-progress__text--visible {
    opacity: 1;
  }

  .article-page__meta {
    margin-bottom: var(--space-8);
  }

  .article-page__meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .article-page__body {
    max-width: var(--reader-max-width, 68ch);
    margin: 0 auto;
    font-size: var(--reader-font-size, var(--text-base));
    font-family: var(--reader-font, var(--font-sans));
    line-height: var(--reader-line-height, 1.75);
    letter-spacing: -0.01em;
    word-spacing: 0.01em;
  }

  .article-page__body h2 {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    margin-top: clamp(2rem, 4vw, 3rem);
    margin-bottom: var(--space-4);
    padding-top: var(--space-2);
  }

  .article-page__body h3 {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: -0.01em;
    margin-top: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: var(--space-3);
  }

  .article-page__body h4 {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-normal);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .article-page__body p {
    margin-bottom: 1.5em;
    max-width: 72ch;
  }

  .article-page__body ul,
  .article-page__body ol {
    padding-left: var(--space-6);
    margin-bottom: 1.5em;
  }

  .article-page__body ul {
    list-style-type: disc;
  }

  .article-page__body ol {
    list-style-type: decimal;
  }

  .article-page__body li {
    margin-bottom: 0.5em;
    padding-left: 0.25em;
  }

  .article-page__body li > ul,
  .article-page__body li > ol {
    margin-top: 0.5em;
    margin-bottom: 0;
  }

  .article-page__body ul ul {
    list-style-type: circle;
  }

  .article-page__body ul ul ul {
    list-style-type: square;
  }

  .article-page__body blockquote {
    border-left: 3px solid var(--color-primary);
    padding: var(--space-4) var(--space-6);
    margin: var(--space-8) 0;
    font-style: italic;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    position: relative;
  }

  .article-page__body blockquote::before {
    content: '\201C';
    position: absolute;
    top: -0.1em;
    left: 0.15em;
    font-size: 3em;
    line-height: 1;
    color: var(--color-primary);
    opacity: 0.2;
    font-style: normal;
    pointer-events: none;
  }

  .article-page__body blockquote p:last-child {
    margin-bottom: 0;
  }

  .article-page__body pre {
    margin: var(--space-8) 0;
  }

  .article-page__body figure {
    margin: var(--space-8) 0;
  }

  .article-page__body img {
    border-radius: var(--radius-lg);
  }

  .article-page__body hr {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: var(--space-12) 0;
    position: relative;
  }

  .article-page__body hr::after {
    content: '';
    position: absolute;
    top: -0.35em;
    left: 50%;
    transform: translateX(-50%);
    width: 0.5em;
    height: 0.5em;
    background: var(--border-color);
    border-radius: var(--radius-full);
  }

  .article-page__body table {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-8) 0;
    font-size: var(--text-sm);
  }

  .article-page__body th {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    border-bottom: 2px solid var(--border-color);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
  }

  .article-page__body td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-color);
    color: var(--text-secondary);
  }

  .article-page__body tr:nth-child(even) {
    background: var(--bg-secondary);
  }

  .article-page__body tr:hover {
    background: var(--bg-tertiary);
  }

  .article-page__body code:not(pre code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--bg-tertiary);
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
    word-break: break-word;
    border: 1px solid var(--border-color);
  }

  .article-page__body a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(37, 99, 235, 0.3);
    transition: text-decoration-color var(--duration-fast) var(--ease-default);
  }

  .article-page__body a:hover {
    color: var(--color-primary-hover);
    text-decoration-color: var(--color-primary-hover);
  }

  .article-page__body .heading-anchor {
    display: inline-flex;
    align-items: center;
    margin-left: 0.5em;
    color: var(--text-tertiary);
    text-decoration: none;
    opacity: 0;
    transition:
      opacity var(--duration-fast) var(--ease-default),
      color var(--duration-fast) var(--ease-default);
    vertical-align: middle;
  }

  .article-page__body .heading-anchor svg {
    width: 0.8em;
    height: 0.8em;
  }

  .article-page__body h2:hover .heading-anchor,
  .article-page__body h3:hover .heading-anchor,
  .article-page__body h4:hover .heading-anchor,
  .article-page__body .heading-anchor:focus-visible {
