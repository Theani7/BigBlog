---
import Layout from '../layouts/Layout.astro';
import { generateSearchIndex } from '../lib/search';

const searchIndex = await generateSearchIndex();

const pageTitle = 'Search';
const pageDescription = 'Search articles on BigBlog.';
---

<Layout title={pageTitle} description={pageDescription} canonical="https://bigblog.dev/search">
  <section class="search-page">
    <div class="container">
      <div class="search-header">
        <h1 class="search-title">Search</h1>
        <p class="search-subtitle">Find articles, tutorials, and guides.</p>
      </div>

      <div class="search-container">
        <div class="search-input-wrapper">
          <svg
            class="search-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            class="search-input"
            placeholder="Search articles..."
            aria-label="Search articles"
            autocomplete="off"
            autofocus
            data-search-input
          />
          <kbd class="search-shortcut" aria-hidden="true">ESC</kbd>
        </div>

        <div class="search-filters" role="group" aria-label="Search filters">
          <button type="button" class="search-filter search-filter--active" data-filter="all"
            >All</button
          >
          <button type="button" class="search-filter" data-filter="articles">Articles</button>
          <button type="button" class="search-filter" data-filter="tags">Tags</button>
          <button type="button" class="search-filter" data-filter="categories">Categories</button>
        </div>

        <div
          class="search-results"
          data-search-results
          role="region"
          aria-live="polite"
          aria-label="Search results"
        >
          <div class="search-empty" data-search-empty>
            <p class="search-empty-text">Type to search across all content.</p>
            <div class="search-suggestions">
              <p class="search-suggestions-label">Popular searches:</p>
              <div class="search-suggestion-chips">
                <button type="button" class="search-suggestion" data-suggestion="astro"
                  >astro</button
                >
                <button type="button" class="search-suggestion" data-suggestion="typescript"
                  >typescript</button
                >
                <button type="button" class="search-suggestion" data-suggestion="performance"
                  >performance</button
                >
                <button type="button" class="search-suggestion" data-suggestion="css">css</button>
              </div>
            </div>
          </div>

          <div class="search-loading" data-search-loading hidden>
            <div class="search-spinner" aria-hidden="true"></div>
            <span>Searching...</span>
          </div>

          <div class="search-no-results" data-search-no-results hidden>
            <p class="search-no-results-text">No results found.</p>
            <p class="search-no-results-hint">
              Try different keywords or browse our <a href="/blog">latest articles</a>.
            </p>
            <div class="search-suggestions">
              <p class="search-suggestions-label">Try searching for:</p>
              <div class="search-suggestion-chips">
                <button type="button" class="search-suggestion" data-suggestion="astro"
                  >astro</button
                >
                <button type="button" class="search-suggestion" data-suggestion="typescript"
                  >typescript</button
                >
                <button type="button" class="search-suggestion" data-suggestion="performance"
                  >performance</button
                >
                <button type="button" class="search-suggestion" data-suggestion="css">css</button>
              </div>
            </div>
          </div>

          <div class="search-results-list" data-search-results-list hidden></div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ searchIndex: JSON.stringify(searchIndex) }}>
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.querySelector('[data-search-input]');
    const resultsList =
      document.querySelector('[data-results-list]') ||
      document.querySelector('[data-search-results-list]');
    const emptyState = document.querySelector('[data-search-empty]');
    const loadingState = document.querySelector('[data-search-loading]');
    const noResults = document.querySelector('[data-search-no-results]');
    const filters = document.querySelectorAll('[data-filter]');
    const suggestions = document.querySelectorAll('[data-suggestion]');
    const resultsRegion = document.querySelector('[data-search-results]');

    if (!input || !resultsList || !emptyState || !loadingState || !noResults) return;

    const index = JSON.parse(searchIndex);
    let currentFilter = 'all';
    let debounceTimer = null;

    const searchableTypes = {
      all: ['articles', 'tags', 'categories'],
      articles: ['articles'],
      tags: ['tags'],
      categories: ['categories'],
    };

    function buildSearchData() {
      const articles = index.map((post) => ({
        type: 'article',
        title: post.title,
        description: post.description,
        url: `/blog/${post.slug}`,
        tags: post.tags,
        category: post.category,
        author: post.author,
        date: post.publishedAt,
        readingTime: post.readingTime,
        featured: post.featured,
        _content:
          `${post.title} ${post.description} ${post.excerpt} ${post.content} ${post.tags.join(' ')} ${post.category} ${post.series || ''} ${post.author}`.toLowerCase(),
      }));

      const tagSet = new Map();
      index.forEach((post) => {
        post.tags.forEach((tag) => {
          if (!tagSet.has(tag.toLowerCase())) {
            tagSet.set(tag.toLowerCase(), { count: 0, posts: [] });
          }
          const t = tagSet.get(tag.toLowerCase());
          t.count++;
          t.posts.push(post.title);
        });
      });
      const tags = Array.from(tagSet.entries()).map(([tag, data]) => ({
        type: 'tag',
        title: tag,
        description: `${data.count} article${data.count !== 1 ? 's' : ''}`,
        url: `/tag/${tag}`,
        _content: tag,
      }));

      const catSet = new Map();
      index.forEach((post) => {
        const cat = post.category;
        if (!catSet.has(cat.toLowerCase())) {
          catSet.set(cat.toLowerCase(), { count: 0, posts: [] });
        }
        const c = catSet.get(cat.toLowerCase());
        c.count++;
        c.posts.push(post.title);
      });
      const categories = Array.from(catSet.entries()).map(([cat, data]) => ({
        type: 'category',
        title: cat,
        description: `${data.count} article${data.count !== 1 ? 's' : ''}`,
        url: `/category/${cat}`,
        _content: `${cat} ${data.posts.join(' ')}`.toLowerCase(),
      }));

      return { articles, tags, categories };
    }

    const searchData = buildSearchData();

    function fuzzyMatch(query, text) {
      const q = query.toLowerCase().trim();
      if (!q) return false;

      const words = q.split(/\s+/).filter(Boolean);
      return words.every((word) => text.includes(word));
    }

    function rankResult(item, query) {
      const q = query.toLowerCase().trim();
      let score = 0;
      const titleLower = item.title.toLowerCase();
      const descLower = (item.description || '').toLowerCase();

      if (titleLower === q) score += 100;
      if (titleLower.startsWith(q)) score += 50;
      if (titleLower.includes(q)) score += 25;
      if (descLower.includes(q)) score += 10;
      if (item._content && item._content.includes(q)) score += 5;

      const words = q.split(/\s+/);
      words.forEach((word) => {
        if (titleLower.includes(word)) score += 15;
        if (descLower.includes(word)) score += 5;
      });

      if (item.type === 'article' && item.featured) score += 3;
      if (item.type === 'article') {
        const daysSince = (Date.now() - new Date(item.date).getTime()) / (1000 * 60 * 60 * 24);
        if (daysSince < 30) score += 2;
        else if (daysSince < 90) score += 1;
      }

      return score;
    }

    function highlightText(text, query) {
      if (!query) return text;
      const words = query
        .toLowerCase()
        .trim()
        .split(/\s+/)
        .filter((w) => w.length > 1);
      let result = text;
      words.forEach((word) => {
        const regex = new RegExp(`(${word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
        result = result.replace(regex, '<mark class="search-highlight">$1</mark>');
      });
      return result;
    }

    function renderResults(results, query) {
      if (results.length === 0) {
        resultsList.hidden = true;
        noResults.hidden = false;
        emptyState.hidden = true;
        loadingState.hidden = true;
        resultsRegion?.setAttribute('aria-label', 'No results found');
        return;
      }

      noResults.hidden = true;
      emptyState.hidden = true;
      loadingState.hidden = true;
      resultsList.hidden = false;
      resultsRegion?.setAttribute(
        'aria-label',
        `${results.length} result${results.length !== 1 ? 's' : ''} found`
      );

      const grouped = { article: [], tag: [], category: [] };
      results.forEach((r) => grouped[r.type]?.push(r));

      let html = '';

      if (grouped.article.length > 0) {
        html += `<div class="search-group"><h3 class="search-group-title">Articles</h3>`;
        grouped.article.forEach((item) => {
          const date = new Date(item.date).toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
          });
          html += `
            <a href="${item.url}" class="search-result search-result--article">
              <div class="search-result-content">
                <h4 class="search-result-title">${highlightText(item.title, query)}</h4>
                <p class="search-result-description">${highlightText(item.description, query)}</p>
                <div class="search-result-meta">
                  <span class="search-result-category">${item.category}</span>
                  <span class="search-result-date">${date}</span>
                  <span class="search-result-reading-time">${item.readingTime} min read</span>
                </div>
              </div>
            </a>`;
        });
        html += `</div>`;
      }

      if (grouped.tag.length > 0) {
        html += `<div class="search-group"><h3 class="search-group-title">Tags</h3>`;
        grouped.tag.forEach((item) => {
          html += `
            <a href="${item.url}" class="search-result search-result--tag">
              <div class="search-result-content">
                <h4 class="search-result-title">#${highlightText(item.title, query)}</h4>
                <p class="search-result-description">${item.description}</p>
              </div>
            </a>`;
        });
        html += `</div>`;
      }

      if (grouped.category.length > 0) {
        html += `<div class="search-group"><h3 class="search-group-title">Categories</h3>`;
        grouped.category.forEach((item) => {
          html += `
            <a href="${item.url}" class="search-result search-result--category">
              <div class="search-result-content">
                <h4 class="search-result-title">${highlightText(item.title, query)}</h4>
                <p class="search-result-description">${item.description}</p>
              </div>
            </a>`;
        });
        html += `</div>`;
      }

      resultsList.innerHTML = html;
    }

    function performSearch(query) {
      const allowedTypes = searchableTypes[currentFilter] || searchableTypes.all;
      let allItems = [];

      if (allowedTypes.includes('articles')) allItems = allItems.concat(searchData.articles);
      if (allowedTypes.includes('tags')) allItems = allItems.concat(searchData.tags);
      if (allowedTypes.includes('categories')) allItems = allItems.concat(searchData.categories);

      if (!query || query.length < 2) {
        resultsList.hidden = true;
        noResults.hidden = true;
        emptyState.hidden = false;
        loadingState.hidden = true;
        return;
      }

      const matched = allItems
        .filter((item) => fuzzyMatch(query, item._content || item.title))
        .map((item) => ({ ...item, _score: rankResult(item, query) }))
        .sort((a, b) => b._score - a._score)
        .slice(0, 20);

      renderResults(matched, query);
    }

    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        performSearch(input.value);
      }, 150);
    });

    filters.forEach((filter) => {
      filter.addEventListener('click', () => {
        filters.forEach((f) => f.classList.remove('search-filter--active'));
        filter.classList.add('search-filter--active');
        currentFilter = filter.dataset.filter;
        performSearch(input.value);
      });
      filter.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          filter.click();
        }
      });
    });

    suggestions.forEach((suggestion) => {
      suggestion.addEventListener('click', () => {
        input.value = suggestion.dataset.suggestion;
        input.focus();
        performSearch(input.value);
      });
      suggestion.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          suggestion.click();
        }
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== input) {
        e.preventDefault();
        input.focus();
      }
    });
  });
</script>

<style>
  .search-page {
    padding: 5rem 0 6rem;
  }

  .search-header {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .search-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-3) 0;
  }

  .search-subtitle {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    margin: 0;
  }

  .search-container {
    max-width: 48rem;
    margin: 0 auto;
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: var(--space-4);
    color: var(--text-tertiary);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: var(--space-4) var(--space-4) var(--space-4) 3.5rem;
    font-size: var(--text-lg);
    font-family: var(--font-sans);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    color: var(--text-primary);
    outline: none;
    transition:
      border-color var(--duration-fast) var(--ease-default),
      box-shadow var(--duration-fast) var(--ease-default);
  }

  .search-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }

  .search-input::placeholder {
    color: var(--text-tertiary);
  }

  .search-shortcut {
    position: absolute;
    right: var(--space-4);
    padding: var(--space-1) var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
  }

  .search-filters {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-4);
    flex-wrap: wrap;
  }

  .search-filter {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    font-weight: var(--weight-medium);
    color: var(--text-secondary);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-default);
  }

  .search-filter:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .search-filter--active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--text-inverse);
  }

  .search-results {
    margin-top: var(--space-8);
    min-height: 200px;
  }

  .search-empty {
    text-align: center;
    padding: var(--space-12) 0;
  }

  .search-empty-text {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    margin: 0 0 var(--space-6) 0;
  }

  .search-suggestions {
    margin-top: var(--space-6);
  }

  .search-suggestions-label {
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    margin: 0 0 var(--space-3) 0;
  }

  .search-suggestion-chips {
    display: flex;
    gap: var(--space-2);
    justify-content: center;
    flex-wrap: wrap;
  }

  .search-suggestion {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    color: var(--text-secondary);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-default);
  }

  .search-suggestion:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .search-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-12) 0;
    color: var(--text-secondary);
  }

  .search-spinner {
    width: 1.25rem;
    height: 1.25rem;
    border: 2px solid var(--border-color);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .search-no-results {
    text-align: center;
    padding: var(--space-12) 0;
  }

  .search-no-results-text {
    font-size: var(--text-lg);
    color: var(--text-primary);
    margin: 0 0 var(--space-2) 0;
  }

  .search-no-results-hint {
    color: var(--text-secondary);
    margin: 0;
  }

  .search-group {
    margin-bottom: var(--space-8);
  }

  .search-group-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 0 0 var(--space-4) 0;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-color);
  }

  .search-result {
    display: block;
    padding: var(--space-4);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-3);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-default),
      background var(--duration-fast) var(--ease-default);
  }

  .search-result:hover {
    border-color: var(--color-primary);
    background: var(--bg-secondary);
    text-decoration: none;
  }

  .search-result-title {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
    margin: 0 0 var(--space-1) 0;
  }

  .search-result-description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0 0 var(--space-2) 0;
    line-height: var(--leading-relaxed);
  }

  .search-result-meta {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .search-result--tag .search-result-title {
    color: var(--color-primary);
  }

  .search-result--category .search-result-title {
    color: var(--color-secondary);
  }

  :global(.search-highlight) {
    background: rgba(37, 99, 235, 0.15);
    color: inherit;
    border-radius: 2px;
    padding: 0 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .search-spinner {
      animation: none;
    }
  }
</style>
