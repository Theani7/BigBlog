---
import Layout from '../layouts/Layout.astro';
import { canonicalUrl } from '../lib/canonical';
import { homepageSchemas } from '../lib/schema';
import { createDatabase, type Env } from '../db';
import { Story } from '../db/schema';

const pageTitle = 'Home';
const pageDescription = 'A place to read, write, and deepen your understanding';
const structuredData = homepageSchemas();

const env = (Astro.locals as { env: Env }).env;
let publishedStories: any[] = [];
if (env) {
  try {
    await createDatabase(env);
    publishedStories = await Story.find({ status: 'PUBLISHED' })
      .populate('authorId', 'name avatar')
      .sort({ publishedAt: -1 });
  } catch (error) {
    console.error('Failed to load published stories for homepage:', error);
  }
}
const featuredStory = publishedStories[0] ?? null;
const secondaryStories = publishedStories.slice(1, 3);
const fallbackCover =
  'https://images.unsplash.com/photo-1518770660439-4636190af475?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80';
const fallbackCoverSecondary =
  'https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80';
const formatStoryDate = (story: any) =>
  new Date(story.publishedAt || story.createdAt).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
const storyExcerpt = (story: any) => {
  const text = story.content ? story.content.replace(/<[^>]+>/g, '').trim() : '';
  return text.length > 120 ? text.substring(0, 120) + '...' : text || 'No excerpt available';
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl('/')}
  structuredData={structuredData}
>
  <section class="centered-hero" aria-label="Hero">
    <div class="centered-hero-container">
      <div class="centered-hero-content">
        <div class="hero-badge">Daily Insights</div>
        <h1 class="centered-hero-title">Ideas that<br />shape tomorrow.</h1>
        <p class="centered-hero-subtitle">
          Unravel the complexities of science, technology, and the frontiers of human ingenuity.
        </p>
        <div class="hero-actions">
          <a href="/about" class="btn-dark-pill">Start exploring</a>
          <a href="/write" class="btn-outline-pill">Publish a story</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       EDITOR'S PICKS
       ═══════════════════════════════════════════════════════════════════════ -->
  <section class="editors-picks" aria-label="Editor's Picks">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Editor's Picks</h2>
        <a href="/about" class="section-link">View all &rarr;</a>
      </div>

      <div class="editorial-grid">
        {
          featuredStory ? (
            <article class="card-featured">
              <a
                href={`/p/${featuredStory.slug}`}
                class="card-link-overlay"
                aria-label={`Read ${featuredStory.title}`}
              />
              <div class="card-image-wrapper">
                <img src={fallbackCover} alt={featuredStory.title} />
              </div>
              <div class="card-content">
                <div class="card-meta">
                  <span class="card-tag">Featured</span>
                  <span class="card-date">{formatStoryDate(featuredStory)}</span>
                </div>
                <h3 class="card-title">{featuredStory.title}</h3>
                <p class="card-excerpt">{storyExcerpt(featuredStory)}</p>
                <div class="card-author">By {featuredStory.authorId?.name || 'Anonymous'}</div>
              </div>
            </article>
          ) : null
        }

        <!-- Secondary Articles -->
        <div class="secondary-articles">
          {
            secondaryStories.map((story) => (
              <article class="card-secondary">
                <a
                  href={`/p/${story.slug}`}
                  class="card-link-overlay"
                  aria-label={`Read ${story.title}`}
                />
                <div class="card-image-wrapper">
                  <img src={fallbackCoverSecondary} alt={story.title} />
                </div>
                <div class="card-content">
                  <div class="card-meta">
                    <span class="card-tag">Latest</span>
                  </div>
                  <h3 class="card-title">{story.title}</h3>
                  <p class="card-excerpt">{storyExcerpt(story)}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="newsletter-band" aria-label="Newsletter">
    <div class="container newsletter-inner">
      <p class="section-eyebrow section-eyebrow--on-dark">Newsletter</p>
      <h2 class="section-heading section-heading--on-dark">Stay in the loop.</h2>
      <p class="newsletter-desc">
        Get the latest posts delivered to your inbox. Join 1,000+ developers who read BigBlog every
        week.
      </p>
      <form class="newsletter-form" onsubmit="event.preventDefault();">
        <label for="newsletter-email" class="sr-only">Email address</label>
        <input
          id="newsletter-email"
          type="email"
          placeholder="your@email.com"
          required
          class="newsletter-input"
          aria-label="Email address"
        />
        <button type="submit" class="btn btn-primary">Subscribe</button>
      </form>
    </div>
  </section>
</Layout>

<style>
  /* ═══════════════════════════════════════════════════════════════════════
     CENTERED HERO SECTION
     ═══════════════════════════════════════════════════════════════════════ */
  .centered-hero {
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-canvas);
    padding: var(--space-xxl) 0;
  }

  .centered-hero-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .centered-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: var(--space-xl);
  }

  .centered-hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    line-height: 1.05;
    letter-spacing: -2px;
    color: var(--color-ink);
    margin-bottom: var(--space-md);
  }

  .centered-hero-subtitle {
    font-family: var(--font-sans);
    font-size: clamp(1.125rem, 2vw, 1.35rem);
    line-height: 1.6;
    color: var(--color-muted);
    margin-bottom: var(--space-xl);
    font-weight: 400;
    max-width: 600px;
  }

  .hero-badge {
    display: inline-block;
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-primary);
    margin-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-primary);
    padding-bottom: 4px;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-dark-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    padding: 0.875rem 2rem;
    border-radius: 9999px;
    background: #181715;
    color: #ffffff;
    text-decoration: none;
    transition:
      opacity var(--duration-fast) var(--ease-default),
      transform var(--duration-fast) var(--ease-default);
  }

  .btn-outline-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    padding: 0.875rem 2rem;
    border-radius: 9999px;
    background: transparent;
    border: 1px solid var(--color-hairline);
    color: var(--color-ink);
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-default);
  }

  .btn-dark-pill:hover {
    opacity: 0.9;
    text-decoration: none;
    transform: translateY(-1px);
  }

  .btn-outline-pill:hover {
    background: rgba(0, 0, 0, 0.03);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .centered-hero-container {
      padding: var(--space-xl) var(--space-4);
    }
  }

  /* ═══════════════════════════════════════════════════════════════════════
     NEWSLETTER SECTION
     ═══════════════════════════════════════════════════════════════════════ */
  .newsletter-band {
    padding: var(--space-xxl) 0;
    background: var(--bg-surface-dark);
  }

  .newsletter-inner {
    max-width: 32rem;
    margin: 0 auto;
    text-align: center;
  }

  .newsletter-desc {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    font-weight: 400;
    line-height: 1.55;
    color: var(--color-on-dark-soft);
    margin: 0 0 var(--space-xl);
  }

  .newsletter-form {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  .newsletter-input {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    padding: 10px 14px;
    height: 40px;
    border: 1px solid var(--bg-surface-dark-elevated);
    border-radius: var(--radius-md);
    background: var(--bg-surface-dark-elevated);
    color: var(--color-on-dark);
    min-width: 240px;
    flex: 1;
  }

  .newsletter-input::placeholder {
    color: var(--color-on-dark-soft);
  }

  .newsletter-input:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* ═══════════════════════════════════════════════════════════════════════
     EDITOR'S PICKS
     ═══════════════════════════════════════════════════════════════════════ */
  .editors-picks {
    padding: var(--space-xxl) 0;
    background: var(--bg-canvas);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-ink);
    padding-bottom: var(--space-sm);
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    color: var(--color-ink);
    margin: 0;
  }

  .section-link {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .section-link:hover {
    color: var(--color-primary);
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-xl);
  }

  /* Shared Card Styles */
  .card-featured,
  .card-secondary {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .card-link-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
  }

  .card-image-wrapper {
    overflow: hidden;
    border-radius: var(--radius-none);
    margin-bottom: var(--space-md);
  }

  .card-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-featured:hover .card-image-wrapper img,
  .card-secondary:hover .card-image-wrapper img {
    transform: scale(1.05);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: var(--space-xs);
  }

  .card-tag {
    color: var(--color-primary);
    font-weight: 600;
  }

  .card-date {
    color: var(--color-muted);
  }

  /* Featured Card specifics */
  .card-featured .card-image-wrapper {
    aspect-ratio: 16 / 10;
  }

  .card-featured .card-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3vw, 2.5rem);
    line-height: 1.1;
    margin-bottom: var(--space-sm);
    color: var(--color-ink);
  }

  .card-featured .card-excerpt {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin-bottom: var(--space-md);
    max-width: 90%;
  }

  .card-author {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  /* Secondary Articles column */
  .secondary-articles {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .card-secondary .card-image-wrapper {
    aspect-ratio: 3 / 2;
  }

  .card-secondary .card-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.2;
    margin-bottom: var(--space-xs);
    color: var(--color-ink);
  }

  .card-secondary .card-excerpt {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  @media (max-width: 992px) {
    .editorial-grid {
      grid-template-columns: 1fr;
    }

    .card-featured .card-image-wrapper {
      aspect-ratio: 16 / 9;
    }
  }
</style>
