---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ArticleCard from '../components/cards/ArticleCard.astro';
import FeaturedCard from '../components/cards/FeaturedCard.astro';
import AuthorCard from '../components/cards/AuthorCard.astro';
import SeriesCard from '../components/cards/SeriesCard.astro';
import CategoryPill from '../components/article/CategoryPill.astro';
import TagChip from '../components/article/TagChip.astro';
import { getFeaturedPosts, getLatestPosts, archive } from '../lib/content';
import { formatDate } from '../utils/content';
import { canonicalUrl } from '../lib/canonical';
import { homepageSchemas } from '../lib/schema';

const allPosts = await getCollection('blog');
const publishedPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const featuredPosts = getFeaturedPosts(allPosts);
const latestPosts = getLatestPosts(allPosts, 6);
const allCategories = [...new Set(allPosts.map((p) => p.data.category as string))].sort();
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags as string[]))].sort();

const authors = await getCollection('authors');
const series = await getCollection('series');

const authorsWithCounts = authors.map((author) => ({
  ...author,
  postCount: publishedPosts.filter((p) => p.data.author === author.data.name).length,
}));

const seriesWithCounts = series.map((s) => ({
  ...s,
  postCount: publishedPosts.filter((p) => p.data.series === s.data.title).length,
}));

const totalPosts = publishedPosts.length;
const totalCategories = allCategories.length;
const totalAuthors = authors.length;

const pageTitle = 'Home';
const pageDescription =
  'A premium developer publishing platform for building world-class documentation and blogs.';
const structuredData = homepageSchemas();
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl('/')}
  structuredData={structuredData}
>
  <!-- ═══════════════════════════════════════════════════════════════════════
       BAND 1 — HERO · Cream Canvas
       6-6 grid: headline left, code-window-card right
       ═══════════════════════════════════════════════════════════════════════ -->
  <section class="hero" aria-label="Hero">
    <div class="container hero-container">
      <div class="hero-content">
        <p class="hero-eyebrow">Developer Publishing Platform</p>
        <h1 class="hero-title">Build something<br />worth reading.</h1>
        <p class="hero-subtitle">
          A modern publishing platform for developers who care about craft, clarity, and community.
        </p>
        <div class="hero-actions">
          <a href="/blog" class="btn btn-primary">Read the Blog</a>
          <a href="/about" class="btn btn-secondary">Learn More</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       BAND 2 — FEATURE CARDS · Surface Card (cream-card)
       3-up grid with icon + title + description
       ═══════════════════════════════════════════════════════════════════════ -->
  <section class="features-band" aria-label="Features">
    <div class="container">
      <p class="section-eyebrow">Why BigBlog</p>
      <h2 class="section-heading">Everything you need to publish.</h2>
      <div class="feature-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M12 3l1.912 5.813a2 2 0 0 0 1.275 1.275L21 12l-5.813 1.912a2 2 0 0 0-1.275 1.275L12 21l-1.912-5.813a2 2 0 0 0-1.275-1.275L3 12l5.813-1.912a2 2 0 0 0 1.275-1.275L12 3z"
              ></path></svg
            >
          </div>
          <h3 class="feature-card__title">Content Collections</h3>
          <p class="feature-card__desc">
            Type-safe Markdown and MDX content with frontmatter validation, automatic slug
            generation, and rich querying APIs.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg
            >
          </div>
          <h3 class="feature-card__title">Edge-First Performance</h3>
          <p class="feature-card__desc">
            Static generation with zero-JS pages by default. Every article loads instantly on
            Vercel's edge network.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path
                d="M12 8h.01"></path></svg
            >
          </div>
          <h3 class="feature-card__title">Built-In Analytics</h3>
          <p class="feature-card__desc">
            Privacy-first page views, scroll depth, and Core Web Vitals tracking — no third-party
            scripts required.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       BAND 3 — LATEST ARTICLES · Cream Canvas
       ═══════════════════════════════════════════════════════════════════════ -->
  <section class="latest-band" aria-label="Latest articles">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="section-eyebrow">Latest</p>
          <h2 class="section-heading">Fresh from the blog.</h2>
        </div>
        <a href="/blog" class="text-link">View all articles →</a>
      </div>
      {
        latestPosts.length > 0 ? (
          <div class="article-grid">
            {latestPosts.map((post) => (
              <ArticleCard post={post} />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>No articles published yet. Check back soon.</p>
          </div>
        )
      }
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       BAND 4 — ABOUT + STATS · Dark Navy (product-mockup-card-dark)
       ═══════════════════════════════════════════════════════════════════════ -->
  <section class="about-band" aria-label="About">
    <div class="container about-grid">
      <div class="about-content">
        <p class="section-eyebrow section-eyebrow--on-dark">About</p>
        <h2 class="section-heading section-heading--on-dark">
          Crafted for developers,<br />by developers.
        </h2>
        <p class="about-desc">
          BigBlog is a publishing platform built for developers who care about craft, clarity, and
          community. We believe in the power of well-crafted writing to share knowledge and inspire
          others.
        </p>
        <a href="/about" class="btn btn-secondary-on-dark">Learn More</a>
      </div>
      <div class="stats-cluster">
        <div class="stat-card">
          <span class="stat-card__number">{totalPosts}</span>
          <span class="stat-card__label">Articles</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__number">{totalCategories}</span>
          <span class="stat-card__label">Categories</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__number">{totalAuthors}</span>
          <span class="stat-card__label">Authors</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       BAND 5 — TOPICS + TAGS · Surface Card
       ═══════════════════════════════════════════════════════════════════════ -->
  <section class="topics-band" aria-label="Topics">
    <div class="container">
      <p class="section-eyebrow">Explore</p>
      <h2 class="section-heading">Browse by topic.</h2>
      <div class="chip-row">
        {
          allCategories.map((cat) => (
            <a href={`/category/${cat.toLowerCase()}`} class="badge-pill">
              {cat}
            </a>
          ))
        }
      </div>
      {
        allTags.length > 0 && (
          <div class="chip-row chip-row--tags">
            {allTags.slice(0, 12).map((tag) => (
              <a href={`/tag/${tag.toLowerCase()}`} class="badge-pill badge-pill--muted">
                {tag}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       BAND 6 — AUTHORS · Cream Canvas
       ═══════════════════════════════════════════════════════════════════════ -->
  {
    authorsWithCounts.length > 0 && (
      <section class="authors-band" aria-label="Authors">
        <div class="container">
          <p class="section-eyebrow">Writers</p>
          <h2 class="section-heading">Meet the authors.</h2>
          <div class="author-grid">
            {authorsWithCounts.map((author) => (
              <AuthorCard
                name={author.data.name}
                slug={author.slug}
                bio={author.data.bio}
                avatar={author.data.avatar}
                twitter={author.data.twitter}
                github={author.data.github}
                linkedin={author.data.linkedin}
                website={author.data.website}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ═══════════════════════════════════════════════════════════════════════
       BAND 7 — SERIES · Surface Card
       ═══════════════════════════════════════════════════════════════════════ -->
  {
    seriesWithCounts.length > 0 && (
      <section class="series-band" aria-label="Series">
        <div class="container">
          <p class="section-eyebrow">Series</p>
          <h2 class="section-heading">Deep-dive collections.</h2>
          <div class="series-grid">
            {seriesWithCounts.map((s) => (
              <SeriesCard
                title={s.data.title}
                slug={s.slug}
                description={s.data.description ?? ''}
                author={s.data.author}
                postCount={s.postCount}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ═══════════════════════════════════════════════════════════════════════
       BAND 8 — TESTIMONIALS · Cream Canvas
       ═══════════════════════════════════════════════════════════════════════ -->
  <section class="testimonials-band" aria-label="Testimonials">
    <div class="container">
      <p class="section-eyebrow">Community</p>
      <h2 class="section-heading">What developers are saying.</h2>
      <div class="testimonial-grid">
        <blockquote class="testimonial-card">
          <p class="testimonial-card__text">
            "BigBlog has transformed how our team documents and shares knowledge. The MDX support
            and content collections make it effortless."
          </p>
          <cite class="testimonial-card__cite">Sarah Chen<span>Senior Engineer</span></cite>
        </blockquote>
        <blockquote class="testimonial-card">
          <p class="testimonial-card__text">
            "The static generation and Vercel deployment mean our blog loads instantly. Zero
            compromises on performance."
          </p>
          <cite class="testimonial-card__cite">Marcus Rivera<span>CTO</span></cite>
        </blockquote>
        <blockquote class="testimonial-card">
          <p class="testimonial-card__text">
            "Finally a blogging platform that respects my craft. The typography and reading
            experience are unmatched."
          </p>
          <cite class="testimonial-card__cite">Priya Patel<span>Staff Writer</span></cite>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       BAND 9 — NEWSLETTER · Dark Navy
       ═══════════════════════════════════════════════════════════════════════ -->
  <section class="newsletter-band" aria-label="Newsletter">
    <div class="container newsletter-inner">
      <p class="section-eyebrow section-eyebrow--on-dark">Newsletter</p>
      <h2 class="section-heading section-heading--on-dark">Stay in the loop.</h2>
      <p class="newsletter-desc">
        Get the latest posts delivered to your inbox. Join 1,000+ developers who read BigBlog every
        week.
      </p>
      <form class="newsletter-form" onsubmit="event.preventDefault();">
        <label for="newsletter-email" class="sr-only">Email address</label>
        <input
          id="newsletter-email"
          type="email"
          placeholder="your@email.com"
          required
          class="newsletter-input"
          aria-label="Email address"
        />
        <button type="submit" class="btn btn-primary">Subscribe</button>
      </form>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       BAND 10 — CTA · Coral Callout (callout-card-coral)
       ═══════════════════════════════════════════════════════════════════════ -->
  <section class="cta-band" aria-label="Call to action">
    <div class="container">
      <div class="cta-card">
        <h2 class="cta-card__title">Start writing today.</h2>
        <p class="cta-card__desc">
          Join our community of developers sharing knowledge and building better products together.
        </p>
        <a href="/contact" class="btn btn-on-coral">Get Started</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ═══════════════════════════════════════════════════════════════════════
     SHARED PRIMITIVES
     ═══════════════════════════════════════════════════════════════════════ */

  .section-eyebrow {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .section-eyebrow--on-dark {
    color: var(--color-primary);
  }

  .section-heading {
    font-family: var(--font-serif);
    font-size: var(--text-display-lg);
    font-weight: 400;
    letter-spacing: -1px;
    line-height: 1.1;
    color: var(--color-ink);
    margin: 0 0 var(--space-xl);
  }

  .section-heading--on-dark {
    color: var(--color-on-dark);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-xl);
    gap: var(--space-md);
  }

  .section-header .section-heading {
    margin-bottom: 0;
  }

  .text-link {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-primary);
    text-decoration: none;
    white-space: nowrap;
  }

  .text-link:hover {
    text-decoration: underline;
  }

  /* Buttons — per DESIGN.md component specs */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    padding: 12px 20px;
    height: 40px;
    border-radius: var(--radius-md);
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-default);
  }

  .btn-primary {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .btn-primary:hover {
    background: var(--color-primary-active);
    text-decoration: none;
  }

  .btn-secondary {
    background: var(--bg-canvas);
    color: var(--color-ink);
    border: 1px solid var(--color-hairline);
  }

  .btn-secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    text-decoration: none;
  }

  .btn-secondary-on-dark {
    background: var(--bg-surface-dark-elevated);
    color: var(--color-on-dark);
  }

  .btn-secondary-on-dark:hover {
    background: #2f2d2a;
    text-decoration: none;
  }

  .btn-on-coral {
    background: var(--bg-canvas);
    color: var(--color-ink);
  }

  .btn-on-coral:hover {
    background: #fff;
    text-decoration: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ═══════════════════════════════════════════════════════════════════════
     BAND 1 — HERO
     ═══════════════════════════════════════════════════════════════════════ */

  .hero {
    padding: var(--space-section) 0;
    background: var(--bg-canvas);
    border-bottom: 1px solid var(--color-hairline);
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .hero-container {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .hero-content {
    max-width: 48rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-eyebrow {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: var(--space-md);
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, var(--text-display-xl));
    font-weight: 400;
    letter-spacing: -1.5px;
    line-height: 1.05;
    color: var(--color-ink);
    margin-bottom: var(--space-lg);
  }

  .hero-subtitle {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    font-weight: 400;
    line-height: 1.55;
    color: var(--color-body);
    margin-bottom: var(--space-xl);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    justify-content: center;
  }

  /* ═══════════════════════════════════════════════════════════════════════
     BAND 2 — FEATURE CARDS
     ═══════════════════════════════════════════════════════════════════════ */

  .features-band {
    padding: var(--space-section) 0;
    background: var(--bg-surface-soft);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .feature-card {
    background: var(--bg-surface-card);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-canvas);
    border-radius: var(--radius-md);
    color: var(--color-primary);
    margin-bottom: var(--space-lg);
  }

  .feature-card__title {
    font-family: var(--font-sans);
    font-size: var(--text-title-md);
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-ink);
    margin: 0 0 var(--space-sm);
  }

  .feature-card__desc {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    font-weight: 400;
    line-height: 1.55;
    color: var(--color-body);
    margin: 0;
  }

  /* ═══════════════════════════════════════════════════════════════════════
     BAND 3 — LATEST ARTICLES
     ═══════════════════════════════════════════════════════════════════════ */

  .latest-band {
    padding: var(--space-section) 0;
    background: var(--bg-canvas);
  }

  .article-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .empty-state {
    padding: var(--space-xxl) 0;
    text-align: center;
    color: var(--color-muted);
    font-family: var(--font-sans);
  }

  /* ═══════════════════════════════════════════════════════════════════════
     BAND 4 — ABOUT + STATS (DARK)
     ═══════════════════════════════════════════════════════════════════════ */

  .about-band {
    padding: var(--space-section) 0;
    background: var(--bg-surface-dark);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xxl);
    align-items: center;
  }

  .about-content {
    max-width: 32rem;
  }

  .about-desc {
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    font-weight: 400;
    line-height: 1.55;
    color: var(--color-on-dark-soft);
    margin: 0 0 var(--space-xl);
  }

  .stats-cluster {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-xl);
    background: var(--bg-surface-dark-elevated);
    border-radius: var(--radius-lg);
  }

  .stat-card__number {
    font-family: var(--font-serif);
    font-size: var(--text-display-md);
    font-weight: 400;
    letter-spacing: -0.5px;
    color: var(--color-primary);
    line-height: 1;
  }

  .stat-card__label {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-on-dark-soft);
    margin-top: var(--space-sm);
  }

  /* ═══════════════════════════════════════════════════════════════════════
     BAND 5 — TOPICS
     ═══════════════════════════════════════════════════════════════════════ */

  .topics-band {
    padding: var(--space-section) 0;
    background: var(--bg-surface-soft);
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .chip-row--tags {
    margin-top: var(--space-md);
  }

  .badge-pill {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-ink);
    background: var(--bg-surface-card);
    padding: 4px 12px;
    border-radius: 9999px;
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-default);
  }

  .badge-pill:hover {
    background: var(--bg-surface-cream-strong);
    text-decoration: none;
  }

  .badge-pill--muted {
    color: var(--color-muted);
    background: var(--bg-canvas);
  }

  .badge-pill--muted:hover {
    background: var(--bg-surface-card);
    color: var(--color-ink);
  }

  /* ═══════════════════════════════════════════════════════════════════════
     BAND 6 — AUTHORS
     ═══════════════════════════════════════════════════════════════════════ */

  .authors-band {
    padding: var(--space-section) 0;
    background: var(--bg-canvas);
  }

  .author-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  /* ═══════════════════════════════════════════════════════════════════════
     BAND 7 — SERIES
     ═══════════════════════════════════════════════════════════════════════ */

  .series-band {
    padding: var(--space-section) 0;
