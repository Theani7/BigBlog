---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import EditorsPicks from '../components/home/EditorsPicks.astro';
import NewsletterSection from '../components/home/NewsletterSection.astro';
import { canonicalUrl } from '../lib/canonical';
import { homepageSchemas } from '../lib/schema';
import { createDatabase, type Env } from '../db';
import { Story } from '../db/schema';

// Revalidate the homepage every 5 minutes instead of hitting Mongo on every
// visit. ISR serves the cached HTML from Vercel's edge network.
export const isr = { expiration: 300 };

const pageTitle = 'Home';
const pageDescription = 'A place to read, write, and deepen your understanding';
const structuredData = homepageSchemas();

const env = (Astro.locals as { env: Env }).env;
let publishedStories: any[] = [];
if (env) {
  try {
    await createDatabase(env);
    publishedStories = await Story.find({ status: 'PUBLISHED' })
      .populate('authorId', 'name avatar')
      .sort({ publishedAt: -1 });
  } catch (error) {
    console.error('Failed to load published stories for homepage:', error);
  }
}
const featuredStory = publishedStories[0] ?? null;
const secondaryStories = publishedStories.slice(1, 3);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl('/')}
  structuredData={structuredData}
>
  <HeroSection />

  <EditorsPicks featuredStory={featuredStory} secondaryStories={secondaryStories} />

  <NewsletterSection />
</Layout>
