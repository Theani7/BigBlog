---
import StoriesLayout from '../../components/stories/StoriesLayout.astro';
import StoryList from '../../components/stories/StoryList.astro';

interface Submission {
  title: string;
  slug?: string;
  excerpt?: string;
  meta1: string;
  meta2?: string;
}

const submissions: Submission[] = [];
---

<StoriesLayout activeTab="submissions">
  <StoryList stories={submissions} emptyText="You haven't submitted any stories to publications." />
</StoriesLayout>
