---
import StoriesLayout from '../../components/stories/StoriesLayout.astro';
import StoryList from '../../components/stories/StoryList.astro';

import { createDatabase, type Env } from '../../db';
import { Story } from '../../db/schema';
import { verifyAuthToken } from '../../lib/auth';
import { formatCompactNumber } from '../../lib/formatters';

const env = (Astro.locals as { env: Env }).env;
if (!env) {
  throw new Error('Environment not configured');
}
await createDatabase(env);

const token = Astro.cookies.get('auth_token')?.value;
let userId = null;
if (token) {
  const payload = await verifyAuthToken(token, env);
  userId = payload?.userId;
}

if (!userId) {
  return Astro.redirect('/login?redirect=/stories/published');
}

const dbPublished = await Story.find({ authorId: userId, status: 'PUBLISHED' }).sort({
  publishedAt: -1,
  createdAt: -1,
});

const published = dbPublished.map((story) => {
  const plainText = story.content ? story.content.replace(/<[^>]+>/g, '') : 'No content yet';
  return {
    title: story.title,
    slug: story.slug,
    excerpt: plainText.length > 100 ? plainText.substring(0, 100) + '...' : plainText,
    meta1: `Published ${new Date(story.publishedAt || story.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}`,
    meta2: `${formatCompactNumber(story.views || 0)} views • ${formatCompactNumber(story.reads || 0)} reads`,
  };
});
---

<StoriesLayout activeTab="published">
  <StoryList stories={published} emptyText="You haven't published any stories yet." />
</StoriesLayout>
