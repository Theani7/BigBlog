---
import '../styles/tokens.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import CommandPalette from '../components/navigation/CommandPalette.astro';
import AuthModal from '../components/auth/AuthModal.astro';
import Breadcrumb from '../components/navigation/Breadcrumb.astro';
import ThemeSwitch from '../components/navigation/ThemeSwitch.astro';
import Footer from '../components/ui/Footer.astro';
import ReaderSettings from '../components/layout/ReaderSettings.astro';
import HeadSEO from '../components/layout/HeadSEO.astro';
import Navbar from '../components/navigation/Navbar.astro';

interface LayoutProps {
  title: string;
  description?: string;
  canonical?: string;
  breadcrumbs?: Array<{ label: string; href?: string }>;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  keywords?: string[];
  robots?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  noindex?: boolean;
}

const props = Astro.props;
const { breadcrumbs } = props;
const currentPath = Astro.url.pathname;
const sessionId = Astro.cookies.get('bb_session')?.value || '';
---

<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <HeadSEO {...props} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <Navbar />

    <main id="main-content" class="main-content">
      {
        breadcrumbs && breadcrumbs.length > 0 && (
          <div class="container">
            <Breadcrumb items={breadcrumbs} />
          </div>
        )
      }
      <ReaderSettings />
      <slot />
    </main>

    <Footer />

    <CommandPalette />

    <meta name="bb-session" content={sessionId} />

    <script src="../scripts/analytics.ts"></script>
    <AuthModal />

    <style>
      .skip-link {
        position: absolute;
        top: -100%;
        left: 0;
        padding: 0.5rem 1rem;
        background: var(--color-primary);
        color: var(--text-inverse);
        font-size: var(--text-sm);
        font-weight: var(--weight-medium);
        z-index: var(--z-tooltip);
        border-radius: var(--radius-md);
        text-decoration: none;
        transition: top var(--duration-fast) var(--ease-default);
      }

      .skip-link:focus {
        top: 0;
      }

      :global(:focus-visible) {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
      }

      :global(:focus:not(:focus-visible)) {
        outline: none;
      }

      .container {
        max-width: 100%;
        margin: 0 auto;
        padding: 0 var(--space-6);
      }

      .search-toggle:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
      }

      .search-kbd {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-muted);
        padding: 0.1em 0.35em;
        background: var(--bg-surface-soft);
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-sm);
      }

      .theme-toggle {
        background: none;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-full);
        width: 2.5rem;
        height: 2.5rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-secondary);
        transition: all var(--duration-fast) var(--ease-default);
      }

      .theme-toggle:hover {
        border-color: var(--color-primary);
        color: var(--color-primary);
      }

      .theme-toggle:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
      }

      .main-content {
        min-height: 60vh;
      }
      @media (max-width: 639px) {
        .search-kbd {
          display: none;
        }
      }

      @media (min-width: 768px) {
        .footer-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .footer-bottom {
          flex-direction: row;
          justify-content: space-between;
          align-items: center;
        }
      }

      @media (min-width: 1024px) {
        .footer-grid {
          grid-template-columns: 2fr 1fr 1fr 1fr;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </body>
</html>
