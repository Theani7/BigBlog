---
import '../styles/tokens.css';
import '../styles/global.css';
import CommandPalette from '../components/navigation/CommandPalette.astro';
import AuthModal from '../components/auth/AuthModal.astro';
import Breadcrumb from '../components/navigation/Breadcrumb.astro';
import ThemeSwitch from '../components/navigation/ThemeSwitch.astro';
import { siteConfig, seo as defaultSeo, socials } from '@config/site';

interface LayoutProps {
  title: string;
  description?: string;
  canonical?: string;
  breadcrumbs?: Array<{ label: string; href?: string }>;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  keywords?: string[];
  robots?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  breadcrumbs,
  structuredData,
  ogImage,
  ogType = 'website',
  keywords,
  robots,
  publishedTime,
  modifiedTime,
  author,
  noindex = false,
} = Astro.props;

const fullTitle = title === siteConfig.name ? title : `${title} — ${siteConfig.name}`;
const siteDescription = description ?? defaultSeo.defaultDescription;
const currentPath = Astro.url.pathname;
const resolvedCanonical = canonical ?? `${siteConfig.url}${currentPath}`;
const resolvedOgImage = ogImage ?? `${siteConfig.url}${defaultSeo.defaultImage}`;
const robotsContent = noindex ? 'noindex, nofollow' : (robots ?? 'index, follow');

const navLinks: Array<{ label: string; href: string }> = [
  { label: 'Our story', href: '/about' },
  { label: 'Write', href: '/write' },
];

const activeLink = navLinks.find((link) => {
  if (link.href === '/') return currentPath === '/';
  return currentPath.startsWith(link.href);
});

const structuredDataList = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---

<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={siteDescription} />
    <title>{fullTitle}</title>

    {canonical && <link rel="canonical" href={resolvedCanonical} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={siteConfig.locale} />

    {
      ogType === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      ogType === 'article' && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    {ogType === 'article' && author && <meta property="article:author" content={author} />}
    {
      ogType === 'article' &&
        keywords &&
        keywords.map((tag) => <meta property="article:tag" content={tag} />)
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:site" content={`@${socials.twitter.split('/').pop()}`} />

    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="robots" content={robotsContent} />

    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light dark" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} RSS`}
      href="/rss.xml"
    />

    {
      structuredDataList.map((sd) => (
        <script type="application/ld+json" set:html={JSON.stringify(sd)} />
      ))
    }
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <header class="site-header" role="banner">
      <div class="container header-inner">
        <a href="/" class="logo" aria-label="BigBlog home">
          <span class="logo-text">BigBlog</span>
        </a>
        <div class="header-right-group">
          <nav class="site-nav" aria-label="Main navigation">
            <ul class="nav-list">
              {
                navLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={activeLink?.href === link.href ? 'page' : undefined}
                      class:list={[
                        'nav-link',
                        { 'nav-link--active': activeLink?.href === link.href },
                      ]}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div class="header-actions">
            <div class="auth-links">
              <a href="#" data-auth-modal="login" class="nav-link">Log in</a>
              <a
                href="#"
                data-auth-modal="signup"
                class="btn btn-primary"
                style="padding: 0.375rem 1rem; font-size: 0.875rem;">Get Started</a
              >
            </div>
            <button
              class="mobile-nav-toggle"
              aria-label="Open menu"
              aria-expanded="false"
              type="button"
            >
              <span class="mobile-nav-icon" aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <div class="mobile-nav-overlay" aria-hidden="true">
      <div class="mobile-nav-drawer" role="dialog" aria-modal="true" aria-label="Navigation menu">
        <div class="mobile-nav-header">
          <button class="mobile-nav-close" aria-label="Close menu" type="button">
            <span class="mobile-nav-close-icon" aria-hidden="true"></span>
          </button>
        </div>
        <nav class="mobile-nav-links" aria-label="Mobile navigation">
          <ul class="mobile-nav-list">
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="mobile-nav-link"
                    aria-current={activeLink?.href === link.href ? 'page' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>

    <main id="main-content" class="main-content">
      {
        breadcrumbs && breadcrumbs.length > 0 && (
          <div class="container">
            <Breadcrumb items={breadcrumbs} />
          </div>
        )
      }
      <button
        class="reader-settings-toggle"
        aria-label="Reading settings"
        type="button"
        data-reader-settings-toggle
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="3"></circle>
          <path
            d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
          ></path>
        </svg>
      </button>
      <div class="reader-settings" data-reader-settings hidden>
        <div class="reader-settings__panel">
          <h3 class="reader-settings__title">Reading Settings</h3>
          <div class="reader-settings__group">
            <label class="reader-settings__label" for="reader-font-size">Font Size</label>
            <select
              id="reader-font-size"
              class="reader-settings__select"
              data-reader-pref="fontSize"
            >
              <option value="small">Small</option>
              <option value="medium" selected>Medium</option>
              <option value="large">Large</option>
            </select>
          </div>
          <div class="reader-settings__group">
            <label class="reader-settings__label" for="reader-spacing">Spacing</label>
            <select id="reader-spacing" class="reader-settings__select" data-reader-pref="spacing">
              <option value="compact">Compact</option>
              <option value="comfortable" selected>Comfortable</option>
            </select>
          </div>
          <div class="reader-settings__group">
            <label class="reader-settings__label" for="reader-font">Font</label>
            <select id="reader-font" class="reader-settings__select" data-reader-pref="font">
              <option value="sans" selected>Sans</option>
              <option value="serif">Serif</option>
            </select>
          </div>
          <div class="reader-settings__group">
            <label class="reader-settings__label" for="reader-width">Content Width</label>
            <select id="reader-width" class="reader-settings__select" data-reader-pref="width">
              <option value="narrow">Narrow</option>
              <option value="wide" selected>Wide</option>
            </select>
          </div>
          <button type="button" class="reader-settings__reset" data-reader-reset
            >Reset to defaults</button
          >
        </div>
      </div>
      <slot />
    </main>

    <footer class="site-footer" role="contentinfo">
      <div class="container footer-inner">
        <div class="footer-top">
          <h2 class="footer-huge-title">BigBlog.</h2>
          <p class="footer-tagline">Ideas that shape tomorrow.</p>
        </div>
        <div class="footer-grid">
          <div class="footer-section">
            <h3 class="footer-heading">Platform</h3>
            <ul class="footer-links">
              <li><a href="/about">Our story</a></li>
              <li><a href="/write">Publish</a></li>
              <li><a href="#" data-auth-modal="login">Log in</a></li>
              <li><a href="#" data-auth-modal="signup">Sign up</a></li>
            </ul>
          </div>
          <div class="footer-section">
            <h3 class="footer-heading">Topics</h3>
            <ul class="footer-links">
              <li><a href="#">Science</a></li>
              <li><a href="#">Technology</a></li>
              <li><a href="#">Cosmos</a></li>
              <li><a href="#">Medicine</a></li>
            </ul>
          </div>
          <div class="footer-section">
            <h3 class="footer-heading">Connect</h3>
            <ul class="footer-links">
              <li><a href="https://twitter.com/bigblog">Twitter</a></li>
              <li><a href="https://linkedin.com/company/bigblog">LinkedIn</a></li>
              <li><a href="https://github.com/BigBlog">GitHub</a></li>
              <li><a href="/rss.xml">RSS</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p class="footer-copyright">
            &copy; {new Date().getFullYear()} BigBlog. All rights reserved.
          </p>
        </div>
      </div>
    </footer>

    <CommandPalette />

    <script is:inline>
      (() => {
        const CONFIG = {
          endpoint: '/api/analytics/track',
          performanceEndpoint: '/api/analytics/performance',
          errorEndpoint: '/api/analytics/errors',
          batchInterval: 5000,
          maxBatchSize: 10,
        };

        function isTrackingAllowed() {
          if (navigator.doNotTrack === '1' || window.doNotTrack === '1') return false;
          if (localStorage.getItem('analytics-opt-out') === 'true') return false;
          return true;
        }

        function getOrCreateSessionId() {
          const storageKey = 'bb_analytics_session';
          const stored = sessionStorage.getItem(storageKey);
          if (stored) return stored;
          const sessionId = crypto.randomUUID().slice(0, 16);
          sessionStorage.setItem(storageKey, sessionId);
          return sessionId;
        }

        const eventQueue = [];
        let batchTimer = null;

        async function flushEvents() {
          if (eventQueue.length === 0) return;
          const events = [...eventQueue];
          eventQueue.length = 0;
          try {
            await Promise.all(
              events.map((event) =>
                fetch(CONFIG.endpoint, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(event),
                  keepalive: true,
                })
              )
            );
          } catch (e) {
            /* analytics should never break the app */
          }
        }

        function queueEvent(event) {
          if (!isTrackingAllowed()) return;
          eventQueue.push(event);
          if (eventQueue.length >= CONFIG.maxBatchSize) {
            flushEvents();
            return;
          }
          if (!batchTimer) {
            batchTimer = setTimeout(() => {
              flushEvents();
              batchTimer = null;
            }, CONFIG.batchInterval);
          }
        }

        function trackEvent(event, metadata) {
          queueEvent({
            event,
            page: window.location.pathname,
            referrer: document.referrer || undefined,
            metadata,
          });
        }

        function trackPerformance(metric, value) {
          if (!isTrackingAllowed()) return;
          fetch(CONFIG.performanceEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ metric, value, page: window.location.pathname }),
            keepalive: true,
          }).catch(() => {});
        }

        function trackError(message, stack, metadata) {
          if (!isTrackingAllowed()) return;
          fetch(CONFIG.errorEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              level: 'error',
              message,
              stack,
              page: window.location.pathname,
              metadata,
            }),
            keepalive: true,
          }).catch(() => {});
        }

        function observeLCP() {
          try {
            const observer = new PerformanceObserver((list) => {
              const entries = list.getEntries();
              const lastEntry = entries[entries.length - 1];
              if (lastEntry) trackPerformance('LCP', lastEntry.startTime);
            });
            observer.observe({ type: 'largest-contentful-paint', buffered: true });
          } catch (e) {}
        }

        function observeCLS() {
          try {
            let clsValue = 0;
            const observer = new PerformanceObserver((list) => {
              for (const entry of list.getEntries()) {
                if (!entry.hadRecentInput) clsValue += entry.value;
              }
            });
            observer.observe({ type: 'layout-shift', buffered: true });
            document.addEventListener('visibilitychange', () => {
              if (document.visibilityState === 'hidden') trackPerformance('CLS', clsValue);
            });
          } catch (e) {}
        }

        function observeINP() {
          try {
            let maxINP = 0;
            const observer = new PerformanceObserver((list) => {
              for (const entry of list.getEntries()) {
                if (entry.duration > maxINP) maxINP = entry.duration;
              }
            });
            observer.observe({ type: 'event', buffered: true });
            document.addEventListener('visibilitychange', () => {
              if (document.visibilityState === 'hidden') trackPerformance('INP', maxINP);
            });
          } catch (e) {}
        }

        function observeTTFB() {
          try {
            const navigation = performance.getEntriesByType('navigation')[0];
            if (navigation)
              trackPerformance('TTFB', navigation.responseStart - navigation.requestStart);
          } catch (e) {}
        }

        function observeFCP() {
          try {
            const observer = new PerformanceObserver((list) => {
              const entries = list.getEntries();
              const lastEntry = entries[entries.length - 1];
              if (lastEntry) trackPerformance('FCP', lastEntry.startTime);
            });
            observer.observe({ type: 'paint', buffered: true });
          } catch (e) {}
        }

        let maxScrollDepth = 0;
        function initScrollTracking() {
          if (!isTrackingAllowed()) return;
          const article = document.querySelector('article');
          if (!article) return;
          const updateScrollDepth = () => {
            const rect = article.getBoundingClientRect();
            const articleHeight = article.offsetHeight;
            const viewportHeight = window.innerHeight;
            const scrolled = Math.max(0, -rect.top);
            const depth = Math.min(1, scrolled / (articleHeight - viewportHeight));
            if (depth > maxScrollDepth) maxScrollDepth = depth;
          };
          let scrollTimeout;
          window.addEventListener(
            'scroll',
            () => {
              clearTimeout(scrollTimeout);
              scrollTimeout = setTimeout(updateScrollDepth, 100);
            },
            { passive: true }
          );
          document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'hidden' && maxScrollDepth > 0) {
              trackEvent('scroll_depth', { depth: maxScrollDepth });
            }
          });
        }

        function initErrorHandling() {
          window.addEventListener('error', (event) => {
            trackError(event.message, event.error?.stack, {
              filename: event.filename,
              lineno: event.lineno,
              colno: event.colno,
            });
          });
          window.addEventListener('unhandledrejection', (event) => {
            trackError('Unhandled Promise Rejection: ' + event.reason, undefined, {
              type: 'unhandledrejection',
            });
          });
        }

        function init() {
          if (!isTrackingAllowed()) return;
          trackEvent('page_view');
          observeLCP();
          observeCLS();
          observeINP();
          observeTTFB();
          observeFCP();
          initScrollTracking();
          initErrorHandling();
          window.addEventListener('beforeunload', flushEvents);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>
    <AuthModal />
    <script is:inline>
      // Global auth state checker — updates header for logged-in users on all pages
      (async () => {
        try {
          const res = await fetch('/api/auth/me');
          const data = await res.json();
          if (!data.success || !data.user) return;

          const user = data.user;
          const authLinks = document.querySelector('.auth-links');
          if (!authLinks) return;

          const displayName = user.name || user.email.split('@')[0];
          const initials = displayName
            .split(' ')
            .map((n) => n[0])
            .join('')
            .toUpperCase()
            .slice(0, 2);

          authLinks.innerHTML = `
            <a href="/write" class="nav-link" style="display:inline-flex;align-items:center;gap:6px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
              </svg>
              Write
            </a>
            <button class="global-notification-btn" aria-label="Notifications" style="background:none;border:none;color:var(--color-body);cursor:pointer;padding:6px;border-radius:var(--radius-sm);display:flex;align-items:center;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
              </svg>
            </button>
            <div style="position:relative;">
              <button class="global-avatar-btn" aria-label="User menu" aria-expanded="false" style="background:none;border:none;cursor:pointer;padding:0;">
                <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#cc785c,#e8a55a);display:flex;align-items:center;justify-content:center;font-family:var(--font-sans);font-size:0.7rem;font-weight:600;color:white;">${initials}</div>
              </button>
              <div class="global-user-dropdown" style="position:absolute;top:calc(100% + 8px);right:0;width:220px;background:var(--bg-canvas);border:1px solid var(--color-hairline);border-radius:var(--radius-md);box-shadow:0 8px 30px rgba(0,0,0,0.08);opacity:0;visibility:hidden;transform:translateY(-4px);transition:all 0.15s;z-index:600;overflow:hidden;">
                <div style="padding:var(--space-md);display:flex;flex-direction:column;gap:2px;">
                  <span style="font-family:var(--font-sans);font-size:var(--text-body-sm);font-weight:500;color:var(--color-ink);">${displayName}</span>
                  <span style="font-family:var(--font-sans);font-size:var(--text-caption);color:var(--color-muted);">${user.email}</span>
                  <span style="display:inline-block;font-family:var(--font-mono);font-size:0.65rem;color:var(--color-primary);background:rgba(204,120,92,0.1);padding:2px 6px;border-radius:4px;margin-top:4px;width:fit-content;text-transform:uppercase;letter-spacing:0.5px;">${user.role}</span>
                </div>
                <div style="height:1px;background:var(--color-hairline);"></div>
                <a href="/dashboard" style="display:block;padding:10px var(--space-md);font-family:var(--font-sans);font-size:var(--text-body-sm);color:var(--color-body);text-decoration:none;">Dashboard</a>
                <a href="/write" style="display:block;padding:10px var(--space-md);font-family:var(--font-sans);font-size:var(--text-body-sm);color:var(--color-body);text-decoration:none;">Write a story</a>
                <div style="height:1px;background:var(--color-hairline);"></div>
                <button class="global-logout-btn" style="display:block;width:100%;text-align:left;padding:10px var(--space-md);font-family:var(--font-sans);font-size:var(--text-body-sm);color:var(--color-error);background:none;border:none;cursor:pointer;">Sign out</button>
              </div>
            </div>
          `;

          // Dropdown toggle
          const avatarBtn = document.querySelector('.global-avatar-btn');
          const dropdown = document.querySelector('.global-user-dropdown');
          if (avatarBtn && dropdown) {
            avatarBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              const isOpen = dropdown.style.opacity === '1';
              dropdown.style.opacity = isOpen ? '0' : '1';
              dropdown.style.visibility = isOpen ? 'hidden' : 'visible';
              dropdown.style.transform = isOpen ? 'translateY(-4px)' : 'translateY(0)';
              avatarBtn.setAttribute('aria-expanded', String(!isOpen));
            });
            document.addEventListener('click', () => {
              dropdown.style.opacity = '0';
              dropdown.style.visibility = 'hidden';
              dropdown.style.transform = 'translateY(-4px)';
              avatarBtn.setAttribute('aria-expanded', 'false');
            });
          }

          // Logout
          document.querySelector('.global-logout-btn')?.addEventListener('click', async () => {
            await fetch('/api/auth/logout', { method: 'POST' });
            window.location.href = '/';
          });
        } catch (e) {
          // Silently fail — user is just not logged in
        }
      })();
    </script>
  </body>
</html>

<script is:inline>
  (() => {
    const header = document.querySelector('.site-header');
    const toggle = document.querySelector('.mobile-nav-toggle');
    const overlay = document.querySelector('.mobile-nav-overlay');
    const drawer = document.querySelector('.mobile-nav-drawer');
    const closeBtn = document.querySelector('.mobile-nav-close');

    if (!header || !toggle || !overlay || !drawer) return;

    function open() {
      overlay.classList.add('mobile-nav-overlay--open');
      drawer.classList.add('mobile-nav-drawer--open');
      overlay.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      const firstLink = drawer.querySelector('.mobile-nav-link');
      if (firstLink) firstLink.focus();
    }

    function close() {
      overlay.classList.remove('mobile-nav-overlay--open');
      drawer.classList.remove('mobile-nav-drawer--open');
