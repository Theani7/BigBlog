      });
    });

    const resetBtn = document.querySelector('[data-reader-reset]');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        localStorage.removeItem('reader-fontSize');
        localStorage.removeItem('reader-spacing');
        localStorage.removeItem('reader-font');
        localStorage.removeItem('reader-width');
        document.querySelectorAll('[data-reader-pref]').forEach((select) => {
          const pref = select.dataset.readerPref;
          const defaults = {
            fontSize: 'medium',
            spacing: 'comfortable',
            font: 'sans',
            width: 'wide',
          };
          select.value = defaults[pref] || '';
        });
        applyReaderPrefs();
      });
    }

    function applyReaderPrefs() {
      const fontSize = localStorage.getItem('reader-fontSize') || 'medium';
      const spacing = localStorage.getItem('reader-spacing') || 'comfortable';
      const font = localStorage.getItem('reader-font') || 'sans';
      const width = localStorage.getItem('reader-width') || 'wide';

      const fontSizeMap = { small: '0.9375rem', medium: '1rem', large: '1.125rem' };
      const lineHeightMap = { compact: '1.6', comfortable: '1.75' };
      const maxWidthMap = { narrow: '56ch', wide: '68ch' };

      document.documentElement.style.setProperty(
        '--reader-font-size',
        fontSizeMap[fontSize] || '1rem'
      );
      document.documentElement.style.setProperty(
        '--reader-line-height',
        lineHeightMap[spacing] || '1.75'
      );
      document.documentElement.style.setProperty(
        '--reader-font',
        font === 'serif' ? 'var(--font-serif)' : 'var(--font-sans)'
      );
      document.documentElement.style.setProperty(
        '--reader-max-width',
        maxWidthMap[width] || '68ch'
      );
